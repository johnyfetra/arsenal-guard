---
import ChevronDown from 'lucide-astro/ChevronDown';
import { languageFlags, languageLabels, languages, localizedPath, type Lang } from '../../lib/i18n';

interface Props {
	lang: Lang;
	path: string;
}

const { lang, path } = Astro.props;
---

<div class="language-menu relative" data-language-menu>
	<button class="language-menu-button" type="button" aria-label="Select language" aria-haspopup="listbox" aria-expanded="false" data-language-menu-button>
		<span class="language-menu-flag" aria-hidden="true">{languageFlags[lang]}</span>
		<ChevronDown class="size-3.5 opacity-60" aria-hidden="true" />
	</button>
	<div class="language-menu-list" role="listbox" aria-label="Select language" data-language-menu-list>
		{languages.map((item) => (
			<a class="language-menu-option" href={localizedPath(item, path)} role="option" aria-selected={item === lang}>
				<span class="language-menu-flag" aria-hidden="true">{languageFlags[item]}</span>
				<span>{languageLabels[item]}</span>
			</a>
		))}
	</div>
</div>

<script is:inline>
	if (!window.__arsenalLanguageMenuReady) {
		window.__arsenalLanguageMenuReady = true;

		const closeLanguageMenus = (except) => {
			document.querySelectorAll('[data-language-menu]').forEach((menu) => {
				if (menu === except) return;
				menu.classList.remove('is-open');
				menu.querySelector('[data-language-menu-button]')?.setAttribute('aria-expanded', 'false');
			});
		};

		document.addEventListener('click', (event) => {
			const button = event.target.closest?.('[data-language-menu-button]');
			const menu = event.target.closest?.('[data-language-menu]');

			if (button && menu) {
				event.stopPropagation();
				const open = !menu.classList.contains('is-open');
				closeLanguageMenus(menu);
				menu.classList.toggle('is-open', open);
				button.setAttribute('aria-expanded', String(open));
				return;
			}

			if (!menu) closeLanguageMenus();
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') {
				const openMenu = document.querySelector('[data-language-menu].is-open');
				closeLanguageMenus();
				openMenu?.querySelector('[data-language-menu-button]')?.focus();
			}
		});
	}
</script>
