---
---
<form class="surface grid gap-4 rounded-2xl p-6" data-contact-form>
	<input type="hidden" name="access_key" value={import.meta.env.PUBLIC_WEB3FORMS_KEY ?? ''} />
	<input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />
	<label class="grid gap-2 text-sm font-semibold">Nom<input required name="name" maxlength="100" class="rounded-lg px-4 py-3" /></label>
	<label class="grid gap-2 text-sm font-semibold">Email<input required type="email" name="email" maxlength="254" class="rounded-lg px-4 py-3" /></label>
	<label class="grid gap-2 text-sm font-semibold">Message<textarea required name="message" rows="5" maxlength="2000" class="rounded-lg px-4 py-3"></textarea></label>
	<button class="rounded-xl bg-orange-500 px-5 py-3 font-bold text-white hover:bg-orange-600" type="submit">Envoyer</button>
	<p class="hidden text-sm text-orange-400" data-form-status></p>
</form>
<script is:inline>
	document.querySelectorAll('[data-contact-form]').forEach((form) => {
		let lastSubmit = 0;
		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			const now = Date.now();
			if (now - lastSubmit < 5000) return;
			lastSubmit = now;
			const status = form.querySelector('[data-form-status]');
			status.classList.remove('hidden');
			status.textContent = 'Envoi en cours...';
			const data = Object.fromEntries(new FormData(form));
			if (data.botcheck) return;
			try {
				if (!data.access_key) throw new Error('Missing Web3Forms key');
				const response = await fetch('https://api.web3forms.com/submit', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(data),
				});
				if (!response.ok) throw new Error('Submission failed');
				status.textContent = 'Message envoy\u00e9. R\u00e9ponse sous 24h ouvr\u00e9es.';
				form.reset();
			} catch {
				status.textContent = "Erreur d'envoi. R\u00e9essayez ou contactez-nous par email.";
			}
		});
	});
</script>
