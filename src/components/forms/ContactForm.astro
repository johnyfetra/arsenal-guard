---
---
<form class="surface grid gap-4 rounded-2xl p-6" data-contact-form>
	<input type="hidden" name="access_key" value={import.meta.env.PUBLIC_WEB3FORMS_KEY ?? ''} />
	<label class="grid gap-2 text-sm font-semibold">Nom<input required name="name" class="rounded-lg px-4 py-3" /></label>
	<label class="grid gap-2 text-sm font-semibold">Email<input required type="email" name="email" class="rounded-lg px-4 py-3" /></label>
	<label class="grid gap-2 text-sm font-semibold">Message<textarea required name="message" rows="5" class="rounded-lg px-4 py-3"></textarea></label>
	<button class="rounded-xl bg-orange-500 px-5 py-3 font-bold text-white hover:bg-orange-600" type="submit">Envoyer</button>
	<p class="hidden text-sm text-orange-400" data-form-status></p>
</form>
<script is:inline>
	document.querySelectorAll('[data-contact-form]').forEach((form) => {
		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			const status = form.querySelector('[data-form-status]');
			status.classList.remove('hidden');
			status.textContent = 'Envoi en cours...';
			const data = Object.fromEntries(new FormData(form));
			try {
				if (!data.access_key) throw new Error('Missing Web3Forms key');
				const response = await fetch('https://api.web3forms.com/submit', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(data),
				});
				if (!response.ok) throw new Error('Submission failed');
				status.textContent = 'Message envoye. Reponse sous 24h ouvrees.';
				form.reset();
			} catch {
				status.textContent = 'Formulaire pret. Ajoutez PUBLIC_WEB3FORMS_KEY pour activer l envoi.';
			}
		});
	});
</script>
