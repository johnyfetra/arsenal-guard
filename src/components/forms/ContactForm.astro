---
import Send from 'lucide-astro/Send';
import ShieldCheck from 'lucide-astro/ShieldCheck';
import type { Lang } from '../../lib/i18n';

interface Props {
	lang?: Lang;
}

const { lang = 'fr' } = Astro.props;

const formCopy = lang === 'fr'
	? {
		title: 'Message direct',
		lead: 'Un message court suffit pour ouvrir le canal.',
		secure: 'Canal protégé',
		submit: 'Envoyer',
		status: {
			sending: 'Envoi en cours...',
			success: 'Message envoyé. Réponse sous 24h ouvrées.',
			error: "Erreur d'envoi. Réessayez ou contactez-nous par email.",
			missingKey: 'Canal formulaire indisponible. Contactez-nous directement par email.',
		},
		fields: {
			name: 'Nom',
			email: 'Email',
			message: 'Message',
			messagePlaceholder: 'Besoin QA, urgence release, question service...',
		},
	}
	: {
		title: 'Direct message',
		lead: 'A short message is enough to open the channel.',
		secure: 'Protected channel',
		submit: 'Send',
		status: {
			sending: 'Sending...',
			success: 'Message sent. Reply within one business day.',
			error: 'Submission failed. Try again or contact us by email.',
			missingKey: 'Form channel unavailable. Please contact us directly by email.',
		},
		fields: {
			name: 'Name',
			email: 'Email',
			message: 'Message',
			messagePlaceholder: 'QA need, release urgency, service question...',
		},
	};
---

<form
	class="command-form command-form--contact"
	data-contact-form
	data-sending={formCopy.status.sending}
	data-success={formCopy.status.success}
	data-error={formCopy.status.error}
	data-missing-key={formCopy.status.missingKey}
	action="/api/contact"
	method="post"
>
	<input type="hidden" name="form_type" value="contact" />
	<input type="hidden" name="lang" value={lang} />
	<input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

	<div class="quote-step-head">
		<span>RX</span>
		<div>
			<h2>{formCopy.title}</h2>
			<p>{formCopy.lead}</p>
		</div>
	</div>

	<div class="field-grid">
		<label class="form-field">
			<span>{formCopy.fields.name}</span>
			<input required name="name" maxlength="100" />
		</label>
		<label class="form-field">
			<span>{formCopy.fields.email}</span>
			<input required type="email" name="email" maxlength="254" />
		</label>
		<label class="form-field form-field--wide">
			<span>{formCopy.fields.message}</span>
			<textarea required name="message" rows="5" maxlength="2000" placeholder={formCopy.fields.messagePlaceholder}></textarea>
		</label>
	</div>

	<div class="form-actions">
		<p class="form-secure-note">
			<ShieldCheck class="size-4" aria-hidden="true" />
			{formCopy.secure}
		</p>
		<button class="command-btn command-btn--primary" type="submit" data-submit>
			{formCopy.submit}
			<Send class="size-4" aria-hidden="true" />
		</button>
	</div>

	<p class="form-status hidden" data-form-status aria-live="polite" role="status"></p>
</form>

<script is:inline>
	document.querySelectorAll('[data-contact-form]').forEach((form) => {
		if (!(form instanceof HTMLFormElement)) return;

		let lastSubmit = 0;
		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			const now = Date.now();
			if (now - lastSubmit < 5000) return;
			lastSubmit = now;

			const status = form.querySelector('[data-form-status]');
			const submit = form.querySelector('[data-submit]');
			if (status) {
				status.classList.remove('hidden');
				status.textContent = form.dataset.sending || 'Sending...';
			}
			if (submit instanceof HTMLButtonElement) submit.disabled = true;

			const data = Object.fromEntries(new FormData(form));

			try {
				const response = await fetch('/api/contact', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(data),
				});
				const result = await response.json().catch(() => ({}));
				if (!response.ok) {
					throw new Error(result.error === 'email_not_configured' ? 'Email channel unavailable' : 'Submission failed');
				}
				if (status) status.textContent = form.dataset.success || 'Message sent.';
				form.reset();
			} catch (error) {
				if (status) {
					status.textContent = error instanceof Error && error.message === 'Email channel unavailable'
						? form.dataset.missingKey || form.dataset.error || 'Submission failed.'
						: form.dataset.error || 'Submission failed.';
				}
			} finally {
				if (submit instanceof HTMLButtonElement) submit.disabled = false;
			}
		});
	});
</script>
