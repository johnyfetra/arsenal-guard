---
const projectTypes = ['Audit', 'Stabilization', 'E2E Setup', 'Monthly Subscription', 'Dedicated QA', 'Other'];
const budgets = ['< 1 000 \u20ac', '1 000 - 2 500 \u20ac', '2 500 - 5 000 \u20ac', '> 5 000 \u20ac'];
---
<form class="surface rounded-2xl p-6" data-quote-form>
	<input type="hidden" name="access_key" value={import.meta.env.PUBLIC_WEB3FORMS_KEY ?? ''} />
	<input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />
	<div class="mb-6 h-2 overflow-hidden rounded-full bg-white/10"><div class="h-full w-1/4 rounded-full bg-orange-500" data-progress></div></div>
	<section data-step="0" class="grid gap-4">
		<h2 class="text-2xl font-extrabold">1. Type de projet</h2>
		<div class="grid gap-3 sm:grid-cols-2">
			{projectTypes.map((type) => <label class="rounded-lg border p-4 font-semibold"><input class="mr-2" type="radio" name="project_type" value={type} required />{type}</label>)}
		</div>
	</section>
	<section data-step="1" class="hidden grid gap-4">
		<h2 class="text-2xl font-extrabold">2. Informations projet</h2>
		<label class="grid gap-2 text-sm font-semibold">Entreprise<input required name="company" maxlength="100" class="rounded-lg px-4 py-3" /></label>
		<label class="grid gap-2 text-sm font-semibold">Site web<input name="website" type="url" maxlength="200" placeholder="https://" class="rounded-lg px-4 py-3" /></label>
		<label class="grid gap-2 text-sm font-semibold">Stack technique<input name="stack" maxlength="200" class="rounded-lg px-4 py-3" /></label>
		<label class="grid gap-2 text-sm font-semibold">Couverture actuelle<select name="coverage" class="rounded-lg px-4 py-3"><option>Inconnue</option><option>0-20%</option><option>20-50%</option><option>50%+</option></select></label>
	</section>
	<section data-step="2" class="hidden grid gap-4">
		<h2 class="text-2xl font-extrabold">3. D\u00e9lai et budget</h2>
		<label class="grid gap-2 text-sm font-semibold">Date de d\u00e9marrage souhait\u00e9e<input type="date" name="start_date" class="rounded-lg px-4 py-3" /></label>
		<label class="grid gap-2 text-sm font-semibold">Budget<select name="budget" class="rounded-lg px-4 py-3">{budgets.map((budget) => <option>{budget}</option>)}</select></label>
		<label class="grid gap-2 text-sm font-semibold">Engagement<select name="engagement" class="rounded-lg px-4 py-3"><option>One-shot</option><option>Recurring</option></select></label>
	</section>
	<section data-step="3" class="hidden grid gap-4">
		<h2 class="text-2xl font-extrabold">4. Contact</h2>
		<label class="grid gap-2 text-sm font-semibold">Nom<input required name="name" maxlength="100" class="rounded-lg px-4 py-3" /></label>
		<label class="grid gap-2 text-sm font-semibold">Email<input required type="email" name="email" maxlength="254" class="rounded-lg px-4 py-3" /></label>
		<label class="grid gap-2 text-sm font-semibold">T\u00e9l\u00e9phone<input name="phone" type="tel" maxlength="20" class="rounded-lg px-4 py-3" /></label>
		<label class="grid gap-2 text-sm font-semibold">Commentaires<textarea name="comments" rows="4" maxlength="2000" class="rounded-lg px-4 py-3"></textarea></label>
	</section>
	<div class="mt-8 flex justify-between gap-3">
		<button type="button" class="theme-control rounded-xl px-5 py-3 font-bold" data-prev>Retour</button>
		<button type="button" class="rounded-xl bg-orange-500 px-5 py-3 font-bold text-white" data-next>Continuer</button>
		<button type="submit" class="hidden rounded-xl bg-orange-500 px-5 py-3 font-bold text-white" data-submit>Envoyer</button>
	</div>
	<p class="mt-4 hidden text-sm text-orange-400" data-form-status></p>
</form>
<script is:inline>
	document.querySelectorAll('[data-quote-form]').forEach((form) => {
		let step = 0;
		let lastSubmit = 0;
		const steps = [...form.querySelectorAll('[data-step]')];
		const progress = form.querySelector('[data-progress]');
		const prev = form.querySelector('[data-prev]');
		const next = form.querySelector('[data-next]');
		const submit = form.querySelector('[data-submit]');
		const status = form.querySelector('[data-form-status]');
		const render = () => {
			steps.forEach((section, index) => section.classList.toggle('hidden', index !== step));
			progress.style.width = ((step + 1) / steps.length * 100) + '%';
			prev.disabled = step === 0;
			next.classList.toggle('hidden', step === steps.length - 1);
			submit.classList.toggle('hidden', step !== steps.length - 1);
		};
		prev.addEventListener('click', () => { step = Math.max(0, step - 1); render(); });
		next.addEventListener('click', () => {
			const current = steps[step];
			const inputs = current.querySelectorAll('[required]');
			for (const input of inputs) { if (!input.checkValidity()) { input.reportValidity(); return; } }
			step = Math.min(steps.length - 1, step + 1); render();
		});
		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			const now = Date.now();
			if (now - lastSubmit < 5000) return;
			lastSubmit = now;
			status.classList.remove('hidden');
			status.textContent = 'Envoi en cours...';
			const data = Object.fromEntries(new FormData(form));
			if (data.botcheck) return;
			window.dispatchEvent(new CustomEvent('quote_submitted'));
			try {
				if (!data.access_key) throw new Error('Missing Web3Forms key');
				const response = await fetch('https://api.web3forms.com/submit', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(data),
				});
				if (!response.ok) throw new Error('Submission failed');
				status.textContent = 'Demande re\u00e7ue ! Proposition sous 24h ouvr\u00e9es.';
				form.reset();
				step = 0; render();
			} catch {
				status.textContent = "Erreur d'envoi. R\u00e9essayez ou contactez-nous par email.";
			}
		});
		render();
	});
</script>
