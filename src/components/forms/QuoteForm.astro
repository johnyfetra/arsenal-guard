---
import ArrowLeft from 'lucide-astro/ArrowLeft';
import ArrowRight from 'lucide-astro/ArrowRight';
import Send from 'lucide-astro/Send';
import ShieldCheck from 'lucide-astro/ShieldCheck';
import type { Lang } from '../../lib/i18n';

interface Option {
	value: string;
	label: string;
	note?: string;
}

interface Props {
	lang?: Lang;
}

const { lang = 'fr' } = Astro.props;

const formCopy = lang === 'fr'
	? {
		progress: 'Progression mission',
		secure: 'Canal protégé',
		back: 'Retour',
		next: 'Continuer',
		submit: 'Envoyer',
		status: {
			sending: 'Envoi en cours...',
			success: 'Demande reçue ! Proposition sous 24h ouvrées.',
			error: "Erreur d'envoi. Réessayez ou contactez-nous par email.",
			missingKey: 'Canal formulaire indisponible. Contactez-nous directement par email.',
		},
		steps: [
			{
				title: 'Type de mission',
				lead: 'Sélectionnez le terrain principal à protéger.',
			},
			{
				title: 'Informations projet',
				lead: 'Donnez le contexte utile pour évaluer le risque.',
			},
			{
				title: 'Délai et budget',
				lead: "Cadrez la cadence, le niveau d'engagement et l'enveloppe.",
			},
			{
				title: 'Canal de contact',
				lead: 'Indiquez ou renvoyer le plan de mission.',
			},
		],
		projectTypes: [
			{ value: 'qa_snapshot', label: 'QA Snapshot', note: 'Bug report rapide' },
			{ value: 'audit', label: 'Audit QA', note: 'Cartographie du risque' },
			{ value: 'e2e_setup', label: 'Setup E2E', note: 'Cypress ou Playwright' },
			{ value: 'monthly', label: 'Forfait mensuel', note: 'Garde continue' },
			{ value: 'dedicated', label: 'QA dédié', note: 'Intégration équipe' },
			{ value: 'other', label: 'Autre mission', note: 'Besoin spécifique' },
		] satisfies Option[],
		coverage: ['Inconnue', '0-20%', '20-50%', '50%+'],
		engagement: ['Ponctuel', 'Récurrent', 'À définir'],
		fields: {
			company: 'Entreprise',
			website: 'Site web',
			stack: 'Stack technique',
			coverage: 'Couverture actuelle',
			startDate: 'Date de démarrage souhaitée',
			budget: 'Budget',
			engagement: 'Engagement',
			name: 'Nom',
			email: 'Email',
			phone: 'Téléphone',
			comments: 'Commentaires',
			commentsPlaceholder: 'Contexte, urgence release, parcours critiques, environnement disponible...',
		},
	}
	: {
		progress: 'Mission progress',
		secure: 'Protected channel',
		back: 'Back',
		next: 'Continue',
		submit: 'Send',
		status: {
			sending: 'Sending...',
			success: 'Request received! Proposal within one business day.',
			error: 'Submission failed. Try again or contact us by email.',
			missingKey: 'Form channel unavailable. Please contact us directly by email.',
		},
		steps: [
			{
				title: 'Mission type',
				lead: 'Select the main terrain to protect.',
			},
			{
				title: 'Project details',
				lead: 'Share the useful context for assessing risk.',
			},
			{
				title: 'Timeline and budget',
				lead: 'Frame the pace, engagement level and budget range.',
			},
			{
				title: 'Contact channel',
				lead: 'Tell us where to send the mission plan.',
			},
		],
		projectTypes: [
			{ value: 'qa_snapshot', label: 'QA Snapshot', note: 'Fast bug report' },
			{ value: 'audit', label: 'QA Audit', note: 'Risk mapping' },
			{ value: 'e2e_setup', label: 'E2E Setup', note: 'Cypress or Playwright' },
			{ value: 'monthly', label: 'Monthly retainer', note: 'Continuous guard' },
			{ value: 'dedicated', label: 'Dedicated QA', note: 'Team integration' },
			{ value: 'other', label: 'Other mission', note: 'Specific need' },
		] satisfies Option[],
		coverage: ['Unknown', '0-20%', '20-50%', '50%+'],
		engagement: ['One-off', 'Recurring', 'To define'],
		fields: {
			company: 'Company',
			website: 'Website',
			stack: 'Technical stack',
			coverage: 'Current coverage',
			startDate: 'Desired start date',
			budget: 'Budget',
			engagement: 'Engagement',
			name: 'Name',
			email: 'Email',
			phone: 'Phone',
			comments: 'Comments',
			commentsPlaceholder: 'Context, release urgency, critical journeys, available environment...',
		},
	};

const budgets = ['< 1 000 EUR', '1 000 - 2 500 EUR', '2 500 - 5 000 EUR', '> 5 000 EUR'];
---

<form
	class="command-form command-form--quote"
	data-quote-form
	data-sending={formCopy.status.sending}
	data-success={formCopy.status.success}
	data-error={formCopy.status.error}
	data-missing-key={formCopy.status.missingKey}
>
	<input type="hidden" name="access_key" value={import.meta.env.PUBLIC_WEB3FORMS_KEY ?? ''} />
	<input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

	<div class="command-form-progress">
		<div>
			<p>{formCopy.progress}</p>
			<span data-progress-label>1 / 4</span>
		</div>
		<div class="command-progress-track" role="progressbar" aria-valuemin="1" aria-valuemax="4" aria-valuenow="1">
			<span data-progress style="width: 25%"></span>
		</div>
	</div>

	<section data-step="0" class="quote-step">
		<div class="quote-step-head">
			<span>01</span>
			<div>
				<h2 tabindex="-1" data-step-title>{formCopy.steps[0].title}</h2>
				<p>{formCopy.steps[0].lead}</p>
			</div>
		</div>
		<fieldset class="quote-fieldset">
			<legend class="sr-only">{formCopy.steps[0].title}</legend>
			<div class="choice-grid">
				{formCopy.projectTypes.map((type) => (
					<label class="choice-card">
						<input type="radio" name="project_type" value={type.value} required />
						<span>
							<strong>{type.label}</strong>
							{type.note && <small>{type.note}</small>}
						</span>
					</label>
				))}
			</div>
		</fieldset>
	</section>

	<section data-step="1" class="quote-step hidden" hidden>
		<div class="quote-step-head">
			<span>02</span>
			<div>
				<h2 tabindex="-1" data-step-title>{formCopy.steps[1].title}</h2>
				<p>{formCopy.steps[1].lead}</p>
			</div>
		</div>
		<div class="field-grid">
			<label class="form-field">
				<span>{formCopy.fields.company}</span>
				<input required name="company" maxlength="100" />
			</label>
			<label class="form-field">
				<span>{formCopy.fields.website}</span>
				<input name="website" type="url" maxlength="200" placeholder="https://" />
			</label>
			<label class="form-field form-field--wide">
				<span>{formCopy.fields.stack}</span>
				<input name="stack" maxlength="200" />
			</label>
			<label class="form-field form-field--wide">
				<span>{formCopy.fields.coverage}</span>
				<select name="coverage">
					{formCopy.coverage.map((coverage) => <option value={coverage}>{coverage}</option>)}
				</select>
			</label>
		</div>
	</section>

	<section data-step="2" class="quote-step hidden" hidden>
		<div class="quote-step-head">
			<span>03</span>
			<div>
				<h2 tabindex="-1" data-step-title>{formCopy.steps[2].title}</h2>
				<p>{formCopy.steps[2].lead}</p>
			</div>
		</div>
		<div class="field-grid">
			<label class="form-field">
				<span>{formCopy.fields.startDate}</span>
				<input type="date" name="start_date" />
			</label>
			<label class="form-field">
				<span>{formCopy.fields.budget}</span>
				<select name="budget">
					{budgets.map((budget) => <option value={budget}>{budget}</option>)}
				</select>
			</label>
			<label class="form-field form-field--wide">
				<span>{formCopy.fields.engagement}</span>
				<select name="engagement">
					{formCopy.engagement.map((engagement) => <option value={engagement}>{engagement}</option>)}
				</select>
			</label>
		</div>
	</section>

	<section data-step="3" class="quote-step hidden" hidden>
		<div class="quote-step-head">
			<span>04</span>
			<div>
				<h2 tabindex="-1" data-step-title>{formCopy.steps[3].title}</h2>
				<p>{formCopy.steps[3].lead}</p>
			</div>
		</div>
		<div class="field-grid">
			<label class="form-field">
				<span>{formCopy.fields.name}</span>
				<input required name="name" maxlength="100" />
			</label>
			<label class="form-field">
				<span>{formCopy.fields.email}</span>
				<input required type="email" name="email" maxlength="254" />
			</label>
			<label class="form-field form-field--wide">
				<span>{formCopy.fields.phone}</span>
				<input name="phone" type="tel" maxlength="20" />
			</label>
			<label class="form-field form-field--wide">
				<span>{formCopy.fields.comments}</span>
				<textarea name="comments" rows="4" maxlength="2000" placeholder={formCopy.fields.commentsPlaceholder}></textarea>
			</label>
		</div>
	</section>

	<div class="form-actions">
		<button type="button" class="command-btn command-btn--secondary" data-prev>
			<ArrowLeft class="size-4" aria-hidden="true" />
			{formCopy.back}
		</button>
		<div class="form-actions-right">
			<p class="form-secure-note">
				<ShieldCheck class="size-4" aria-hidden="true" />
				{formCopy.secure}
			</p>
			<button type="button" class="command-btn command-btn--primary" data-next>
				{formCopy.next}
				<ArrowRight class="size-4" aria-hidden="true" />
			</button>
			<button type="submit" class="command-btn command-btn--primary hidden" data-submit>
				{formCopy.submit}
				<Send class="size-4" aria-hidden="true" />
			</button>
		</div>
	</div>

	<p class="form-status hidden" data-form-status aria-live="polite" role="status"></p>
</form>

<script is:inline>
	document.querySelectorAll('[data-quote-form]').forEach((form) => {
		if (!(form instanceof HTMLFormElement)) return;

		let step = 0;
		let lastSubmit = 0;
		const steps = Array.from(form.querySelectorAll('[data-step]'));
		const progress = form.querySelector('[data-progress]');
		const progressTrack = form.querySelector('[role="progressbar"]');
		const progressLabel = form.querySelector('[data-progress-label]');
		const prev = form.querySelector('[data-prev]');
		const next = form.querySelector('[data-next]');
		const submit = form.querySelector('[data-submit]');
		const status = form.querySelector('[data-form-status]');

		const toggleHidden = (node, isHidden) => {
			if (!node) return;
			node.classList.toggle('hidden', isHidden);
			if (isHidden) node.setAttribute('hidden', '');
			else node.removeAttribute('hidden');
		};

		const render = () => {
			steps.forEach((section, index) => toggleHidden(section, index !== step));
			if (progress) progress.style.width = `${((step + 1) / steps.length) * 100}%`;
			if (progressTrack) progressTrack.setAttribute('aria-valuenow', String(step + 1));
			if (progressLabel) progressLabel.textContent = `${step + 1} / ${steps.length}`;
			if (prev instanceof HTMLButtonElement) prev.disabled = step === 0;
			toggleHidden(next, step === steps.length - 1);
			toggleHidden(submit, step !== steps.length - 1);
		};

		const focusCurrentTitle = () => {
			const currentTitle = steps[step]?.querySelector('[data-step-title]');
			if (currentTitle && 'focus' in currentTitle) currentTitle.focus({ preventScroll: true });
		};

		const currentStepIsValid = () => {
			const current = steps[step];
			if (!current) return false;
			const inputs = Array.from(current.querySelectorAll('[required]'));
			for (const input of inputs) {
				if ('checkValidity' in input && !input.checkValidity()) {
					if ('reportValidity' in input) input.reportValidity();
					return false;
				}
			}
			return true;
		};

		prev?.addEventListener('click', () => {
			step = Math.max(0, step - 1);
			render();
			focusCurrentTitle();
		});

		next?.addEventListener('click', () => {
			if (!currentStepIsValid()) return;
			step = Math.min(steps.length - 1, step + 1);
			render();
			focusCurrentTitle();
		});

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			if (!currentStepIsValid()) return;

			const now = Date.now();
			if (now - lastSubmit < 5000) return;
			lastSubmit = now;

			if (status) {
				status.classList.remove('hidden');
				status.textContent = form.dataset.sending || 'Sending...';
			}
			if (submit instanceof HTMLButtonElement) submit.disabled = true;

			const data = Object.fromEntries(new FormData(form));
			if (data.botcheck) return;
			window.dispatchEvent(new CustomEvent('quote_submitted'));

			try {
				if (!data.access_key) throw new Error('Missing Web3Forms key');
				const response = await fetch('https://api.web3forms.com/submit', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(data),
				});
				if (!response.ok) throw new Error('Submission failed');
				if (status) status.textContent = form.dataset.success || 'Request received.';
				form.reset();
				step = 0;
				render();
			} catch (error) {
				if (status) {
					status.textContent = error instanceof Error && error.message === 'Missing Web3Forms key'
						? form.dataset.missingKey || form.dataset.error || 'Submission failed.'
						: form.dataset.error || 'Submission failed.';
				}
			} finally {
				if (submit instanceof HTMLButtonElement) submit.disabled = false;
			}
		});

		render();
	});
</script>
