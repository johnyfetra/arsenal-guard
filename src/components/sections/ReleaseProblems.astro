---
import AlertTriangle from 'lucide-astro/AlertTriangle';
import CircleOff from 'lucide-astro/CircleOff';
import GitPullRequestDraft from 'lucide-astro/GitPullRequestDraft';
import Container from '../ui/Container.astro';
import type { Lang } from '../../lib/i18n';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;

const content =
	lang === 'fr'
		? {
				eyebrow: 'Carte des risques',
				title: 'Une release échoue rarement par manque d’outils. Elle échoue par angle mort.',
				lead: 'Arsenal Guard classe les signaux dispersés comme une carte opérationnelle : ce qui menace la release, ce qui mérite surveillance, ce qui peut attendre.',
				problems: [
					{
						icon: AlertTriangle,
						title: 'Suites E2E instables',
						text: 'Les flakies deviennent du bruit de fond. Le jour critique, plus personne ne sait si l’alerte est réelle.',
						meta: 'Signal bruité',
					},
					{
						icon: CircleOff,
						title: 'Régressions manuelles trop tardives',
						text: 'La vérification arrive en bout de chaîne, sous pression, sans couverture claire des parcours qui comptent.',
						meta: 'Risque non cadré',
					},
					{
						icon: GitPullRequestDraft,
						title: 'CI verte, produit cassé',
						text: 'Les pipelines passent pendant que les parcours métier restent exposés, hors champ de la garde automatisée.',
						meta: 'Fausse confiance',
					},
				],
			}
		: {
				eyebrow: 'Risk map',
				title: 'A release rarely fails because of missing tools. It fails because of blind spots.',
				lead: 'Arsenal Guard ranks scattered signals like an operational map: what threatens the release, what deserves monitoring, what can wait.',
				problems: [
					{
						icon: AlertTriangle,
						title: 'Unstable E2E suites',
						text: 'Flaky tests become background noise. On the critical day, nobody knows whether the alert is real.',
						meta: 'Noisy signal',
					},
					{
						icon: CircleOff,
						title: 'Manual regressions too late',
						text: 'Checks arrive at the end of the chain, under pressure, without clear coverage of the journeys that matter.',
						meta: 'Unframed risk',
					},
					{
						icon: GitPullRequestDraft,
						title: 'Green CI, broken product',
						text: 'Pipelines pass while business journeys remain exposed, outside the automated guard line.',
						meta: 'False confidence',
					},
				],
			};
---

<section class="release-problems section-band relative overflow-hidden py-20 md:py-32">
	<div class="release-problems-line" aria-hidden="true"></div>
	<Container>
		<div class="grid gap-8 lg:grid-cols-[0.92fr_1.08fr] lg:items-end">
			<div>
				<p class="section-eyebrow">{content.eyebrow}</p>
				<h2 class="mt-4 max-w-3xl text-3xl font-extrabold md:text-5xl">{content.title}</h2>
			</div>
			<p class="max-w-2xl text-lg leading-relaxed text-muted lg:justify-self-end" data-reveal>{content.lead}</p>
		</div>

		<div class="mt-12 grid gap-5 md:grid-cols-3">
			{
				content.problems.map((item, index) => {
					const Icon = item.icon;
					return (
						<article class="release-problem-card" data-reveal style={`--reveal-delay:${index * 80}ms`}>
							<div class="release-problem-icon">
								<Icon class="size-5" aria-hidden="true" />
							</div>
							<p class="release-problem-meta">{item.meta}</p>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</article>
					);
				})
			}
		</div>
	</Container>
</section>
