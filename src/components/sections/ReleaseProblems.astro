---
import AlertTriangle from 'lucide-astro/AlertTriangle';
import CircleOff from 'lucide-astro/CircleOff';
import GitPullRequestDraft from 'lucide-astro/GitPullRequestDraft';
import SectionIllustration from '../illustrations/SectionIllustration.astro';
import Container from '../ui/Container.astro';
import type { Lang } from '../../lib/i18n';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;

const content =
	lang === 'fr'
		? {
				eyebrow: 'Le problème',
				title: "Toutes les entreprises n'ont pas besoin d'un QA à temps plein.",
				lead: "Parfois, le besoin est beaucoup plus ciblé. Et c'est souvent là que le blocage commence : \"On a besoin de tester, mais pas assez pour recruter un QA sur une mission longue.\"",
				problems: [
					{
						icon: AlertTriangle,
						title: 'Le tunnel de commande part sans test',
						text: 'Validé à la main, sous pression, une fois. Le bug part en prod avec le code.',
						meta: 'Zéro filet',
					},
					{
						icon: CircleOff,
						title: 'Votre client trouve le bug avant vous',
						text: 'La release est live, le tunnel plante. Chaque minute coûte.',
						meta: 'Trop tard',
					},
					{
						icon: GitPullRequestDraft,
						title: 'Un poste fixe pour un besoin ponctuel',
						text: 'Trois mois pour recruter, six pour onboarder. Votre besoin est là maintenant.',
						meta: 'Sur-dimensionné',
					},
				],
			}
		: {
				eyebrow: 'The problem',
				title: 'Not every company needs a full-time QA engineer.',
				lead: "Sometimes the need is much more targeted. And that's often where the bottleneck starts: \"We need to test, but not enough to hire a QA for a long engagement.\"",
				problems: [
					{
						icon: AlertTriangle,
						title: 'Your checkout ships without a test',
						text: 'Validated once, manually, under pressure. The bug ships with the code.',
						meta: 'No safety net',
					},
					{
						icon: CircleOff,
						title: 'Your customer finds the bug first',
						text: 'The release is live, checkout breaks. Every minute costs.',
						meta: 'Too late',
					},
					{
						icon: GitPullRequestDraft,
						title: 'A full-time hire for a part-time need',
						text: 'Three months to recruit, six to onboard. You need coverage now.',
						meta: 'Oversized',
					},
				],
			};
---

<section id="release-risk" class="release-problems section-band relative overflow-hidden py-20 md:py-32">
	<div class="release-problems-line" aria-hidden="true"></div>
	<Container>
		<div class="grid gap-8 lg:grid-cols-[0.92fr_1.08fr] lg:items-end">
			<div>
				<p class="section-eyebrow">{content.eyebrow}</p>
				<h2 class="mt-4 max-w-3xl text-3xl font-extrabold md:text-5xl">{content.title}</h2>
			</div>
			<p class="max-w-2xl text-lg leading-relaxed text-muted lg:justify-self-end" data-reveal>{content.lead}</p>
		</div>

		<div class="section-visual-card section-visual-card--wide mt-10" data-reveal>
			<SectionIllustration variant="risk-funnel" lang={lang} />
		</div>

		<div class="mt-12 grid gap-5 md:grid-cols-3">
			{
				content.problems.map((item, index) => {
					const Icon = item.icon;
					return (
						<article class="release-problem-card" data-reveal style={`--reveal-delay:${index * 80}ms`}>
							<div class="release-problem-icon">
								<Icon class="size-5" aria-hidden="true" />
							</div>
							<p class="release-problem-meta">{item.meta}</p>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</article>
					);
				})
			}
		</div>
	</Container>
</section>
