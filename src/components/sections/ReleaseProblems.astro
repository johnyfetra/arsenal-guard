---
import AlertTriangle from 'lucide-astro/AlertTriangle';
import CircleOff from 'lucide-astro/CircleOff';
import GitPullRequestDraft from 'lucide-astro/GitPullRequestDraft';
import Container from '../ui/Container.astro';
import type { Lang } from '../../lib/i18n';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;

const content =
	lang === 'fr'
		? {
				eyebrow: 'Le problème',
				title: "Toutes les entreprises n'ont pas besoin d'un QA à temps plein.",
				lead: "Parfois, le besoin est beaucoup plus ciblé. Et c'est souvent là que le blocage commence : \"On a besoin de tester, mais pas assez pour recruter un QA sur une mission longue.\"",
				problems: [
					{
						icon: AlertTriangle,
						title: 'La fonctionnalité part en prod sans couverture',
						text: "Le tunnel de commande, le formulaire critique, le parcours d'inscription — validés à la main en interne, sous pression, sans test de non-régression. Les risques partent en production avec le code.",
						meta: 'Peu de couverture',
					},
					{
						icon: CircleOff,
						title: 'Le bug est détecté par un client, pas un testeur',
						text: "Un utilisateur découvre le problème avant votre équipe. La release est en ligne, le tunnel de commande plante et chaque minute coûte. C'est le scénario que tout le monde veut éviter.",
						meta: 'Trop tard',
					},
					{
						icon: GitPullRequestDraft,
						title: "Recruter un QA à temps plein, c'est trop lourd",
						text: "Trois mois pour recruter, six mois pour onboarder. Votre besoin est là maintenant — un renfort ciblé, au bon moment, pas un poste permanent que le volume ne justifie pas encore.",
						meta: 'Sur-dimensionné',
					},
				],
			}
		: {
				eyebrow: 'The problem',
				title: 'Not every company needs a full-time QA engineer.',
				lead: "Sometimes the need is much more targeted. And that's often where the bottleneck starts: \"We need to test, but not enough to hire a QA for a long engagement.\"",
				problems: [
					{
						icon: AlertTriangle,
						title: 'The feature ships without coverage',
						text: "The payment module, the critical form, the sign-up journey — validated internally under pressure, no regression tests. Risks ship to production with the code.",
						meta: 'Low coverage',
					},
					{
						icon: CircleOff,
						title: 'The bug is found by a customer, not a tester',
						text: "A user finds the issue before your team does. The release is live, the checkout is broken and every minute costs. This is the scenario everyone wants to prevent.",
						meta: 'Too late',
					},
					{
						icon: GitPullRequestDraft,
						title: 'Hiring a full-time QA is too much overhead',
						text: "Three months to hire, six months to onboard. Your need is now — a targeted specialist at the right moment, not a permanent role that your current volume doesn't justify.",
						meta: 'Oversized',
					},
				],
			};
---

<section class="release-problems section-band relative overflow-hidden py-20 md:py-32">
	<div class="release-problems-line" aria-hidden="true"></div>
	<Container>
		<div class="grid gap-8 lg:grid-cols-[0.92fr_1.08fr] lg:items-end">
			<div>
				<p class="section-eyebrow">{content.eyebrow}</p>
				<h2 class="mt-4 max-w-3xl text-3xl font-extrabold md:text-5xl">{content.title}</h2>
			</div>
			<p class="max-w-2xl text-lg leading-relaxed text-muted lg:justify-self-end" data-reveal>{content.lead}</p>
		</div>

		<div class="mt-12 grid gap-5 md:grid-cols-3">
			{
				content.problems.map((item, index) => {
					const Icon = item.icon;
					return (
						<article class="release-problem-card" data-reveal style={`--reveal-delay:${index * 80}ms`}>
							<div class="release-problem-icon">
								<Icon class="size-5" aria-hidden="true" />
							</div>
							<p class="release-problem-meta">{item.meta}</p>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</article>
					);
				})
			}
		</div>
	</Container>
</section>
