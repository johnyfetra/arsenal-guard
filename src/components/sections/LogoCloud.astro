---
import Container from '../ui/Container.astro';
import { clientRefs } from '../../lib/site';
const logoColors: Record<string, string> = {
	Chanel: '#111111',
	Sodexo: '#263c89',
	Hexaglobe: '#178fcf',
	Ecomundo: '#2f9f5b',
	'Les Aligneurs Francais': '#d9252a',
};
const loopItems = [...clientRefs, ...clientRefs, ...clientRefs];
---
<section class="overflow-hidden py-14">
	<Container>
		<p class="text-center text-xl font-extrabold uppercase tracking-[0.24em] text-current md:text-2xl">Ils nous ont fait confiance</p>
	</Container>
	<div class="logo-marquee mt-9" aria-label="References clients Arsenal Guard">
		<div class="logo-marquee-track">
			{loopItems.map((client) => (
				<div class="client-logo" style={`--logo-color: ${logoColors[client] ?? '#f39c12'}`}>
					<span>{client}</span>
				</div>
			))}
		</div>
	</div>
</section>
