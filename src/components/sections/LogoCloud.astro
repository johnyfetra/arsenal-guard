---
import Container from '../ui/Container.astro';
import chanelLogo from '../../assets/logos/chanel.png';
import ecomundoLogo from '../../assets/logos/ecomundo.png';
import hexaglobeLogo from '../../assets/logos/hexaglobe.png';
import lafLogo from '../../assets/logos/les-aligneurs-francais.png';
import sodexoLogo from '../../assets/logos/sodexo.png';
import type { Lang } from '../../lib/i18n';

interface Props {
	lang?: Lang;
}
const { lang = 'fr' } = Astro.props;

const clients = [
	{ name: 'Chanel', logo: chanelLogo, color: '#111111' },
	{ name: 'Sodexo', logo: sodexoLogo, color: '#263c89' },
	{ name: 'Hexaglobe', logo: hexaglobeLogo, color: '#178fcf' },
	{ name: 'Ecomundo', logo: ecomundoLogo, color: '#2f9f5b' },
	{ name: 'Les Aligneurs Francais', logo: lafLogo, color: '#d9252a' },
];
const loopItems = [...clients, ...clients, ...clients];
---

<section class="overflow-hidden py-10 md:py-14">
	<Container>
		<p
			class="logo-cloud-title mx-auto max-w-4xl text-center text-xl font-extrabold uppercase tracking-[0.24em] text-current md:text-2xl"
		>
			{lang === 'fr' ? 'Expérience terrain sur des produits où une régression coûte cher' : 'Field experience on products where a regression costs real money'}
		</p>
		<p class="mx-auto mt-3 max-w-2xl text-center text-sm text-muted">
			{lang === 'fr'
				? 'Chanel · Sodexo · Hexaglobe · Ecomundo · Les Aligneurs Français — e-commerce, SaaS et plateformes digitales exigeantes.'
				: 'Chanel · Sodexo · Hexaglobe · Ecomundo · Les Aligneurs Français — e-commerce, SaaS and demanding digital platforms.'}
		</p>
	</Container>
	<div
		class="logo-marquee mt-9"
		aria-label={lang === 'fr' ? 'Références clients Arsenal Guard' : 'Arsenal Guard client references'}
	>
		<div class="logo-marquee-track">
			{
				loopItems.map((client) => (
					<div class="client-logo" style={`--logo-color: ${client.color}`}>
						<img
							class="client-logo-image"
							src={client.logo.src}
							alt={`Logo ${client.name}`}
							loading="lazy"
							decoding="async"
						/>
					</div>
				))
			}
		</div>
	</div>
	<div class="logo-marquee logo-marquee--reverse mt-4" aria-hidden="true">
		<div class="logo-marquee-track">
			{
				loopItems.map((client) => (
					<div class="client-logo" style={`--logo-color: ${client.color}`}>
						<img class="client-logo-image" src={client.logo.src} alt="" loading="lazy" decoding="async" />
					</div>
				))
			}
		</div>
	</div>
</section>
