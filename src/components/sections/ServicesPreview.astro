---
import ArrowRight from 'lucide-astro/ArrowRight';
import Check from 'lucide-astro/Check';
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import { copy, routeMap, type Lang } from '../../lib/i18n';
import { plans, services } from '../../lib/site';

interface Props { lang: Lang; mode?: 'services' | 'pricing' }
const { lang, mode = 'services' } = Astro.props;

const pricingItems = plans.map((item) => ({
	eyebrow: item.volume,
	title: item.name,
	description: 'Maintenance E2E, nouveaux scénarios, support CI/CD et reporting qualité mensuel.',
	price: item.price,
	featured: item.featured,
	perks: [
		'3 à 5 nouveaux tests E2E/mois',
		'Maintenance suite existante',
		'Support pipelines CI/CD',
		'Reporting qualité mensuel',
	],
}));

const serviceItems = services.slice(0, 3).map((item) => ({
	eyebrow: item.kicker,
	title: item.title,
	description: item.description,
	price: item.price,
	featured: false,
	perks: item.deliverables.slice(0, 4),
}));

const items = mode === 'pricing' ? pricingItems : serviceItems;
---

<section class="section-skew-top section-band relative z-10">
	<Container>
		<div class="mb-14 flex flex-col justify-between gap-5 md:flex-row md:items-end reveal">
			<div>
				<p class="section-eyebrow">{mode === 'pricing' ? 'Tarification' : 'Offres'}</p>
				<h2 class="mt-4 text-3xl font-extrabold md:text-5xl">
					{mode === 'pricing' ? copy[lang].sections.pricing : copy[lang].nav.services}
				</h2>
			</div>
			<Button href={routeMap.services} lang={lang} variant="ghost">
				Voir le détail <ArrowRight class="size-4" />
			</Button>
		</div>

		<div class="grid gap-5 md:grid-cols-3 md:items-stretch">
			{items.map((item, index) => (
				<div
					class={`pricing-card reveal flex flex-col scroll-float ${item.featured ? 'pricing-card--featured' : ''}`}
					style={`--reveal-delay:${index * 80}ms`}
					data-scroll-depth={String(index === 1 ? -14 : 10)}
				>
					{item.featured && (
						<div class="mb-4 flex items-center justify-between">
							<span class="pricing-badge">Recommandé</span>
						</div>
					)}
					<p class="text-xs font-bold uppercase tracking-[0.16em] text-orange-400">{item.eyebrow}</p>
					<h3 class="mt-3 text-2xl font-extrabold">{item.title}</h3>
					<p class="mt-2 text-muted text-sm leading-relaxed">{item.description}</p>

					<div class="my-6 border-t border-white/10"></div>

					<p class="pricing-price">
						{item.price.replace(/\/mois/, '')}<span>{item.price.includes('/mois') ? '/mois' : ''}</span>
					</p>

					<ul class="mt-6 space-y-2.5 flex-1">
						{item.perks.map((perk) => (
							<li class="flex items-start gap-2 text-sm text-muted">
								<Check class="mt-0.5 size-4 flex-shrink-0 text-orange-400" />
								{perk}
							</li>
						))}
					</ul>

					{item.featured && (
						<div class="mt-6">
							<Button href={routeMap.quote} lang={lang} class="w-full justify-center">
								Démarrer
							</Button>
						</div>
					)}
				</div>
			))}
		</div>
	</Container>
</section>
