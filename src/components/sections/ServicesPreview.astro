---
import ArrowRight from 'lucide-astro/ArrowRight';
import Check from 'lucide-astro/Check';
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import { copy, routeMap, type Lang } from '../../lib/i18n';
import { plans, services } from '../../lib/site';
import type { Service } from '../../lib/site';

interface Props { lang: Lang; mode?: 'services' | 'pricing' }
const { lang, mode = 'services' } = Astro.props;

const planDetails = {
	Starter: {
		description: {
			fr: 'Pour maintenir les parcours critiques et obtenir un signal QA régulier sans alourdir votre équipe.',
			en: 'For maintaining critical journeys and keeping a steady QA signal without adding team overhead.',
		},
		perks: {
			fr: [
				'2 à 3 tests E2E ciblés/mois',
				'Maintenance légère des tests instables',
				'Revue CI mensuelle',
				'Synthèse priorisée des risques',
			],
			en: [
				'2 to 3 targeted E2E tests/month',
				'Light flaky test maintenance',
				'Monthly CI review',
				'Prioritized risk summary',
			],
		},
	},
	Growth: {
		description: {
			fr: 'Pour les équipes qui livrent souvent et veulent accélérer la couverture E2E avec un suivi QA actif.',
			en: 'For teams shipping often that need to grow E2E coverage with active QA follow-up.',
		},
		perks: {
			fr: [
				'5 à 8 tests E2E/mois',
				'Stabilisation continue des flakies',
				'Tests bloquants intégrés en CI/CD',
				'Reporting qualité et arbitrage release',
			],
			en: [
				'5 to 8 E2E tests/month',
				'Continuous flaky test stabilization',
				'Blocking tests integrated in CI/CD',
				'Quality reporting and release arbitration',
			],
		},
	},
	Pro: {
		description: {
			fr: 'Pour les produits à forte cadence qui ont besoin d’un ownership QA plus complet sur plusieurs squads.',
			en: 'For high-velocity products that need broader QA ownership across several squads.',
		},
		perks: {
			fr: [
				'8 à 12 tests E2E/mois',
				'Maintenance avancée et refactor de suite',
				'Support CI/CD prioritaire',
				'Roadmap QA mensuelle avec métriques',
			],
			en: [
				'8 to 12 E2E tests/month',
				'Advanced maintenance and suite refactoring',
				'Priority CI/CD support',
				'Monthly QA roadmap with metrics',
			],
		},
	},
};

const pricingItems = plans.map((item) => ({
	eyebrow: item.volume,
	title: item.name,
	description: planDetails[item.name as keyof typeof planDetails].description[lang],
	price: item.price,
	featured: item.featured,
	perks: planDetails[item.name as keyof typeof planDetails].perks[lang],
}));

const homeServices = services.filter((s: Service) => s.featuredOnHome === true).slice(0, 3)
const serviceItems = homeServices.map((item: Service) => ({
	eyebrow: item.kicker,
	title: item.title,
	description: item.description,
	price: item.tiers ? (item.tiers.find((t) => t.featured)?.price ?? item.price) : item.price,
	featured: false,
	perks: item.deliverables.slice(0, 4),
}));

const items = mode === 'pricing' ? pricingItems : serviceItems;
const labels = lang === 'fr'
	? { pricing: 'Tarification', offers: 'Offres', detail: 'Voir le détail', recommended: 'Recommandé', start: 'Démarrer' }
	: { pricing: 'Pricing', offers: 'Offers', detail: 'View details', recommended: 'Recommended', start: 'Start' };
---

<section class="pricing-section section-skew-top section-band relative z-20">
	<Container>
		<div class="mb-14 flex flex-col justify-between gap-5 md:flex-row md:items-end reveal">
			<div>
				<p class="section-eyebrow">{mode === 'pricing' ? labels.pricing : labels.offers}</p>
				<h2 class="mt-4 text-3xl font-extrabold md:text-5xl">
					{mode === 'pricing' ? copy[lang].sections.pricing : copy[lang].nav.services}
				</h2>
			</div>
			<Button href={routeMap.services} lang={lang} variant="ghost">
				{labels.detail} <ArrowRight class="size-4" />
			</Button>
		</div>

		<div class="pricing-grid grid gap-5 md:grid-cols-3 md:items-stretch">
			{items.map((item, index) => (
				<div
					class={`pricing-card reveal flex flex-col ${item.featured ? 'pricing-card--featured' : ''}`}
					style={`--reveal-delay:${index * 80}ms`}
				>
					{item.featured && (
						<div class="mb-4 flex items-center justify-between">
							<span class="pricing-badge">{labels.recommended}</span>
						</div>
					)}
					<p class="text-xs font-bold uppercase tracking-[0.16em] text-orange-400">{item.eyebrow}</p>
					<h3 class="mt-3 text-2xl font-extrabold">{item.title}</h3>
					<p class="mt-2 text-muted text-sm leading-relaxed">{item.description}</p>

					<div class="my-6 border-t border-white/10"></div>

					<p class="pricing-price">
						{item.price.replace(/\/mois/, '')}<span>{item.price.includes('/mois') ? '/mois' : ''}</span>
					</p>

					<ul class="mt-6 space-y-2.5 flex-1">
						{item.perks.map((perk) => (
							<li class="flex items-start gap-2 text-sm text-muted">
								<Check class="mt-0.5 size-4 flex-shrink-0 text-orange-400" />
								{perk}
							</li>
						))}
					</ul>

					{item.featured && (
						<div class="mt-6">
							<Button href={routeMap.quote} lang={lang} class="w-full justify-center">
								{labels.start}
							</Button>
						</div>
					)}
				</div>
			))}
		</div>
	</Container>
</section>
