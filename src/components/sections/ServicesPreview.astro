---
import ArrowRight from 'lucide-astro/ArrowRight';
import Card from '../ui/Card.astro';
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import { copy, routeMap, type Lang } from '../../lib/i18n';
import { plans, services } from '../../lib/site';
interface Props { lang: Lang; mode?: 'services' | 'pricing' }
const { lang, mode = 'services' } = Astro.props;
const items = mode === 'pricing'
	? plans.map((item) => ({ eyebrow: item.volume, title: item.name, description: 'Maintenance E2E, nouveaux scenarios, support CI/CD et reporting qualite mensuel.', price: item.price, featured: item.featured }))
	: services.slice(0, 3).map((item) => ({ eyebrow: item.kicker, title: item.title, description: item.description, price: item.price, featured: false }));
---
<section class="py-24 md:py-32">
	<Container>
		<div class="flex flex-col justify-between gap-5 md:flex-row md:items-end">
			<h2 class="text-3xl font-extrabold md:text-5xl">{mode === 'pricing' ? copy[lang].sections.pricing : copy[lang].nav.services}</h2>
			<Button href={routeMap.services} lang={lang} variant="ghost">Voir le detail <ArrowRight class="size-4" /></Button>
		</div>
		<div class="mt-10 grid gap-5 md:grid-cols-3">
			{items.map((item, index) => (
				<Card class={`reveal scroll-float ${item.featured ? 'border-orange-400/60' : ''}`} data-scroll-depth={String(index === 1 ? -16 : 10)}>
					<p class="text-sm font-bold uppercase tracking-[0.14em] text-orange-400">{item.eyebrow}</p>
					<h3 class="mt-4 text-2xl font-extrabold">{item.title}</h3>
					<p class="mt-3 text-muted">{item.description}</p>
					<p class="mt-6 font-mono text-lg text-current">{item.price}</p>
				</Card>
			))}
		</div>
	</Container>
</section>
