---
import ArrowRight from 'lucide-astro/ArrowRight';
import Check from 'lucide-astro/Check';
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import { localizedPath, routeMap, type Lang } from '../../lib/i18n';

interface Props {
	lang: Lang;
	mode?: 'services' | 'pricing';
}
const { lang, mode = 'services' } = Astro.props;

const labels =
	lang === 'fr'
		? {
				eyebrow: mode === 'pricing' ? 'Forfaits de garde' : 'Modes d’intervention',
				title:
					mode === 'pricing'
						? 'Choisissez votre niveau de garde release.'
						: 'Trois manières d’entrer dans la ligne de défense.',
				lead: 'On peut intervenir en reconnaissance courte, fortifier votre E2E, ou tenir une garde QA récurrente selon votre cadence produit.',
				allServices: 'Voir tous les services',
				detail: 'Voir le détail',
				recommended: 'Recommandé',
				start: 'Démarrer',
				items: [
					{
						eyebrow: 'Reconnaissance',
						title: 'Express QA Audit',
						description:
							'Cartographie rapide des parcours critiques, signaux existants et risques release prioritaires.',
						price: '600 € TTC',
						href: routeMap.audit,
						featured: false,
						perks: [
							'Carte des risques produit',
							'Revue des tests existants',
							'Backlog QA priorisé',
							'Restitution actionnable',
						],
					},
					{
						eyebrow: 'Fortification',
						title: 'E2E Framework Setup',
						description:
							'Playwright ou Cypress sur les flux qui méritent un garde-fou automatique avant chaque release.',
						price: '1 600 € TTC',
						href: routeMap.automation,
						featured: true,
						perks: [
							'Architecture maintenable',
							'3 tests E2E critiques',
							'Conventions et fixtures',
							'Documentation de reprise',
						],
					},
					{
						eyebrow: 'Garde continue',
						title: 'Forfait QA mensuel',
						description:
							'Une sentinelle QA récurrente pour les équipes qui livrent souvent et veulent un signal stable.',
						price: 'Dès 1 100 € TTC/mois',
						href: routeMap.retainer,
						featured: false,
						perks: ['Nouveaux tests chaque mois', 'Maintenance flakies', 'Support CI/CD', 'Reporting release'],
					},
				],
			}
		: {
				eyebrow: mode === 'pricing' ? 'Guard plans' : 'Intervention modes',
				title: mode === 'pricing' ? 'Choose your release guard level.' : 'Three ways to enter the defense line.',
				lead: 'We can step in for a short recon, fortify your E2E coverage, or run recurring QA guard duty according to your product cadence.',
				allServices: 'View all services',
				detail: 'View details',
				recommended: 'Recommended',
				start: 'Start',
				items: [
					{
						eyebrow: 'Recon',
						title: 'Express QA Audit',
						description: 'Fast mapping of critical journeys, existing signals and priority release risks.',
						price: '€600 incl. VAT',
						href: routeMap.audit,
						featured: false,
						perks: ['Product risk map', 'Existing test review', 'Prioritized QA backlog', 'Actionable readout'],
					},
					{
						eyebrow: 'Fortification',
						title: 'E2E Framework Setup',
						description: 'Playwright or Cypress on the flows that deserve an automated guardrail before every release.',
						price: '€1,600 incl. VAT',
						href: routeMap.automation,
						featured: true,
						perks: [
							'Maintainable architecture',
							'3 critical E2E tests',
							'Conventions and fixtures',
							'Handover documentation',
						],
					},
					{
						eyebrow: 'Continuous guard',
						title: 'Monthly QA plan',
						description: 'A recurring QA sentinel for teams that ship often and need a stable quality signal.',
						price: 'From €1,100/mo',
						href: routeMap.retainer,
						featured: false,
						perks: ['New tests each month', 'Flaky maintenance', 'CI/CD support', 'Release reporting'],
					},
				],
			};

const items = labels.items;
---

<section id="mission-modes" class="pricing-section section-skew-top section-band relative z-20">
	<Container>
		<div class="mb-14 flex flex-col justify-between gap-5 md:flex-row md:items-end">
			<div>
				<p class="section-eyebrow">{labels.eyebrow}</p>
				<h2 class="mt-4 text-3xl font-extrabold md:text-5xl">
					{labels.title}
				</h2>
				<p class="mt-4 max-w-2xl text-muted leading-relaxed" data-reveal>{labels.lead}</p>
			</div>
			<Button href={routeMap.services} lang={lang} variant="ghost">
				{labels.allServices}
				<ArrowRight class="size-4" />
			</Button>
		</div>

		<div class="pricing-grid grid gap-5 md:grid-cols-3 md:items-stretch">
			{
				items.map((item, index) => (
					<div
						class={`pricing-card reveal flex flex-col ${item.featured ? 'pricing-card--featured' : ''}`}
						style={`--reveal-delay:${index * 80}ms`}
					>
						{item.featured && (
							<div class="mb-4 flex items-center justify-between">
								<span class="pricing-badge">{labels.recommended}</span>
							</div>
						)}
						<p class="text-xs font-bold uppercase tracking-[0.16em] text-orange-400">{item.eyebrow}</p>
						<h3 class="mt-3 text-2xl font-extrabold">{item.title}</h3>
						<p class="mt-2 text-muted text-sm leading-relaxed">{item.description}</p>

						<div class="my-6 border-t border-white/10" />

						<p class="pricing-price">
							{item.price.replace(/\/mois/, '')}
							<span>{item.price.includes('/mois') ? '/mois' : ''}</span>
						</p>

						<ul class="mt-6 space-y-2.5 flex-1">
							{item.perks.map((perk) => (
								<li class="flex items-start gap-2 text-sm text-muted">
									<Check class="mt-0.5 size-4 flex-shrink-0 text-orange-400" />
									{perk}
								</li>
							))}
						</ul>

						{item.featured && (
							<div class="mt-6">
								<Button href={item.href} lang={lang} class="w-full justify-center">
									{labels.start}
								</Button>
							</div>
						)}
						{!item.featured && (
							<a
								href={localizedPath(lang, item.href)}
								class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-orange-400 hover:underline"
							>
								{labels.detail} <ArrowRight class="size-3.5" />
							</a>
						)}
					</div>
				))
			}
		</div>
	</Container>
</section>
