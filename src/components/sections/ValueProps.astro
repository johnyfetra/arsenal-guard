---
import FileSearch from 'lucide-astro/FileSearch';
import Zap from 'lucide-astro/Zap';
import Eye from 'lucide-astro/Eye';
import Container from '../ui/Container.astro';
import { copy, type Lang } from '../../lib/i18n';
import { valueProps } from '../../lib/site';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const icons = { FileSearch, Zap, Eye };
const localizedValueProps = lang === 'fr'
	? valueProps
	: [
		{ icon: 'FileSearch', title: 'A clear report, not a ticket dump', text: 'Every bug is documented, prioritized and illustrated. No noise — just what actually blocks.' },
		{ icon: 'Zap', title: 'No setup, no tools to learn', text: 'You share a staging link. We handle the rest. Delivered in 48 to 72 business hours.' },
		{ icon: 'Eye', title: 'The outside perspective your team can\'t have', text: 'An external tester sees what familiarity hides: broken flows, UX inconsistencies, critical anomalies.' },
	];
---

<section class="section-skew-both section-band relative z-10">
	<Container>
		<div class="mx-auto mb-12 max-w-2xl text-center reveal">
			<p class="section-eyebrow justify-center">{lang === 'fr' ? 'Notre valeur' : 'Our value'}</p>
			<h2 class="mt-4 text-3xl font-extrabold md:text-5xl">{copy[lang].sections.value}</h2>
		</div>
		<div class="grid gap-6 md:grid-cols-3">
			{localizedValueProps.map((item, index) => {
				const Icon = icons[item.icon as keyof typeof icons];
				return (
					<div class="value-prop-card reveal" style={`--reveal-delay:${index * 80}ms`}>
						<div class="value-prop-icon-wrap">
							<Icon class="size-6 text-orange-400" />
						</div>
						<p class="mt-2 font-mono text-xs font-bold tracking-[0.18em] text-orange-400 opacity-60">
							0{index + 1}
						</p>
						<h3 class="mt-3 text-xl font-bold">{item.title}</h3>
						<p class="mt-3 text-muted leading-relaxed">{item.text}</p>
					</div>
				);
			})}
		</div>
	</Container>
</section>
