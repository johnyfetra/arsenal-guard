---
import BrainCircuit from 'lucide-astro/BrainCircuit';
import Eye from 'lucide-astro/Eye';
import Repeat2 from 'lucide-astro/Repeat2';
import ShieldCheck from 'lucide-astro/ShieldCheck';
import Container from '../ui/Container.astro';
import type { Lang } from '../../lib/i18n';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;

const content =
	lang === 'fr'
		? {
				eyebrow: 'Trois lignes de défense',
				title: 'L’humain repère, l’automation garde, l’IA aide à lire le signal.',
				lead: 'Arsenal Guard ne remplace pas le jugement QA par des scripts. Nous combinons observation humaine, garde-fous automatisés et analyse assistée pour produire une décision release.',
				matrix: [
					{
						icon: Eye,
						label: 'Ligne humaine',
						title: 'L’humain détecte l’ambiguïté',
						text: 'UX incohérente, parcours confus, cas limite métier : ce que la couverture brute ne voit pas.',
					},
					{
						icon: Repeat2,
						label: 'Ligne automatisée',
						title: 'L’automation capture la répétition',
						text: 'Parcours critiques, régressions récurrentes, smoke tests et garde-fous CI/CD.',
					},
					{
						icon: BrainCircuit,
						label: 'Ligne assistée',
						title: 'L’IA aide à remonter les patterns',
						text: 'Regroupement de risques, accélération de rédaction, aide au tri sans surpromesse magique.',
					},
				],
				result: 'Les trois lignes convergent vers un signal unique : expédier, bloquer, corriger ou surveiller.',
			}
		: {
				eyebrow: 'Three defense lines',
				title: 'Humans spot, automation guards, AI helps read the signal.',
				lead: 'Arsenal Guard does not replace QA judgment with scripts. We combine human observation, automated guardrails and assisted analysis to produce a release decision.',
				matrix: [
					{
						icon: Eye,
						label: 'Human line',
						title: 'Humans catch ambiguity',
						text: 'Inconsistent UX, confusing journeys, domain edge cases: what raw coverage cannot see.',
					},
					{
						icon: Repeat2,
						label: 'Automated line',
						title: 'Automation catches repetition',
						text: 'Critical journeys, recurring regressions, smoke tests and CI/CD guardrails.',
					},
					{
						icon: BrainCircuit,
						label: 'Assisted line',
						title: 'AI helps surface patterns',
						text: 'Risk grouping, faster documentation, triage support without magical overpromising.',
					},
				],
				result: 'The three lines converge into one signal: ship, block, fix or monitor.',
			};
---

<section id="release-approach" class="quality-layer relative overflow-hidden py-20 md:py-32">
	<div class="quality-layer-orbit" aria-hidden="true"></div>
	<Container class="grid gap-10 lg:grid-cols-[0.82fr_1.18fr] lg:items-center">
		<div>
			<p class="section-eyebrow">{content.eyebrow}</p>
			<h2 class="mt-4 text-3xl font-extrabold md:text-5xl">{content.title}</h2>
			<p class="mt-5 text-lg leading-relaxed text-muted">{content.lead}</p>
			<div class="quality-layer-result">
				<ShieldCheck class="size-5" aria-hidden="true" />
				<p>{content.result}</p>
			</div>
		</div>

		<div class="quality-matrix" data-reveal>
			{
				content.matrix.map((item, index) => {
					const Icon = item.icon;
					return (
						<article class="quality-matrix-row" style={`--row-index:${index}`}>
							<div class="quality-matrix-icon">
								<Icon class="size-5" aria-hidden="true" />
							</div>
							<div>
								<p class="quality-matrix-label">{item.label}</p>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</div>
						</article>
					);
				})
			}
		</div>
	</Container>
</section>
