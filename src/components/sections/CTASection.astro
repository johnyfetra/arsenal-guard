---
import ArrowRight from 'lucide-astro/ArrowRight';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import { copy, routeMap, type Lang } from '../../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const ctaMeta = lang === 'fr'
	? {
		eyebrow: 'Prêt à démarrer ?',
		secondary: 'Discuter en 15 min',
		title: 'Avant votre prochaine release, faites entrer le doute dans le process.',
		lead: 'Un diagnostic QA court suffit souvent à révéler les parcours critiques, les signaux CI fragiles et les tests qui réduisent vraiment le risque.',
		stats: [
			{ value: '24h', label: 'Délai de réponse', counter: '24', suffix: 'h' },
			{ value: '5+', label: "Ans d'expérience", counter: '5', suffix: '+' },
			{ value: 'Sans engagement', label: 'Forfaits mensuels' },
		],
	}
	: {
		eyebrow: 'Ready to start?',
		secondary: 'Book a 15-min call',
		title: 'Before your next release, put uncertainty through a process.',
		lead: 'A short QA diagnostic is often enough to surface critical journeys, fragile CI signals and the tests that actually reduce release risk.',
		stats: [
			{ value: '24h', label: 'Response time', counter: '24', suffix: 'h' },
			{ value: '5+', label: 'Years of experience', counter: '5', suffix: '+' },
			{ value: 'Flexible', label: 'Monthly plans' },
		],
	};
---

<section class="cta-section relative overflow-hidden py-20 md:py-36">
	<!-- grid overlay -->
	<div class="cta-grid-overlay" aria-hidden="true"></div>

	<Container class="relative z-10 text-center">
		<p class="section-eyebrow justify-center reveal">{ctaMeta.eyebrow}</p>
		<h2 class="cta-title mx-auto mt-5 max-w-3xl text-3xl font-extrabold md:text-5xl reveal"
			style="--reveal-delay:60ms">
			{ctaMeta.title}
		</h2>
		<p class="cta-copy mx-auto mt-5 max-w-2xl reveal" style="--reveal-delay:120ms">
			{ctaMeta.lead}
		</p>

		<div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row reveal" style="--reveal-delay:180ms">
			<Button href={routeMap.quote} lang={lang}>
				{copy[lang].nav.quote} <ArrowRight class="size-4" />
			</Button>
			<Button href={routeMap.contact} lang={lang} variant="secondary">
				{ctaMeta.secondary}
			</Button>
		</div>

		<!-- micro-stats -->
		<div class="mt-10 flex flex-wrap justify-center gap-x-10 gap-y-6 border-t border-white/15 pt-8 md:mt-16 md:gap-x-12 md:pt-12 reveal" style="--reveal-delay:220ms">
			{ctaMeta.stats.map(({ value, label, counter, suffix }) => (
				<div class="text-center">
					<p
						class="text-2xl font-extrabold text-white"
						data-counter={counter}
						data-counter-suffix={suffix}
					>{value}</p>
					<p class="mt-1 text-xs font-semibold uppercase tracking-[0.14em] text-white/50">{label}</p>
				</div>
			))}
		</div>
	</Container>
</section>
