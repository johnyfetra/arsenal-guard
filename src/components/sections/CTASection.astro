---
import ArrowRight from 'lucide-astro/ArrowRight';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import { copy, routeMap, type Lang } from '../../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<section class="cta-section py-20">
	<Container class="text-center">
		<h2 class="cta-title mx-auto max-w-3xl text-3xl font-extrabold md:text-5xl">{copy[lang].sections.cta}</h2>
		<p class="cta-copy mx-auto mt-5 max-w-2xl">{copy[lang].sections.ctaLead}</p>
		<div class="mt-8"><Button href={routeMap.quote} lang={lang}>{copy[lang].nav.quote} <ArrowRight class="size-4" /></Button></div>
	</Container>
</section>
