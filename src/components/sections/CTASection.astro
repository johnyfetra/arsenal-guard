---
import ArrowRight from 'lucide-astro/ArrowRight';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import { copy, routeMap, type Lang } from '../../lib/i18n';
interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const ctaMeta =
	lang === 'fr'
		? {
				eyebrow: 'Avant votre prochaine livraison',
				secondary: 'Voir les formules',
				title: 'Faites tester vos parcours critiques avant que vos clients ne le fassent à votre place.',
				lead: 'Décrivez votre besoin en quelques lignes : je reviens vers vous sous 24h avec un périmètre clair et un prix HT. Premier test possible dès 350 € HT, livré sous 72h.',
				stats: [
					{ value: '24h', label: 'Délai de réponse', counter: '24', suffix: 'h' },
					{ value: 'dès 350 €', label: 'HT · premier test' },
					{ value: 'UTC+3', label: 'Overlap Europe' },
				],
			}
		: {
				eyebrow: 'Before your next release',
				secondary: 'See the plans',
				title: 'Get your critical journeys tested before your customers do it for you.',
				lead: 'Describe your need in a few lines: I get back to you within 24h with a clear scope and a price. First test from €350 excl. VAT, delivered within 72h.',
				stats: [
					{ value: '24h', label: 'Response time', counter: '24', suffix: 'h' },
					{ value: 'from €350', label: 'excl. VAT · first test' },
					{ value: 'UTC+3', label: 'Europe overlap' },
				],
			};
---

<section class="cta-section relative overflow-hidden py-20 md:py-36">
	<!-- grid overlay -->
	<div class="cta-grid-overlay" aria-hidden="true"></div>

	<Container class="relative z-10 text-center">
		<p class="section-eyebrow justify-center reveal">{ctaMeta.eyebrow}</p>
		<h2 class="cta-title mx-auto mt-5 max-w-3xl text-3xl font-extrabold md:text-5xl reveal" style="--reveal-delay:60ms">
			{ctaMeta.title}
		</h2>
		<p class="cta-copy mx-auto mt-5 max-w-2xl reveal" style="--reveal-delay:120ms">
			{ctaMeta.lead}
		</p>

		<div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row reveal" style="--reveal-delay:180ms">
			<Button href={routeMap.quote} lang={lang}>
				{copy[lang].nav.quote}
				<ArrowRight class="size-4" />
			</Button>
			<Button href={routeMap.contact} lang={lang} variant="secondary">
				{ctaMeta.secondary}
			</Button>
		</div>

		<!-- micro-stats -->
		<div
			class="mt-10 flex flex-wrap justify-center gap-x-10 gap-y-6 border-t border-white/15 pt-8 md:mt-16 md:gap-x-12 md:pt-12 reveal"
			style="--reveal-delay:220ms"
		>
			{
				ctaMeta.stats.map(({ value, label, counter, suffix }) => (
					<div class="text-center">
						<p class="text-2xl font-extrabold text-white" data-counter={counter} data-counter-suffix={suffix}>
							{value}
						</p>
						<p class="mt-1 text-xs font-semibold uppercase tracking-[0.14em] text-white/50">{label}</p>
					</div>
				))
			}
		</div>
	</Container>
</section>
