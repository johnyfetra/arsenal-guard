---
import Container from '../ui/Container.astro';
import type { Lang } from '../../lib/i18n';

interface Props {
	lang?: Lang;
}
const { lang = 'fr' } = Astro.props;

const placeholders =
	lang === 'fr'
		? [
				{
					initials: 'C',
					company: 'Chanel',
					role: 'Plateforme e-commerce',
					quote:
						'Mission QA livrée avec succès. Rapport détaillé en attente de validation client avant publication publique.',
					status: 'Livré',
				},
				{
					initials: 'S',
					company: 'Sodexo',
					role: 'Pipeline CI/CD',
					quote: 'Suite E2E stabilisée et intégrée dans la chaîne de livraison. Témoignage en cours de validation.',
					status: 'Stabilisé',
				},
				{
					initials: 'H',
					company: 'Hexaglobe',
					role: 'Produit SaaS',
					quote: 'Audit QA et couverture critique produit réalisés. Publication après accord client.',
					status: 'Cartographié',
				},
			]
		: [
				{
					initials: 'C',
					company: 'Chanel',
					role: 'E-commerce platform',
					quote:
						'QA mission successfully delivered. Detailed report pending client approval before public publication.',
					status: 'Delivered',
				},
				{
					initials: 'S',
					company: 'Sodexo',
					role: 'CI/CD pipeline',
					quote: 'E2E suite stabilized and integrated into the delivery chain. Testimonial pending approval.',
					status: 'Stabilized',
				},
				{
					initials: 'H',
					company: 'Hexaglobe',
					role: 'SaaS product',
					quote: 'QA audit and critical product coverage delivered. Publication after client approval.',
					status: 'Mapped',
				},
			];
---

<section class="section-skew-both section-band relative z-10">
	<Container>
		<div class="mb-14 text-center">
			<p class="section-eyebrow justify-center">{lang === 'fr' ? 'Rapports terrain' : 'Field reports'}</p>
			<h2 class="mt-4 text-3xl font-extrabold md:text-5xl">
				{
					lang === 'fr'
						? 'Des missions menées sur des environnements exigeants.'
						: 'Missions delivered in demanding environments.'
				}
			</h2>
			<p class="mx-auto mt-4 max-w-2xl text-muted leading-relaxed" data-reveal>
				{
					lang === 'fr'
						? 'La preuve reste sobre : les détails publics arrivent uniquement après validation client.'
						: 'Proof stays sober: public details are published only after client approval.'
				}
			</p>
		</div>

		<div class="grid gap-6 md:grid-cols-3">
			{
				placeholders.map((item, index) => (
					<div class="quote-card reveal" style={`--reveal-delay:${index * 80}ms`}>
						<div class="field-report-status mb-5">{item.status}</div>
						<p class="text-sm leading-relaxed text-muted">"{item.quote}"</p>
						<div class="mt-6 flex items-center gap-3 border-t border-white/10 pt-5">
							<div class="quote-avatar">{item.initials}</div>
							<div>
								<p class="font-bold text-sm">{item.company}</p>
								<p class="text-xs text-muted">{item.role}</p>
							</div>
						</div>
					</div>
				))
			}
		</div>

		<p class="mt-8 text-center text-xs text-muted opacity-60 reveal">
			{
				lang === 'fr'
					? 'Témoignages en cours de collecte — publications après validation client.'
					: 'Testimonials are being collected and will be published after client approval.'
			}
		</p>
	</Container>
</section>
