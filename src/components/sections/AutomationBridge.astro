---
import ArrowRight from 'lucide-astro/ArrowRight';
import GitBranch from 'lucide-astro/GitBranch';
import ClipboardList from 'lucide-astro/ClipboardList';
import ShieldCheck from 'lucide-astro/ShieldCheck';
import Container from '../ui/Container.astro';
import { routeMap, type Lang } from '../../lib/i18n';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;

const labels =
	lang === 'fr'
		? {
				eyebrow: 'Forge des garde-fous',
				title: "Un bug trouvé aujourd'hui devient une sentinelle demain.",
				subtitle:
					"Le QA Snapshot révèle les failles du terrain. L'automatisation transforme les parcours les plus sensibles en contrôles reproductibles avant chaque release.",
				left: {
					kicker: 'Signal terrain',
					title: 'Reconnaissance QA',
					desc: 'Un testeur humain trouve les ruptures réelles, les ambiguïtés UX et les anomalies que la CI ne voit pas.',
					cta: 'Voir la mission',
					href: routeMap.snapshot,
				},
				right: {
					kicker: 'Garde automatisée',
					title: 'E2E Framework Setup',
					desc: 'Les flux critiques deviennent des tests Playwright/Cypress maintenables, visibles dans la pipeline CI/CD.',
					cta: 'Voir le service',
					href: routeMap.automation,
				},
				connector: 'Le risque confirmé devient un garde-fou CI',
			}
		: {
				eyebrow: 'Guardrail forge',
				title: 'A bug found today becomes a sentinel tomorrow.',
				subtitle:
					'The QA Snapshot exposes weak terrain. Automation turns the most sensitive journeys into repeatable checks before every release.',
				left: {
					kicker: 'Field signal',
					title: 'QA Recon',
					desc: 'A human tester finds real breakpoints, UX ambiguity and defects that CI cannot see.',
					cta: 'View mission',
					href: routeMap.snapshot,
				},
				right: {
					kicker: 'Automated guard',
					title: 'E2E Framework Setup',
					desc: 'Critical flows become maintainable Playwright/Cypress tests, visible in the CI/CD pipeline.',
					cta: 'View service',
					href: routeMap.automation,
				},
				connector: 'Confirmed risk becomes a CI guardrail',
			};
---

<section class="bridge-section section-band border-y py-20 md:py-28">
	<Container>
		<div class="mb-12">
			<p class="section-eyebrow">{labels.eyebrow}</p>
			<h2 class="mt-4 max-w-3xl text-3xl font-extrabold md:text-5xl">{labels.title}</h2>
			<p class="mt-4 max-w-2xl text-muted leading-relaxed" data-reveal>{labels.subtitle}</p>
		</div>

		<div class="bridge-layout grid items-stretch gap-4 md:grid-cols-[1fr_auto_1fr]">
			<div class="bridge-card reveal flex flex-col rounded-2xl border p-6 md:p-8" style="--reveal-delay:60ms">
				<div class="bridge-icon-wrap mb-4 inline-flex size-10 items-center justify-center rounded-xl">
					<ClipboardList class="size-5 text-orange-400" aria-hidden="true" />
				</div>
				<p class="text-xs font-bold uppercase tracking-[0.14em] text-orange-400">{labels.left.kicker}</p>
				<h3 class="mt-2 text-xl font-extrabold">{labels.left.title}</h3>
				<p class="mt-3 flex-1 text-sm text-muted leading-relaxed">{labels.left.desc}</p>
				<a
					href={labels.left.href}
					class="bridge-link mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-orange-400 hover:underline"
				>
					{labels.left.cta}
					<ArrowRight class="size-3.5" />
				</a>
			</div>

			<div
				class="bridge-connector hidden md:flex flex-col items-center justify-center gap-3 px-2 reveal"
				style="--reveal-delay:120ms"
			>
				<div class="bridge-connector-line flex-1 w-px"></div>
				<p class="bridge-connector-label max-w-[6rem] text-center text-xs font-semibold text-muted leading-snug">
					{labels.connector}
				</p>
				<div class="bridge-arrow-wrap flex size-9 items-center justify-center rounded-full">
					<ShieldCheck class="size-4 text-orange-400" aria-hidden="true" />
				</div>
				<div class="bridge-connector-line flex-1 w-px"></div>
			</div>

			<div class="flex items-center gap-3 md:hidden reveal" style="--reveal-delay:120ms">
				<div class="h-px flex-1 bg-white/10"></div>
				<ShieldCheck class="size-4 text-orange-400" aria-hidden="true" />
				<div class="h-px flex-1 bg-white/10"></div>
			</div>

			<div class="bridge-card reveal flex flex-col rounded-2xl border p-6 md:p-8" style="--reveal-delay:180ms">
				<div class="bridge-icon-wrap mb-4 inline-flex size-10 items-center justify-center rounded-xl">
					<GitBranch class="size-5 text-orange-400" aria-hidden="true" />
				</div>
				<p class="text-xs font-bold uppercase tracking-[0.14em] text-orange-400">{labels.right.kicker}</p>
				<h3 class="mt-2 text-xl font-extrabold">{labels.right.title}</h3>
				<p class="mt-3 flex-1 text-sm text-muted leading-relaxed">{labels.right.desc}</p>
				<a
					href={labels.right.href}
					class="bridge-link mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-orange-400 hover:underline"
				>
					{labels.right.cta}
					<ArrowRight class="size-3.5" />
				</a>
			</div>
		</div>
	</Container>
</section>

<style>
	.bridge-card {
		position: relative;
		background: rgba(15, 31, 68, 0.5);
		border-color: rgba(255, 255, 255, 0.08);
		transition: border-color 0.2s ease;
		overflow: visible;
	}

	.bridge-card::before {
		content: '';
		position: absolute;
		inset: -1px;
		border-radius: calc(1rem + 1px);
		padding: 1px;
		background: conic-gradient(
			from var(--btn-border-angle),
			transparent 230deg,
			rgba(255, 160, 20, 0.6) 258deg,
			rgba(255, 220, 90, 0.88) 275deg,
			rgba(255, 160, 20, 0.6) 292deg,
			transparent 320deg
		);
		-webkit-mask:
			linear-gradient(#fff 0 0) content-box,
			linear-gradient(#fff 0 0);
		mask:
			linear-gradient(#fff 0 0) content-box,
			linear-gradient(#fff 0 0);
		-webkit-mask-composite: destination-out;
		mask-composite: exclude;
		opacity: 0;
		transition: opacity 300ms ease;
		animation: btn-border-spin 4s linear infinite;
		pointer-events: none;
		z-index: 1;
	}

	.bridge-card:hover::before {
		opacity: 1;
	}

	:global([data-theme='light']) .bridge-card {
		background: rgba(255, 255, 255, 0.85);
		border-color: rgba(0, 0, 0, 0.08);
	}

	.bridge-card:hover {
		border-color: rgba(230, 126, 34, 0.3);
	}

	.bridge-icon-wrap {
		background: rgba(230, 126, 34, 0.1);
	}

	:global([data-theme='light']) .bridge-icon-wrap {
		background: rgba(230, 126, 34, 0.12);
	}

	.bridge-connector-line {
		background: linear-gradient(to bottom, transparent, rgba(230, 126, 34, 0.3), transparent);
	}

	.bridge-arrow-wrap {
		background: rgba(230, 126, 34, 0.12);
		border: 1px solid rgba(230, 126, 34, 0.25);
	}
</style>
