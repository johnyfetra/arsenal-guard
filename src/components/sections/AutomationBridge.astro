---
import ArrowRight from 'lucide-astro/ArrowRight';
import Cog from 'lucide-astro/Cog';
import ClipboardList from 'lucide-astro/ClipboardList';
import Container from '../ui/Container.astro';
import { routeMap, type Lang } from '../../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;

const labels = lang === 'fr'
	? {
		eyebrow: 'Progression naturelle',
		title: 'Du test manuel à l\'automatisation.',
		subtitle: 'Le QA Snapshot identifie les parcours critiques. L\'automatisation les sécurise à chaque release. Une progression logique, au rythme de votre équipe.',
		left: {
			kicker: 'Étape 1',
			title: 'QA Snapshot',
			desc: 'Rapport de bugs humain sur vos parcours clés. Livré sous 72h, sans setup.',
			cta: 'Voir le service',
			href: routeMap.snapshot,
		},
		right: {
			kicker: 'Étape 2',
			title: 'E2E Framework Setup',
			desc: 'Automatisation Cypress ou Playwright des parcours critiques identifiés. Suite maintenable et documentée.',
			cta: 'Voir le service',
			href: routeMap.automation,
		},
		connector: 'Les bugs identifiés deviennent les premiers tests à automatiser',
	}
	: {
		eyebrow: 'Natural progression',
		title: 'From manual testing to automation.',
		subtitle: 'The QA Snapshot identifies critical flows. Automation secures them on every release. A logical progression, at your team\'s pace.',
		left: {
			kicker: 'Step 1',
			title: 'QA Snapshot',
			desc: 'Human bug report on your key flows. Delivered in 72h, no setup.',
			cta: 'View service',
			href: routeMap.snapshot,
		},
		right: {
			kicker: 'Step 2',
			title: 'E2E Framework Setup',
			desc: 'Cypress or Playwright automation of the critical flows identified. Maintainable and documented suite.',
			cta: 'View service',
			href: routeMap.automation,
		},
		connector: 'Bugs identified become the first flows to automate',
	};
---

<section class="bridge-section section-band border-y py-20 md:py-28">
	<Container>
		<div class="mb-12 reveal">
			<p class="section-eyebrow">{labels.eyebrow}</p>
			<h2 class="mt-4 max-w-3xl text-3xl font-extrabold md:text-5xl">{labels.title}</h2>
			<p class="mt-4 max-w-2xl text-muted leading-relaxed">{labels.subtitle}</p>
		</div>

		<div class="bridge-layout grid items-stretch gap-4 md:grid-cols-[1fr_auto_1fr]">
			<!-- Left card: QA Snapshot -->
			<div class="bridge-card reveal flex flex-col rounded-2xl border p-6 md:p-8" style="--reveal-delay:60ms">
				<div class="bridge-icon-wrap mb-4 inline-flex size-10 items-center justify-center rounded-xl">
					<ClipboardList class="size-5 text-orange-400" />
				</div>
				<p class="text-xs font-bold uppercase tracking-[0.14em] text-orange-400">{labels.left.kicker}</p>
				<h3 class="mt-2 text-xl font-extrabold">{labels.left.title}</h3>
				<p class="mt-3 flex-1 text-sm text-muted leading-relaxed">{labels.left.desc}</p>
				<a href={labels.left.href} class="bridge-link mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-orange-400 hover:underline">
					{labels.left.cta} <ArrowRight class="size-3.5" />
				</a>
			</div>

			<!-- Connector -->
			<div class="bridge-connector hidden md:flex flex-col items-center justify-center gap-3 px-2 reveal" style="--reveal-delay:120ms">
				<div class="bridge-connector-line flex-1 w-px"></div>
				<p class="bridge-connector-label max-w-[6rem] text-center text-xs font-semibold text-muted leading-snug">{labels.connector}</p>
				<div class="bridge-arrow-wrap flex size-9 items-center justify-center rounded-full">
					<ArrowRight class="size-4 text-orange-400" />
				</div>
				<div class="bridge-connector-line flex-1 w-px"></div>
			</div>

			<!-- Mobile separator -->
			<div class="flex items-center gap-3 md:hidden reveal" style="--reveal-delay:120ms">
				<div class="h-px flex-1 bg-white/10"></div>
				<ArrowRight class="size-4 text-orange-400 rotate-90" />
				<div class="h-px flex-1 bg-white/10"></div>
			</div>

			<!-- Right card: E2E Framework -->
			<div class="bridge-card reveal flex flex-col rounded-2xl border p-6 md:p-8" style="--reveal-delay:180ms">
				<div class="bridge-icon-wrap mb-4 inline-flex size-10 items-center justify-center rounded-xl">
					<Cog class="size-5 text-orange-400" />
				</div>
				<p class="text-xs font-bold uppercase tracking-[0.14em] text-orange-400">{labels.right.kicker}</p>
				<h3 class="mt-2 text-xl font-extrabold">{labels.right.title}</h3>
				<p class="mt-3 flex-1 text-sm text-muted leading-relaxed">{labels.right.desc}</p>
				<a href={labels.right.href} class="bridge-link mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-orange-400 hover:underline">
					{labels.right.cta} <ArrowRight class="size-3.5" />
				</a>
			</div>
		</div>
	</Container>
</section>

<style>
	.bridge-card {
		background: rgba(15, 31, 68, 0.5);
		border-color: rgba(255, 255, 255, 0.08);
		transition: border-color 0.2s ease;
	}

	:global([data-theme='light']) .bridge-card {
		background: rgba(255, 255, 255, 0.85);
		border-color: rgba(0, 0, 0, 0.08);
	}

	.bridge-card:hover {
		border-color: rgba(230, 126, 34, 0.3);
	}

	.bridge-icon-wrap {
		background: rgba(230, 126, 34, 0.1);
	}

	:global([data-theme='light']) .bridge-icon-wrap {
		background: rgba(230, 126, 34, 0.12);
	}

	.bridge-connector-line {
		background: linear-gradient(to bottom, transparent, rgba(230, 126, 34, 0.3), transparent);
	}

	.bridge-arrow-wrap {
		background: rgba(230, 126, 34, 0.12);
		border: 1px solid rgba(230, 126, 34, 0.25);
	}
</style>
