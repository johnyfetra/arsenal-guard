---
import Container from '../ui/Container.astro';
import SectionIllustration from '../illustrations/SectionIllustration.astro';
import type { Lang } from '../../lib/i18n';
interface Props {
	lang: Lang;
}
const { lang } = Astro.props;

const categories = [
	{ label: lang === 'fr' ? 'Automation E2E' : 'E2E automation', items: ['Playwright', 'Cypress', 'TypeScript'] },
	{ label: lang === 'fr' ? 'API & intégration' : 'API & integration', items: ['Postman', 'REST APIs', 'Contract testing'] },
	{ label: lang === 'fr' ? 'CI/CD & gates qualité' : 'CI/CD & quality gates', items: ['GitHub Actions', 'GitLab CI', 'Tests bloquants'] },
	{ label: lang === 'fr' ? 'Reporting & accessibilité' : 'Reporting & accessibility', items: ['Allure Reports', 'axe-core', 'AI-assisted QA'] },
];
const stats =
	lang === 'fr'
		? [
				{
					value: '5+',
					label: "années d'expérience QA senior",
					counter: '5',
					suffix: '+',
					prefix: undefined,
					final: undefined,
				},
				{
					value: '40–50%',
					label: "d'économie vs staffing local équivalent",
					counter: '50',
					suffix: '%',
					prefix: undefined,
					final: '40–50%',
				},
				{
					value: 'UTC+3',
					label: "recouvrement confortable avec l'Europe",
					counter: '3',
					suffix: '',
					prefix: 'UTC+',
					final: undefined,
				},
			]
		: [
				{
					value: '5+',
					label: 'years of senior QA experience',
					counter: '5',
					suffix: '+',
					prefix: undefined,
					final: undefined,
				},
				{
					value: '40–50%',
					label: 'savings vs equivalent local staffing',
					counter: '50',
					suffix: '%',
					prefix: undefined,
					final: '40–50%',
				},
				{
					value: 'UTC+3',
					label: 'comfortable overlap with Europe',
					counter: '3',
					suffix: '',
					prefix: 'UTC+',
					final: undefined,
				},
			];

const labels =
	lang === 'fr'
		? {
				eyebrow: 'Stack technique',
				title: 'Les outils QA qui font le travail — framework-agnostique.',
				lead: "Je m'intègre à votre stack front (React, Vue, Angular, Next, Svelte…), je ne l'impose pas. Ces outils me permettent de tester, automatiser et verrouiller vos releases — quelle que soit votre technologie.",
				consoleTitle: 'Rapport de test',
				consoleRows: [
					['login-flow.spec', 'passed'],
					['checkout.spec', '1 bug critique'],
					['inscription.spec', 'passed'],
				],
			}
		: {
				eyebrow: 'Technical stack',
				title: 'QA tools that do the work — framework-agnostic.',
				lead: 'I integrate with your front-end stack (React, Vue, Angular, Next, Svelte…), I don\'t impose it. These tools let me test, automate and lock down your releases — whatever your technology.',
				consoleTitle: 'Test report',
				consoleRows: [
					['login-flow.spec', 'passed'],
					['checkout.spec', '1 critical bug'],
					['signup.spec', 'passed'],
				],
			};
---

<section id="technical-arsenal" class="armory-section relative overflow-hidden py-16 md:py-32">
	<div class="armory-angle" aria-hidden="true"></div>

	<Container>
		<div class="mb-10 grid gap-6 md:mb-14 md:grid-cols-[1fr_auto] md:items-end">
			<div>
				<p class="section-eyebrow">{labels.eyebrow}</p>
				<h2 class="mt-4 max-w-3xl text-3xl font-extrabold md:text-5xl">{labels.title}</h2>
			</div>
			<p class="max-w-sm text-sm text-muted leading-relaxed" data-reveal>{labels.lead}</p>
		</div>

		<div class="armory-layout grid gap-6 lg:grid-cols-[1fr_0.72fr] lg:items-stretch">
			<div class="grid gap-8 md:grid-cols-2">
				{
					categories.map((cat, ci) => (
						<div class="armory-category reveal" style={`--reveal-delay:${ci * 70}ms`}>
							<p class="mb-4 text-xs font-bold uppercase tracking-[0.18em] text-muted">{cat.label}</p>
							<div class="flex flex-wrap gap-2">
								{cat.items.map((item) => (
									<span class="stack-pill">
										<span class="stack-pill-dot" aria-hidden="true" />
										{item}
									</span>
								))}
							</div>
						</div>
					))
				}
			</div>

			<div class="armory-console reveal" style="--reveal-delay:220ms">
				<div class="armory-console-head">
					<span></span>
					<p>{labels.consoleTitle}</p>
				</div>
				<SectionIllustration variant="pipeline" lang={lang} class="armory-pipeline-illustration" />
				<div class="armory-console-lines">
					{
						labels.consoleRows.map(([name, status]) => (
							<div>
								<code>{name}</code>
								<span>{status}</span>
							</div>
						))
					}
				</div>
			</div>
		</div>

		<div class="mt-10 grid gap-6 border-t border-white/10 pt-8 md:mt-16 md:grid-cols-3 md:pt-12 reveal">
			{
				stats.map(({ value, label, counter, suffix, prefix, final }) => (
					<div class="flex items-center gap-4">
						<p
							class="stat-number"
							data-counter={counter}
							data-counter-suffix={suffix}
							data-counter-prefix={prefix}
							data-counter-final={final}
						>
							{value}
						</p>
						<p class="text-sm text-muted leading-snug max-w-[12rem]">{label}</p>
					</div>
				))
			}
		</div>
	</Container>
</section>
