---
import Container from '../ui/Container.astro';
import { copy, type Lang } from '../../lib/i18n';
import { faq } from '../../lib/site';
interface Props { lang: Lang; items?: string[][] }
const { lang, items = faq } = Astro.props;
---

<section class="relative py-24 md:py-32 overflow-hidden">
	<!-- diagonal accent -->
	<div
		class="absolute inset-0 -z-10 opacity-30"
		aria-hidden="true"
		style="background: linear-gradient(155deg, rgba(10,21,48,0.6) 0%, transparent 45%);"
	></div>

	<Container>
		<div class="mb-14 grid gap-6 md:grid-cols-[1fr_auto] md:items-end reveal">
			<div>
				<p class="section-eyebrow">FAQ</p>
				<h2 class="mt-4 text-3xl font-extrabold md:text-5xl">{copy[lang].sections.faq}</h2>
			</div>
			<p class="max-w-xs text-sm text-muted leading-relaxed">
				Une question non couverte ? <a href="contact" class="text-orange-400 hover:underline">Écrivez-nous.</a>
			</p>
		</div>

		<div class="grid gap-3 md:grid-cols-2">
			{items.map(([question, answer], index) => (
				<div class="faq-item reveal" style={`--reveal-delay:${index * 40}ms`}>
					<details>
						<summary class="faq-item summary">{question}</summary>
						<p class="faq-answer">{answer}</p>
					</details>
				</div>
			))}
		</div>
	</Container>
</section>
