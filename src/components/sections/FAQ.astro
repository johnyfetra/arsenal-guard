---
import Container from '../ui/Container.astro';
import { copy, type Lang } from '../../lib/i18n';
import { faq } from '../../lib/site';
interface Props { lang: Lang; items?: string[][] }
const { lang, items: passedItems } = Astro.props;
const localizedFaq = lang === 'fr'
	? faq
	: [
		['Why use a QA service instead of hiring?', 'You get faster impact, senior expertise and budget flexibility without a long recruitment cycle.'],
		['How does remote collaboration with Madagascar work?', 'We use comfortable European overlap, weekly checkpoints, transparent backlogs and visible deliverables in your tools.'],
		['How fast can we start?', 'An audit can start within a few days. A monthly plan usually needs one onboarding week.'],
		['Are your tests maintainable?', 'Yes. Conventions, selectors, fixtures and reports are designed so your developers can own them.'],
		['How do you protect confidentiality?', 'NDA available, limited access, least-privilege principles and no sharing of client data.'],
		['How does billing work?', 'Tax-inclusive invoicing, bank transfer and optional deposit for one-off missions.'],
		['Do you work with early-stage startups?', 'Yes when the scope is clear: audit, critical MVP journey or lightweight E2E setup.'],
		['How do we choose one-off or monthly?', 'One-off is best for a targeted issue. Monthly is best for continuous release cadence.'],
	];
const items = passedItems ?? localizedFaq;
const contactHref = lang === 'fr' ? 'contact' : '/en/contact';
---

<section class="relative overflow-hidden py-16 md:py-32">
	<!-- diagonal accent -->
	<div
		class="absolute inset-0 -z-10 opacity-30"
		aria-hidden="true"
		style="background: linear-gradient(155deg, rgba(10,21,48,0.6) 0%, transparent 45%);"
	></div>

	<Container>
		<div class="mb-10 grid gap-6 md:mb-14 md:grid-cols-[1fr_auto] md:items-end reveal">
			<div>
				<p class="section-eyebrow">FAQ</p>
				<h2 class="mt-4 text-3xl font-extrabold md:text-5xl">{copy[lang].sections.faq}</h2>
			</div>
			<p class="max-w-xs text-sm text-muted leading-relaxed">
				{lang === 'fr' ? 'Une question non couverte ?' : 'Question not covered?'} <a href={contactHref} class="text-orange-400 hover:underline">{lang === 'fr' ? 'Écrivez-nous.' : 'Contact us.'}</a>
			</p>
		</div>

		<div class="grid gap-3 md:grid-cols-2">
			{items.map(([question, answer], index) => (
				<div class="faq-item reveal" style={`--reveal-delay:${index * 40}ms`}>
					<details>
						<summary class="faq-item summary">{question}</summary>
						<p class="faq-answer">{answer}</p>
					</details>
				</div>
			))}
		</div>
	</Container>
</section>
