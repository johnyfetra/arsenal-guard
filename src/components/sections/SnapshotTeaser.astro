---
import ArrowRight from 'lucide-astro/ArrowRight';
import Check from 'lucide-astro/Check';
import Star from 'lucide-astro/Star';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import { routeMap, type Lang } from '../../lib/i18n';
import { services } from '../../lib/site';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;

const snapshot = services.find((s) => s.id === 'test-manuel-ponctuel');

if (!snapshot?.tiers) {
	throw new Error('QA Snapshot service tiers are required for SnapshotTeaser.');
}

const labels =
	lang === 'fr'
		? {
				eyebrow: 'Reconnaissance avant release',
				title: 'Envoyez une sentinelle QA sur vos parcours critiques.',
				subtitle:
					'Un testeur humain parcourt vos pages comme un utilisateur réel, documente les anomalies et livre un rapport priorisé sous 72h. Sans setup. Sans engagement.',
				recommended: 'Recommandé',
				custom: 'Terrain plus large ?',
				customLink: 'Demander une mission sur mesure',
				cta: 'Voir la mission complète',
				perTier: [
					{
						label: 'Patrouille ciblée',
						duration: '3–4 pages · ~1,5 jour',
						perks: ['Rapport PDF structuré', 'Captures annotées', 'Bugs Critique / Majeur / Mineur'],
					},
					{
						label: 'Garde standard',
						duration: '5–7 pages · ~2,5 jours',
						perks: [
							'Rapport PDF structuré',
							'Captures annotées',
							'Matrice de couverture',
							'Recommandations UX quick wins',
						],
					},
					{
						label: 'Périmètre complet',
						duration: "Jusqu'à 20 pages · ~5 jours",
						perks: [
							'Rapport PDF structuré',
							'Captures annotées',
							'Matrice de couverture',
							'Recommandations UX + synthèse exécutive',
							'Intégration Jira / Linear incluse',
						],
					},
				],
			}
		: {
				eyebrow: 'Pre-release recon',
				title: 'Send a QA sentinel through your critical journeys.',
				subtitle:
					'A human tester walks through your pages like a real user, documents defects and delivers a prioritized report within 72h. No setup. No commitment.',
				recommended: 'Recommended',
				custom: 'Larger terrain?',
				customLink: 'Request a custom mission',
				cta: 'View full mission',
				perTier: [
					{
						label: 'Targeted patrol',
						duration: '3–4 pages · ~1.5 days',
						perks: ['Structured PDF report', 'Annotated screenshots', 'Critical / Major / Minor bugs'],
					},
					{
						label: 'Standard guard',
						duration: '5–7 pages · ~2.5 days',
						perks: ['Structured PDF report', 'Annotated screenshots', 'Coverage matrix', 'UX quick wins'],
					},
					{
						label: 'Full perimeter',
						duration: 'Up to 20 pages · ~5 days',
						perks: [
							'Structured PDF report',
							'Annotated screenshots',
							'Coverage matrix',
							'UX recommendations + executive summary',
							'Jira / Linear integration included',
						],
					},
				],
			};
---

<section id="qa-recon" class="snapshot-teaser tactical-snapshot py-20 md:py-32">
	<Container>
		<div class="mb-12">
			<p class="section-eyebrow">{labels.eyebrow}</p>
			<h2 class="mt-4 max-w-3xl text-3xl font-extrabold md:text-5xl">{labels.title}</h2>
			<p class="mt-4 max-w-2xl text-muted text-lg leading-relaxed" data-reveal>{labels.subtitle}</p>
		</div>

		<div class="grid gap-5 md:grid-cols-3">
			{
				snapshot.tiers.map((tier, index) => {
					const info = labels.perTier[index];
					const isFeatured = tier.featured === true;
					return (
						<div
							class={`snapshot-card reveal flex flex-col rounded-2xl border p-6 md:p-7 ${isFeatured ? 'snapshot-card--featured' : ''}`}
							style={`--reveal-delay:${index * 80}ms`}
						>
							{isFeatured && (
								<div class="mb-4 flex items-center gap-1.5">
									<Star class="size-3.5 fill-orange-400 text-orange-400" />
									<span class="snapshot-badge text-xs font-bold uppercase tracking-[0.14em]">{labels.recommended}</span>
								</div>
							)}
							<p class="font-mono text-sm font-bold text-orange-400">{info.label}</p>
							<p class="mt-1 text-xs font-semibold uppercase tracking-[0.12em] text-muted">{info.duration}</p>
							<p class="snapshot-price mt-4 text-3xl font-extrabold">{tier.price}</p>

							<ul class="mt-5 flex-1 space-y-2">
								{info.perks.map((perk) => (
									<li class="flex items-start gap-2 text-sm text-muted">
										<Check class="mt-0.5 size-4 flex-shrink-0 text-orange-400" />
										{perk}
									</li>
								))}
							</ul>

							{isFeatured && (
								<div class="mt-6">
									<Button href={routeMap.quote} lang={lang} class="w-full justify-center">
										{lang === 'fr' ? 'Démarrer' : 'Get started'}
									</Button>
								</div>
							)}
						</div>
					);
				})
			}
		</div>

		<div
			class="mt-8 flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:justify-between reveal"
			style="--reveal-delay:280ms"
		>
			<p class="text-sm text-muted">
				{labels.custom}{' '}
				<a href={routeMap.quote} class="font-semibold text-orange-400 hover:underline">{labels.customLink}</a>
			</p>
			<Button href={routeMap.snapshot} lang={lang} variant="ghost">
				{labels.cta}
				<ArrowRight class="size-4" />
			</Button>
		</div>
	</Container>
</section>

<style>
	.tactical-snapshot {
		position: relative;
		background:
			linear-gradient(90deg, rgba(255, 106, 42, 0.06), transparent 30%),
			linear-gradient(270deg, rgba(24, 214, 178, 0.055), transparent 34%);
	}

	.tactical-snapshot::before {
		content: '';
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(rgba(255, 255, 255, 0.028) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255, 255, 255, 0.028) 1px, transparent 1px);
		background-size: 38px 38px;
		mask-image: linear-gradient(180deg, transparent, #000 18%, #000 82%, transparent);
		pointer-events: none;
	}

	.snapshot-card {
		position: relative;
		background: rgba(var(--color-surface-rgb, 15 31 68), 0.6);
		border-color: rgba(255, 255, 255, 0.08);
		transition:
			border-color 0.2s ease,
			transform 0.2s ease;
		overflow: visible;
	}

	.snapshot-card::before {
		content: '';
		position: absolute;
		inset: -1px;
		border-radius: calc(1rem + 1px);
		padding: 1px;
		background: conic-gradient(
			from var(--btn-border-angle),
			transparent 230deg,
			rgba(255, 160, 20, 0.6) 258deg,
			rgba(255, 220, 90, 0.88) 275deg,
			rgba(255, 160, 20, 0.6) 292deg,
			transparent 320deg
		);
		-webkit-mask:
			linear-gradient(#fff 0 0) content-box,
			linear-gradient(#fff 0 0);
		mask:
			linear-gradient(#fff 0 0) content-box,
			linear-gradient(#fff 0 0);
		-webkit-mask-composite: destination-out;
		mask-composite: exclude;
		opacity: 0;
		transition: opacity 300ms ease;
		animation: btn-border-spin 4s linear infinite;
		pointer-events: none;
		z-index: 1;
	}

	.snapshot-card:hover::before {
		opacity: 1;
	}

	:global([data-theme='light']) .snapshot-card {
		background: rgba(255, 255, 255, 0.85);
		border-color: rgba(0, 0, 0, 0.08);
	}

	.snapshot-card:hover {
		border-color: rgba(230, 126, 34, 0.3);
		transform: translateY(-2px);
	}

	.snapshot-card--featured {
		border-color: rgba(230, 126, 34, 0.45);
		background: rgba(15, 31, 68, 0.9);
		box-shadow:
			0 0 0 1px rgba(230, 126, 34, 0.2),
			0 8px 32px rgba(0, 0, 0, 0.3);
	}

	:global([data-theme='light']) .snapshot-card--featured {
		background: #ffffff;
		box-shadow:
			0 0 0 1px rgba(230, 126, 34, 0.35),
			0 8px 32px rgba(230, 126, 34, 0.1);
	}

	.snapshot-badge {
		color: #f39c12;
	}

	.snapshot-price {
		color: #ffffff;
	}

	:global([data-theme='light']) .snapshot-price {
		color: #0f1f44;
	}
</style>
