---
import ArrowRight from 'lucide-astro/ArrowRight';
import Activity from 'lucide-astro/Activity';
import Bot from 'lucide-astro/Bot';
import GitBranch from 'lucide-astro/GitBranch';
import ShieldCheck from 'lucide-astro/ShieldCheck';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import { routeMap, type Lang } from '../../lib/i18n';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;

const hero =
	lang === 'fr'
		? {
				badge: 'Release Command · QA humaine + automation + CI/CD',
				title: ['Vos releases', 'sans angle mort.'],
				lead: 'Arsenal Guard combine QA manuelle senior, automatisation Playwright/Cypress et contrôle CI/CD pour livrer plus vite, sans perdre la maîtrise.',
				primary: 'Planifier un audit QA',
				secondary: 'Voir l’approche',
				proof: 'Europe remote · Tests manuels · Automation · CI/CD ready',
				radarTitle: 'Release readiness',
				radarSubtitle: 'Signal qualité avant production',
				layers: ['Human review', 'Automated checks', 'Release gate'],
				signals: [
					['Critical flows', '12 scénarios couverts', 'ready'],
					['Regression suite', '2 flakies isolés', 'watch'],
					['CI signal', 'Blocking tests actifs', 'pass'],
					['Risk map', '3 priorités produit', 'review'],
				],
				stats: [
					['72h', 'rapport priorisé'],
					['5+', 'ans QA senior'],
					['UTC+3', 'overlap Europe'],
				],
			}
		: {
				badge: 'Release Command · Human QA + automation + CI/CD',
				title: ['Release confidence', 'without blind spots.'],
				lead: 'Arsenal Guard combines senior manual QA, Playwright/Cypress automation and CI/CD release control for teams that need speed without blind spots.',
				primary: 'Book a QA audit',
				secondary: 'See the approach',
				proof: 'Europe remote · Manual testing · Automation · CI/CD ready',
				radarTitle: 'Release readiness',
				radarSubtitle: 'Quality signal before production',
				layers: ['Human review', 'Automated checks', 'Release gate'],
				signals: [
					['Critical flows', '12 journeys covered', 'ready'],
					['Regression suite', '2 flakies isolated', 'watch'],
					['CI signal', 'Blocking tests active', 'pass'],
					['Risk map', '3 product priorities', 'review'],
				],
				stats: [
					['72h', 'prioritized report'],
					['5+', 'senior QA years'],
					['UTC+3', 'Europe overlap'],
				],
			};

const icons = [ShieldCheck, Bot, GitBranch, Activity];
---

<section class="hero-shell hero-command relative isolate overflow-hidden">
	<div class="hero-command-grid" aria-hidden="true"></div>
	<div class="hero-command-beam hero-command-beam--orange" aria-hidden="true"></div>
	<div class="hero-command-beam hero-command-beam--teal" aria-hidden="true"></div>

	<Container class="relative z-10 grid gap-12 lg:grid-cols-[minmax(0,1.02fr)_minmax(24rem,.78fr)] lg:items-center">
		<div class="hero-command-copy">
			<p class="hero-command-badge">{hero.badge}</p>
			<h1 class="hero-command-title">
				{
					hero.title.map((line, index) => (
						<span class={index === hero.title.length - 1 ? 'hero-command-title-accent' : ''}>{line}</span>
					))
				}
			</h1>
			<p class="hero-command-lead">{hero.lead}</p>

			<div
				class="hero-command-actions"
				role="group"
				aria-label={lang === 'fr' ? 'Actions principales' : 'Primary actions'}
			>
				<Button href={routeMap.quote} lang={lang}>
					{hero.primary}
					<ArrowRight class="size-4" aria-hidden="true" />
				</Button>
				<Button href="#release-map" lang={lang} variant="secondary">
					{hero.secondary}
				</Button>
			</div>

			<p class="hero-command-proof">{hero.proof}</p>
		</div>

		<div class="hero-command-visual scroll-float" data-scroll-depth="-14" aria-label={hero.radarTitle}>
			<div class="release-radar">
				<div class="release-radar-rings" aria-hidden="true">
					<span></span>
					<span></span>
					<span></span>
				</div>
				<div class="release-radar-sweep" aria-hidden="true"></div>
				<div class="release-radar-core">
					<ShieldCheck class="size-8" aria-hidden="true" />
				</div>

				{
					hero.layers.map((layer, index) => (
						<div class={`release-layer release-layer--${index + 1}`}>
							<span class="release-layer-dot" aria-hidden="true" />
							{layer}
						</div>
					))
				}
			</div>

			<div class="release-panel">
				<div class="release-panel-head">
					<div>
						<p>{hero.radarTitle}</p>
						<span>{hero.radarSubtitle}</span>
					</div>
					<strong>94%</strong>
				</div>
				<div class="release-signal-list">
					{
						hero.signals.map(([label, value, state], index) => {
							const Icon = icons[index];
							return (
								<div class={`release-signal release-signal--${state}`}>
									<Icon class="size-4" aria-hidden="true" />
									<div>
										<p>{label}</p>
										<span>{value}</span>
									</div>
								</div>
							);
						})
					}
				</div>
			</div>

			<div
				class="hero-command-stats"
				aria-label={lang === 'fr' ? 'Indicateurs Arsenal Guard' : 'Arsenal Guard indicators'}
			>
				{
					hero.stats.map(([value, label]) => (
						<div>
							<strong>{value}</strong>
							<span>{label}</span>
						</div>
					))
				}
			</div>
		</div>
	</Container>
</section>

<style>
	.hero-command {
		min-height: calc(100svh - 6.5rem);
		align-items: center;
		padding-block: clamp(4rem, 9vh, 7rem);
		background:
			linear-gradient(118deg, rgba(255, 106, 42, 0.12), transparent 26%),
			linear-gradient(242deg, rgba(24, 214, 178, 0.11), transparent 32%),
			linear-gradient(135deg, #05070a 0%, #081827 52%, #102b3c 100%);
		color: #f5f7f8;
	}

	.hero-command-grid {
		position: absolute;
		inset: 0;
		z-index: -3;
		background-image:
			linear-gradient(rgba(255, 255, 255, 0.036) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255, 255, 255, 0.036) 1px, transparent 1px);
		background-size: 46px 46px;
		mask-image: radial-gradient(ellipse 85% 78% at 50% 42%, #000 0%, transparent 78%);
		opacity: 0.54;
	}

	.hero-command-beam {
		position: absolute;
		z-index: -2;
		width: min(42rem, 70vw);
		height: 1px;
		filter: blur(0.5px);
		opacity: 0.7;
		transform: rotate(-18deg);
		animation: release-beam 12s ease-in-out infinite alternate;
	}

	.hero-command-beam::before,
	.hero-command-beam::after {
		content: '';
		position: absolute;
		inset: -4rem 0;
		background: linear-gradient(90deg, transparent, currentColor, transparent);
		opacity: 0.2;
	}

	.hero-command-beam--orange {
		left: -6rem;
		top: 18%;
		color: #ff6a2a;
	}

	.hero-command-beam--teal {
		right: -7rem;
		top: 28%;
		color: #18d6b2;
		animation-delay: -5s;
	}

	.hero-command-badge {
		display: inline-flex;
		width: fit-content;
		border: 1px solid rgba(24, 214, 178, 0.26);
		border-radius: 9999px;
		background: rgba(24, 214, 178, 0.07);
		color: #8ff4dd;
		font-family: 'JetBrains Mono', ui-monospace, monospace;
		font-size: 0.74rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		padding: 0.55rem 0.85rem;
		text-transform: uppercase;
	}

	.hero-command-title {
		margin-top: clamp(1.4rem, 4vh, 2rem);
		max-width: 58rem;
		color: #f5f7f8;
		font-size: clamp(3.3rem, 7vw, 6.2rem);
		font-weight: 800;
		letter-spacing: 0;
		line-height: 0.94;
		text-wrap: balance;
	}

	.hero-command-title span {
		display: block;
	}

	.hero-command-title-accent {
		background: linear-gradient(95deg, #ff6a2a 0%, #f6c057 46%, #18d6b2 100%);
		background-clip: text;
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.hero-command-lead {
		margin-top: 1.45rem;
		max-width: 42rem;
		color: rgba(245, 247, 248, 0.72);
		font-size: clamp(1.02rem, 2vw, 1.2rem);
		line-height: 1.72;
	}

	.hero-command-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem;
		margin-top: 2rem;
	}

	.hero-command-proof {
		margin-top: 1.15rem;
		color: rgba(245, 247, 248, 0.55);
		font-family: 'JetBrains Mono', ui-monospace, monospace;
		font-size: 0.82rem;
	}

	.hero-command-visual {
		position: relative;
		min-height: 38rem;
	}

	.release-radar {
		position: relative;
		display: grid;
		width: min(31rem, 100%);
		aspect-ratio: 1;
		place-items: center;
		margin-left: auto;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 9999px;
		background: radial-gradient(circle, rgba(24, 214, 178, 0.08), transparent 52%), rgba(255, 255, 255, 0.025);
		box-shadow:
			inset 0 0 70px rgba(24, 214, 178, 0.06),
			0 34px 120px rgba(0, 0, 0, 0.38);
		overflow: hidden;
	}

	.release-radar-rings,
	.release-radar-rings span,
	.release-radar-sweep {
		position: absolute;
		inset: 0;
		border-radius: 9999px;
	}

	.release-radar-rings span {
		border: 1px solid rgba(255, 255, 255, 0.1);
		margin: var(--ring-space, 4rem);
	}

	.release-radar-rings span:nth-child(2) {
		--ring-space: 7.5rem;
		border-color: rgba(24, 214, 178, 0.18);
	}

	.release-radar-rings span:nth-child(3) {
		--ring-space: 11rem;
		border-color: rgba(255, 106, 42, 0.22);
	}

	.release-radar-sweep {
		background: conic-gradient(from 30deg, transparent 0deg, rgba(24, 214, 178, 0.22) 34deg, transparent 68deg);
		mask-image: radial-gradient(circle, transparent 0 17%, #000 18% 100%);
		animation: release-sweep 10s linear infinite;
	}

	.release-radar-core {
		position: relative;
		z-index: 2;
		display: grid;
		width: 5.8rem;
		aspect-ratio: 1;
		place-items: center;
		border: 1px solid rgba(255, 106, 42, 0.34);
		border-radius: 1.65rem;
		background: linear-gradient(145deg, rgba(255, 106, 42, 0.18), rgba(24, 214, 178, 0.09));
		color: #ff9b5e;
		box-shadow: 0 0 46px rgba(255, 106, 42, 0.2);
	}

	.release-layer {
		position: absolute;
		z-index: 3;
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		border: 1px solid rgba(255, 255, 255, 0.13);
		border-radius: 9999px;
		background: rgba(5, 7, 10, 0.64);
		color: rgba(245, 247, 248, 0.78);
		font-family: 'JetBrains Mono', ui-monospace, monospace;
		font-size: 0.68rem;
		font-weight: 700;
		padding: 0.48rem 0.7rem;
		text-transform: uppercase;
		backdrop-filter: blur(16px);
	}

	.release-layer--1 {
		left: 9%;
		top: 25%;
	}

	.release-layer--2 {
		right: 4%;
		top: 44%;
	}

	.release-layer--3 {
		left: 23%;
		bottom: 16%;
	}

	.release-layer-dot {
		width: 0.44rem;
		aspect-ratio: 1;
		border-radius: 9999px;
		background: #18d6b2;
		box-shadow: 0 0 16px rgba(24, 214, 178, 0.8);
	}

	.release-panel {
		position: absolute;
		right: 0;
		bottom: 2.2rem;
		z-index: 4;
		width: min(24rem, 82%);
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 1.35rem;
		background: rgba(8, 24, 39, 0.82);
		box-shadow: 0 26px 90px rgba(0, 0, 0, 0.32);
		padding: 1rem;
		backdrop-filter: blur(22px) saturate(150%);
	}

	.release-panel-head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.3rem 0.35rem 0.9rem;
	}

	.release-panel-head p {
		color: #f5f7f8;
		font-weight: 800;
	}

	.release-panel-head span {
		color: rgba(245, 247, 248, 0.54);
		font-size: 0.8rem;
	}

	.release-panel-head strong {
		color: #b8ff6a;
		font-family: 'JetBrains Mono', ui-monospace, monospace;
		font-size: 1.35rem;
	}

	.release-signal-list {
		display: grid;
		gap: 0.55rem;
	}

	.release-signal {
		display: grid;
		grid-template-columns: auto 1fr;
		align-items: center;
		gap: 0.7rem;
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 0.9rem;
		background: rgba(255, 255, 255, 0.045);
		color: #18d6b2;
		padding: 0.7rem;
	}

	.release-signal p {
		color: #f5f7f8;
		font-size: 0.84rem;
		font-weight: 750;
	}

	.release-signal span {
		display: block;
		margin-top: 0.08rem;
		color: rgba(245, 247, 248, 0.5);
		font-size: 0.76rem;
	}

	.release-signal--watch {
		color: #ffb26f;
	}

	.release-signal--review {
		color: #f6c057;
	}

	.hero-command-stats {
		position: absolute;
		left: 0;
		bottom: 0.4rem;
		z-index: 5;
		display: grid;
		width: min(23rem, 78%);
		grid-template-columns: repeat(3, minmax(0, 1fr));
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 1.1rem;
		background: rgba(5, 7, 10, 0.72);
		backdrop-filter: blur(18px);
	}

	.hero-command-stats div {
		padding: 0.85rem;
	}

	.hero-command-stats div + div {
		border-left: 1px solid rgba(255, 255, 255, 0.09);
	}

	.hero-command-stats strong,
	.hero-command-stats span {
		display: block;
	}

	.hero-command-stats strong {
		color: #f5f7f8;
		font-size: 1.1rem;
		font-weight: 800;
	}

	.hero-command-stats span {
		margin-top: 0.2rem;
		color: rgba(245, 247, 248, 0.48);
		font-size: 0.69rem;
		font-weight: 700;
		line-height: 1.25;
		text-transform: uppercase;
	}

	@keyframes release-sweep {
		to {
			transform: rotate(360deg);
		}
	}

	@keyframes release-beam {
		from {
			transform: translate3d(0, 0, 0) rotate(-18deg);
		}

		to {
			transform: translate3d(5%, 1.5rem, 0) rotate(-18deg);
		}
	}

	@media (max-width: 1024px) {
		.hero-command {
			min-height: auto;
		}

		.hero-command-visual {
			min-height: 34rem;
		}

		.release-radar {
			margin-inline: auto;
		}
	}

	@media (max-width: 640px) {
		.hero-command {
			padding-block: 3.4rem 4rem;
		}

		.hero-command-badge {
			font-size: 0.68rem;
			line-height: 1.45;
			white-space: normal;
		}

		.hero-command-actions {
			align-items: stretch;
			flex-direction: column;
		}

		.hero-command-actions :global(a) {
			width: 100%;
		}

		.hero-command-visual {
			display: grid;
			gap: 0.75rem;
			min-height: auto;
			margin-top: 0.5rem;
		}

		.release-radar {
			width: min(100%, 22rem);
		}

		.release-panel {
			position: relative;
			left: auto;
			right: auto;
			bottom: auto;
			width: 100%;
			transform: none;
		}

		.hero-command-stats {
			position: relative;
			left: auto;
			bottom: auto;
			width: 100%;
			transform: none;
		}

		.release-layer {
			font-size: 0.6rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-command-beam,
		.release-radar-sweep {
			animation: none;
		}
	}
</style>
