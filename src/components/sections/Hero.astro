---
import ArrowRight from 'lucide-astro/ArrowRight';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import { copy, routeMap, type Lang } from '../../lib/i18n';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const t = copy[lang].hero;
const squareSize = 13;
const squareStep = 19;
const gridCols = 64;
const gridRows = 41;
const gridOffset = 3;
const gridCells = Array.from({ length: gridCols * gridRows }, (_, index) => {
	const cols = gridCols;
	return {
		x: gridOffset + (index % cols) * squareStep,
		y: gridOffset + Math.floor(index / cols) * squareStep,
	};
});
---

<section
	class="hero-shell hero-shell--home relative isolate overflow-hidden"
	data-hero-grid-scene
>
	<!-- ── Background layers ── -->
	<div class="absolute inset-0 -z-20 hero-bg-solid" aria-hidden="true"></div>

	<!-- Radial glows -->
	<div class="absolute -z-10 hero-glow-orange" aria-hidden="true"></div>
	<div class="absolute -z-10 hero-glow-blue" aria-hidden="true"></div>

	<!-- Animated grid of squares -->
	<svg
		class="hero-square-grid absolute inset-0 -z-10 h-full w-full"
		viewBox="0 0 1200 760"
		preserveAspectRatio="none"
		aria-hidden="true"
	>
		<defs>
			<radialGradient id="hero-square-bulge" cx="38%" cy="30%" r="78%">
				<stop offset="0%" stop-color="#fff2d6" stop-opacity="0.95" />
				<stop offset="42%" stop-color="#f39c12" stop-opacity="0.72" />
				<stop offset="100%" stop-color="#0f1f44" stop-opacity="0.38" />
			</radialGradient>
			<filter id="hero-square-shadow" x="-130%" y="-130%" width="360%" height="360%">
				<feDropShadow dx="0" dy="5" stdDeviation="4" flood-color="#e67e22" flood-opacity="0.13" />
				<feDropShadow dx="-1" dy="-1" stdDeviation="2" flood-color="#ffffff" flood-opacity="0.12" />
			</filter>
		</defs>
		{gridCells.map(({ x, y }) => (
			<rect
				class="hero-square"
				x={x}
				y={y}
				width={squareSize}
				height={squareSize}
				rx="2"
				data-cx={x + squareSize / 2}
				data-cy={y + squareSize / 2}
			/>
		))}
	</svg>

	<!-- Diagonal accent line -->
	<div class="hero-diag-line absolute inset-y-0 right-[20%] w-px -skew-x-12 opacity-20 -z-10" aria-hidden="true"></div>
	<div class="hero-diag-line absolute inset-y-0 right-[38%] w-px -skew-x-12 opacity-10 -z-10" aria-hidden="true"></div>

	<Container class="relative z-10 flex flex-col items-center text-center">
		<!-- Animated badge -->
		<div class="hero-badge-wrap" data-animate="fade-down">
			<Badge class="hero-badge-pill">{t.badge}</Badge>
		</div>

		<!-- Main headline — two lines, dramatic scale -->
		<div class="hero-title-wrap max-w-5xl scroll-float" data-scroll-depth="-18">
			<h1 class="hero-heading text-[clamp(2.6rem,8vw,6rem)] font-extrabold leading-[1.0] tracking-[-0.025em]">
				<span class="hero-title-line-1 block">{t.title}</span>
				<span class="hero-heading-accent block mt-1">{t.accent}</span>
			</h1>
		</div>

		<!-- Subtitle -->
		<p class="hero-subtitle max-w-2xl text-[clamp(1rem,2vw,1.2rem)] leading-[1.75]">
			{t.subtitle}
		</p>

		<!-- CTAs -->
		<div class="hero-actions flex flex-col gap-3 sm:flex-row" role="group" aria-label={lang === 'fr' ? 'Actions principales' : 'Primary actions'}>
			<Button href={routeMap.quote} lang={lang}>
				{t.primary}
				<ArrowRight class="size-4" aria-hidden="true" />
			</Button>
			<Button href={routeMap.services} lang={lang} variant="secondary">
				{t.secondary}
			</Button>
		</div>

		<!-- Trust line -->
		<p class="hero-trust max-w-3xl rounded-full px-5 py-3 text-sm font-semibold">
			<span aria-label="5 étoiles">★★★★★</span>
			<span class="ml-1">{t.trust}</span>
		</p>

		<!-- Scroll indicator -->
		<div class="hero-scroll-hint absolute bottom-8 left-1/2 -translate-x-1/2" aria-hidden="true">
			<div class="hero-scroll-dot"></div>
		</div>
	</Container>
</section>

<style>
	/* ── Hero always has dark background regardless of theme ── */
	.hero-shell {
		display: flex;
		min-height: calc(100svh - 4.5rem);
		align-items: center;
		padding-block: clamp(3rem, 7vh, 5rem);
	}

	.hero-bg-solid {
		background: linear-gradient(135deg, #050b1a 0%, #0a1530 52%, #0f1f44 100%);
	}

	.hero-glow-orange {
		left: 5%;
		top: 10%;
		width: min(38rem, 50vw);
		height: min(24rem, 40vw);
		border-radius: 45%;
		background: radial-gradient(circle, rgba(230, 126, 34, 0.22), rgba(230, 126, 34, 0.04) 55%, transparent 72%);
		filter: blur(24px);
		animation: drift-glow 13s ease-in-out infinite alternate;
	}

	.hero-glow-blue {
		right: 8%;
		top: 5%;
		width: min(30rem, 40vw);
		height: min(20rem, 32vw);
		border-radius: 40%;
		background: radial-gradient(circle, rgba(42, 66, 117, 0.55), rgba(42, 66, 117, 0.08) 55%, transparent 72%);
		filter: blur(28px);
		animation: drift-glow 17s ease-in-out infinite alternate-reverse;
	}

	.hero-diag-line {
		background: linear-gradient(
			to bottom,
			transparent 0%,
			rgba(230, 126, 34, 0.35) 30%,
			rgba(230, 126, 34, 0.35) 70%,
			transparent 100%
		);
	}

	/* Typography — always on dark bg */
	.hero-heading {
		color: #ffffff;
		text-shadow: 0 16px 48px rgba(0, 0, 0, 0.3);
	}

	.hero-title-wrap {
		margin-top: clamp(1rem, 3vh, 2rem);
	}

	.hero-heading-accent {
		background: linear-gradient(92deg, #f39c12 0%, #f6c057 55%, #e67e22 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.hero-subtitle {
		margin-top: clamp(1rem, 2.5vh, 1.75rem);
		color: rgba(255, 255, 255, 0.78);
	}

	.hero-actions {
		margin-top: clamp(1.4rem, 4vh, 2.5rem);
	}

	.hero-trust {
		margin-top: clamp(1.3rem, 4vh, 2.5rem);
		border: 1px solid rgba(255, 255, 255, 0.14);
		background: rgba(255, 255, 255, 0.07);
		color: rgba(255, 255, 255, 0.82);
		backdrop-filter: blur(8px);
	}

	/* Badge pill */
	.hero-badge-pill {
		border-color: rgba(243, 156, 18, 0.35);
		background: rgba(243, 156, 18, 0.1);
		color: #f6b93b;
		animation: badge-in 0.55s cubic-bezier(0.2, 0.8, 0.2, 1) both;
	}

	/* Grid */
	.hero-square-grid {
		pointer-events: auto;
		opacity: 0.44;
	}

	.hero-square-grid .hero-square {
		fill: rgba(255, 255, 255, 0.012);
		stroke: rgba(255, 255, 255, 0.15);
		stroke-width: 0.72;
		pointer-events: none;
		transform-box: fill-box;
		transform-origin: center;
		transition: none;
		opacity: 0.52;
		will-change: transform, opacity, filter;
	}

	.hero-square-grid .hero-square:nth-child(3n) {
		opacity: 0.38;
	}

	.hero-square-grid .hero-square:nth-child(5n) {
		stroke: rgba(230, 126, 34, 0.12);
	}

	/* Scroll hint dot */
	.hero-scroll-hint {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.35rem;
		opacity: 0.45;
	}

	.hero-scroll-dot {
		width: 6px;
		height: 6px;
		border-radius: 9999px;
		background: rgba(243, 156, 18, 0.8);
		animation: scroll-bounce 2s ease-in-out infinite;
	}

	@keyframes drift-glow {
		from {
			transform: translate3d(-3%, 0, 0) rotate(-8deg) scale(0.96);
			opacity: 0.55;
		}
		to {
			transform: translate3d(18%, 12%, 0) rotate(4deg) scale(1.08);
			opacity: 0.82;
		}
	}

	@keyframes badge-in {
		from {
			opacity: 0;
			transform: translateY(-10px) scale(0.94);
		}
		to {
			opacity: 1;
			transform: translateY(0) scale(1);
		}
	}

	@keyframes scroll-bounce {
		0%, 100% { transform: translateY(0); opacity: 0.45; }
		50% { transform: translateY(6px); opacity: 0.7; }
	}

	@media (max-height: 760px) and (min-width: 768px) {
		.hero-shell {
			min-height: calc(100svh - 4rem);
			padding-block: 2rem;
		}

		.hero-heading {
			font-size: clamp(2.55rem, 6.8vw, 4.85rem);
		}

		.hero-title-wrap {
			margin-top: 1rem;
		}

		.hero-subtitle {
			margin-top: 0.9rem;
			line-height: 1.55;
		}

		.hero-actions,
		.hero-trust {
			margin-top: 1.15rem;
		}

		.hero-scroll-hint {
			display: none;
		}
	}

	@media (max-width: 640px) {
		.hero-shell {
			min-height: auto;
			padding-block: 4rem 4.5rem;
		}

		.hero-heading {
			text-wrap: balance;
		}

		.hero-trust {
			border-radius: 1.25rem;
		}

		.hero-scroll-hint {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-glow-orange,
		.hero-glow-blue,
		.hero-badge-pill,
		.hero-scroll-dot {
			animation: none;
		}
	}
</style>

<script is:inline>
	const scene = document.querySelector('[data-hero-grid-scene]');
	const svg = scene?.querySelector('.hero-square-grid');
	const squares = svg
		? [...svg.querySelectorAll('.hero-square')].map((square) => ({
				el: square,
				cx: Number(square.dataset.cx),
				cy: Number(square.dataset.cy),
			}))
		: [];
	let frame = 0;
	let pointer = null;
	let activeSquares = new Set();

	const resetSquare = (square) => {
		square.style.transform = '';
		square.style.opacity = '';
		square.style.fill = '';
		square.style.stroke = '';
		square.style.filter = '';
		square.style.strokeWidth = '';
	};

	const resetSquares = (items = activeSquares) => {
		for (const square of items) resetSquare(square);
		activeSquares.clear();
	};

	const animateSquares = () => {
		frame = 0;
		if (!pointer || !svg) return;
		const point = svg.createSVGPoint();
		point.x = pointer.x;
		point.y = pointer.y;
		const local = point.matrixTransform(svg.getScreenCTM().inverse());
		const radius = 72;
		const nextActive = new Set();

		for (const { el: square, cx, cy } of squares) {
			const dx = cx - local.x;
			const dy = cy - local.y;
			const distance = Math.hypot(dx, dy);
			const strength = Math.max(0, 1 - distance / radius);
			if (strength <= 0) continue;
			nextActive.add(square);
			const eased = 1 - Math.pow(1 - strength, 2);
			const directionX = distance ? dx / distance : 0;
			const directionY = distance ? dy / distance : -1;
			const push = eased * 2.2;
			const scale = 1 + eased * 0.5;
			const lift = -eased * 1.1;
			square.style.transform = `translate(${directionX * push}px, ${directionY * push + lift}px) scale(${scale})`;
			square.style.opacity = String(0.48 + eased * 0.3);
			square.style.fill = `rgba(255,255,255, ${0.012 + eased * 0.024})`;
			square.style.stroke = `rgba(243,156,18, ${0.08 + eased * 0.14})`;
			square.style.filter = eased > 0.24 ? 'url(#hero-square-shadow)' : '';
			square.style.strokeWidth = String(0.72 + eased * 0.58);
		}

		for (const square of activeSquares) {
			if (!nextActive.has(square)) resetSquare(square);
		}
		activeSquares = nextActive;
	};

	const schedule = (event) => {
		pointer = { x: event.clientX, y: event.clientY };
		if (!frame) frame = requestAnimationFrame(animateSquares);
	};

	if (scene && svg && squares.length && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
		scene.addEventListener('pointermove', schedule, { passive: true });
		scene.addEventListener('pointerleave', () => {
			pointer = null;
			if (frame) cancelAnimationFrame(frame);
			frame = 0;
			resetSquares();
		});
	}
</script>
