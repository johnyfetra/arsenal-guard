---
import ArrowRight from 'lucide-astro/ArrowRight';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import { copy, routeMap, type Lang } from '../../lib/i18n';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const t = copy[lang].hero;
---

<section class="relative isolate overflow-hidden bg-mesh py-24 md:min-h-[calc(100vh-4rem)] md:py-32">
	<div class="absolute inset-0 -z-10 opacity-30" aria-hidden="true">
		<div class="absolute left-8 top-24 h-48 w-px rotate-12 bg-orange-400/40"></div>
		<div class="absolute right-10 top-32 grid grid-cols-6 gap-2">
			{Array.from({ length: 48 }).map(() => <span class="size-1 rounded-full bg-white/20"></span>)}
		</div>
	</div>
	<Container class="flex flex-col items-center text-center">
		<Badge>{t.badge}</Badge>
		<h1 class="mt-8 max-w-5xl text-5xl font-extrabold leading-[1.02] tracking-normal text-white md:text-7xl">
			{t.title}<br /><span class="text-orange-400">{t.accent}</span>
		</h1>
		<p class="mt-6 max-w-3xl text-lg leading-8 text-white/76 md:text-xl">{t.subtitle}</p>
		<div class="mt-10 flex flex-col gap-3 sm:flex-row">
			<Button href={routeMap.quote} lang={lang}>{t.primary}<ArrowRight class="size-4" /></Button>
			<Button href={routeMap.services} lang={lang} variant="secondary">{t.secondary}</Button>
		</div>
		<p class="mt-10 max-w-3xl rounded-full border border-white/10 bg-white/5 px-5 py-3 text-sm font-semibold text-white/82">★★★★★ {t.trust}</p>
	</Container>
</section>
