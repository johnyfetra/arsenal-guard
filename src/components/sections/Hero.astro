---
import ArrowRight from 'lucide-astro/ArrowRight';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import { copy, routeMap, type Lang } from '../../lib/i18n';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const t = copy[lang].hero;
const squareSize = 13;
const squareStep = 19;
const gridCols = 64;
const gridRows = 41;
const gridOffset = 3;
const gridCells = Array.from({ length: gridCols * gridRows }, (_, index) => {
	const cols = gridCols;
	return {
		x: gridOffset + (index % cols) * squareStep,
		y: gridOffset + Math.floor(index / cols) * squareStep,
	};
});
---

<section class="hero-shell relative isolate overflow-hidden py-24 md:min-h-[calc(100vh-4rem)] md:py-32" data-hero-grid-scene>
	<div class="absolute inset-0 -z-10 opacity-30" aria-hidden="true">
		<div class="hero-glow"></div>
		<div class="hero-line absolute left-8 top-24 h-48 w-px rotate-12"></div>
	</div>
	<svg class="hero-square-grid absolute inset-0 z-0 h-full w-full" viewBox="0 0 1200 760" preserveAspectRatio="none" aria-hidden="true">
		<defs>
			<radialGradient id="hero-square-bulge" cx="38%" cy="30%" r="78%">
				<stop offset="0%" stop-color="#fff2d6" stop-opacity="0.95" />
				<stop offset="42%" stop-color="#f39c12" stop-opacity="0.72" />
				<stop offset="100%" stop-color="#0f1f44" stop-opacity="0.38" />
			</radialGradient>
			<filter id="hero-square-shadow" x="-130%" y="-130%" width="360%" height="360%">
				<feDropShadow dx="0" dy="5" stdDeviation="4" flood-color="#e67e22" flood-opacity="0.13" />
				<feDropShadow dx="-1" dy="-1" stdDeviation="2" flood-color="#ffffff" flood-opacity="0.12" />
			</filter>
		</defs>
		{gridCells.map(({ x, y }) => <rect class="hero-square" x={x} y={y} width={squareSize} height={squareSize} rx="2" data-cx={x + squareSize / 2} data-cy={y + squareSize / 2} />)}
	</svg>
	<Container class="relative z-10 flex flex-col items-center text-center">
		<Badge>{t.badge}</Badge>
		<div class="hero-title-wrap scroll-float relative z-10 mt-8 max-w-5xl" data-scroll-depth="-26">
			<h1 class="hero-heading text-5xl font-extrabold leading-[1.02] tracking-normal md:text-7xl">
				<span class="hero-title-lines">{t.title}</span><br /><span class="hero-title-lines hero-heading-accent">{t.accent}</span>
			</h1>
		</div>
		<p class="hero-subtitle mt-6 max-w-3xl text-lg leading-8 md:text-xl">{t.subtitle}</p>
		<div class="mt-10 flex flex-col gap-3 sm:flex-row">
			<Button href={routeMap.quote} lang={lang}>{t.primary}<ArrowRight class="size-4" /></Button>
			<Button href={routeMap.services} lang={lang} variant="secondary">{t.secondary}</Button>
		</div>
		<p class="hero-trust mt-10 max-w-3xl rounded-full px-5 py-3 text-sm font-semibold">★★★★★ {t.trust}</p>
	</Container>
</section>

<script is:inline>
	const scene = document.querySelector('[data-hero-grid-scene]');
	const svg = scene?.querySelector('.hero-square-grid');
	const squares = svg
		? [...svg.querySelectorAll('.hero-square')].map((square) => ({
				el: square,
				cx: Number(square.dataset.cx),
				cy: Number(square.dataset.cy),
			}))
		: [];
	let frame = 0;
	let pointer = null;
	let activeSquares = new Set();

	const resetSquare = (square) => {
		square.style.transform = '';
		square.style.opacity = '';
		square.style.fill = '';
		square.style.stroke = '';
		square.style.filter = '';
		square.style.strokeWidth = '';
	};

	const resetSquares = (items = activeSquares) => {
		for (const square of items) {
			square.style.transform = '';
			square.style.opacity = '';
			square.style.fill = '';
			square.style.stroke = '';
			square.style.filter = '';
			square.style.strokeWidth = '';
		}
		activeSquares.clear();
	};

	const animateSquares = () => {
		frame = 0;
		if (!pointer || !svg) return;

		const point = svg.createSVGPoint();
		point.x = pointer.x;
		point.y = pointer.y;
		const local = point.matrixTransform(svg.getScreenCTM().inverse());
		const radius = 72;
		const nextActive = new Set();

		for (const { el: square, cx, cy } of squares) {
			const dx = cx - local.x;
			const dy = cy - local.y;
			const distance = Math.hypot(dx, dy);
			const strength = Math.max(0, 1 - distance / radius);

			if (strength <= 0) {
				continue;
			}

			nextActive.add(square);
			const eased = 1 - Math.pow(1 - strength, 2);
			const directionX = distance ? dx / distance : 0;
			const directionY = distance ? dy / distance : -1;
			const push = eased * 2.2;
			const scale = 1 + eased * 0.5;
			const lift = -eased * 1.1;
			const translateX = directionX * push;
			const translateY = directionY * push + lift;
			square.style.transform = `translate(${translateX}px, ${translateY}px) scale(${scale})`;
			square.style.opacity = String(0.48 + eased * 0.3);
			square.style.fill = `rgba(var(--hero-square-hover-fill), ${0.012 + eased * 0.024})`;
			square.style.stroke = `rgba(var(--hero-square-hover-stroke), ${0.08 + eased * 0.14})`;
			square.style.filter = eased > 0.24 ? 'url(#hero-square-shadow)' : '';
			square.style.strokeWidth = String(0.72 + eased * 0.58);
		}

		for (const square of activeSquares) {
			if (!nextActive.has(square)) resetSquare(square);
		}
		activeSquares = nextActive;
	};

	const schedule = (event) => {
		pointer = { x: event.clientX, y: event.clientY };
		if (!frame) frame = requestAnimationFrame(animateSquares);
	};

	if (scene && svg && squares.length && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
		scene.addEventListener('pointermove', schedule, { passive: true });
		scene.addEventListener('pointerleave', () => {
			pointer = null;
			if (frame) cancelAnimationFrame(frame);
			frame = 0;
			resetSquares();
		});
	}
</script>
