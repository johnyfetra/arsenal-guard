---
import type { CollectionEntry } from 'astro:content';
import Layout from '../layout/Layout.astro';
import Container from '../ui/Container.astro';
import Card from '../ui/Card.astro';
import Button from '../ui/Button.astro';
import Hero from './Hero.astro';
import ValueProps from './ValueProps.astro';
import HowItWorks from './HowItWorks.astro';
import Stack from './Stack.astro';
import ServicesPreview from './ServicesPreview.astro';
import FAQ from './FAQ.astro';
import CTASection from './CTASection.astro';
import LogoCloud from './LogoCloud.astro';
import Testimonials from './Testimonials.astro';
import QuoteForm from '../forms/QuoteForm.astro';
import ContactForm from '../forms/ContactForm.astro';
import { copy, getPageTitle, routeMap, type Lang } from '../../lib/i18n';
import { dedicated, localizedServiceIntro, plans, punctualOffers, services, site } from '../../lib/site';

interface Props {
	lang: Lang;
	path: string;
	page: 'home' | 'services' | 'service' | 'about' | 'cases' | 'blog' | 'quote' | 'contact' | 'legal' | 'privacy' | 'notFound';
	serviceId?: string;
	posts?: CollectionEntry<'blog'>[];
}

const { lang, path, page, serviceId, posts = [] } = Astro.props;
const t = copy[lang];
const service = services.find((item) => item.id === serviceId);
const schemaBase = { '@context': 'https://schema.org' };
const baseDescription = t.descriptions[page === 'notFound' ? 'home' : page === 'service' ? 'services' : page];
const title = page === 'service' && service ? service.title : page === 'notFound' ? 'Page introuvable' : getPageTitle(lang, page === 'cases' ? 'cases' : page);
---

<Layout
	lang={lang}
	path={path}
	title={title}
	description={baseDescription}
	schema={[
		{ ...schemaBase, '@type': 'Organization', name: site.name, url: site.url, founder: site.founder },
		page === 'home' ? { ...schemaBase, '@type': 'ProfessionalService', name: site.name, areaServed: 'Europe', serviceType: 'QA automation and software testing' } : {},
		page === 'service' && service ? { ...schemaBase, '@type': 'Service', name: service.title, provider: { '@type': 'Organization', name: site.name }, offers: { '@type': 'Offer', price: service.price } } : {},
	]}
>
	{page === 'home' && (
		<>
			<Hero lang={lang} />
			<LogoCloud />
			<ValueProps lang={lang} />
			<HowItWorks lang={lang} />
			<Stack lang={lang} />
			<ServicesPreview lang={lang} mode="pricing" />
			<Testimonials />
			<FAQ lang={lang} />
			<CTASection lang={lang} />
		</>
	)}

	{page === 'services' && (
		<>
			<section class="bg-mesh py-24 md:py-32">
				<Container>
					<h1 class="max-w-4xl text-5xl font-extrabold text-white md:text-7xl">{t.nav.services}</h1>
					<p class="mt-6 max-w-3xl text-lg text-white/80">{localizedServiceIntro[lang]}</p>
				</Container>
			</section>
			<section class="py-24">
				<Container class="grid gap-5 md:grid-cols-2">
					{services.map((item) => (
						<Card>
							<p class="text-sm font-bold uppercase tracking-[0.14em] text-orange-400">{item.kicker}</p>
							<h2 class="mt-4 text-3xl font-extrabold">{item.title}</h2>
							<p class="mt-3 text-muted">{item.description}</p>
							<p class="mt-5 font-mono text-orange-400">{item.duration} · {item.price}</p>
							<Button class="mt-6" href={`services/${item.id}`} lang={lang} variant="secondary">Voir le service</Button>
						</Card>
					))}
				</Container>
			</section>
			<section class="section-band border-y py-24">
				<Container class="grid gap-8 lg:grid-cols-3">
					<div><h2 class="text-3xl font-extrabold">Ponctuel</h2>{punctualOffers.map(([name, duration, price]) => <p class="mt-4 text-muted">{name} · {duration} · <strong>{price}</strong></p>)}</div>
					<div><h2 class="text-3xl font-extrabold">Mensuel</h2>{plans.map((plan) => <p class="mt-4 text-muted">{plan.name} · {plan.volume} · <strong>{plan.price}</strong></p>)}</div>
					<div><h2 class="text-3xl font-extrabold">Dedie</h2>{dedicated.map(([name, volume, price]) => <p class="mt-4 text-muted">{name} · {volume} · <strong>{price}</strong></p>)}</div>
				</Container>
			</section>
			<CTASection lang={lang} />
		</>
	)}

	{page === 'service' && service && (
		<>
			<section class="bg-mesh py-24 md:py-32">
				<Container>
					<p class="font-bold uppercase tracking-[0.16em] text-orange-400">{service.kicker}</p>
					<h1 class="mt-5 max-w-4xl text-5xl font-extrabold text-white md:text-7xl">{service.title}</h1>
					<p class="mt-6 max-w-3xl text-lg text-white/80">{service.description}</p>
					<p class="mt-8 font-mono text-xl text-orange-400">{service.duration} · {service.price}</p>
				</Container>
			</section>
			<section class="py-24">
				<Container class="grid gap-6 lg:grid-cols-3">
					<Card><h2 class="text-2xl font-extrabold">Ce que vous obtenez</h2><ul class="mt-5 space-y-3 text-muted">{service.deliverables.map((item) => <li>{item}</li>)}</ul></Card>
					<Card><h2 class="text-2xl font-extrabold">Comment ca marche</h2><ul class="mt-5 space-y-3 text-muted">{service.process.map((item) => <li>{item}</li>)}</ul></Card>
					<Card><h2 class="text-2xl font-extrabold">Pour qui</h2><p class="mt-5 text-muted">{service.for}</p><Button class="mt-6" href={routeMap.quote} lang={lang}>Demander un devis</Button></Card>
				</Container>
			</section>
			<FAQ lang={lang} items={service.faq} />
			<CTASection lang={lang} />
		</>
	)}

	{page === 'about' && (
		<>
			<section class="bg-mesh py-24 md:py-32">
				<Container class="grid gap-10 lg:grid-cols-[1fr_.75fr] lg:items-center">
					<div><h1 class="text-5xl font-extrabold text-white md:text-7xl">Johny Fetramalala</h1><p class="mt-6 text-xl text-white/80">Senior QA Engineer, fondateur d Arsenal Guard. 5+ ans sur SaaS, e-commerce et plateformes web europeennes.</p></div>
					<div class="aspect-square rounded-2xl border border-orange-400/30 bg-[linear-gradient(135deg,#0F1F44,#E67E22)] p-8 shadow-glow"><div class="grid h-full place-items-center rounded-xl border border-white/20 text-6xl font-extrabold text-white">JF</div></div>
				</Container>
			</section>
			<section class="py-24"><Container class="grid gap-8 lg:grid-cols-[.8fr_1.2fr]"><h2 class="text-3xl font-extrabold md:text-5xl">De developpeur a expert qualite</h2><div class="space-y-5 text-lg text-muted"><p>Arsenal Guard nait d une conviction simple: la qualite ne doit pas etre un frein a la livraison. Elle doit devenir un filet clair, maintenable et utile aux equipes produit.</p><p>Johny accompagne des equipes francophones et europeennes sur l automatisation E2E, la stabilisation de suites existantes, l integration CI/CD et la priorisation des risques.</p><p>Depuis Antananarivo, l avantage offshore est concret: cout optimise, communication francophone, recouvrement horaire Europe et exigence senior.</p></div></Container></section>
			<section class="section-band border-y py-24"><Container><h2 class="text-3xl font-extrabold">Valeurs</h2><div class="mt-8 grid gap-5 md:grid-cols-4">{['Quality', 'Transparency', 'Evolution', 'Reliability'].map((value) => <Card><h3 class="text-xl font-bold">{value}</h3><p class="mt-3 text-muted">Des decisions visibles, mesurables et utiles a votre equipe.</p></Card>)}</div></Container></section>
			<Stack lang={lang} /><CTASection lang={lang} />
		</>
	)}

	{page === 'cases' && <section class="py-24 md:py-32"><Container><h1 class="text-5xl font-extrabold md:text-7xl">Realisations</h1><div class="mt-10 grid gap-5 md:grid-cols-3">{['Audit SaaS', 'Stabilisation E2E', 'Pipeline qualite'].map((item) => <Card><h2 class="text-2xl font-bold">{item}</h2><p class="mt-3 text-muted">Coming soon — publication apres validation client.</p></Card>)}</div></Container></section>}

	{page === 'blog' && <section class="py-24 md:py-32"><Container><h1 class="text-5xl font-extrabold md:text-7xl">Blog</h1><div class="mt-10 grid gap-5 md:grid-cols-3">{posts.map((post) => <Card><p class="text-sm text-orange-400">{post.data.readTime}</p><h2 class="mt-4 text-2xl font-bold">{post.data.title}</h2><p class="mt-3 text-muted">{post.data.description}</p><Button class="mt-6" href={`blog/${post.slug.replace(/^\d+-/, '')}`} lang={lang} variant="secondary">Lire</Button></Card>)}</div></Container></section>}

	{page === 'quote' && <section class="py-24 md:py-32"><Container class="grid gap-10 lg:grid-cols-[.8fr_1.2fr]"><div><h1 class="text-5xl font-extrabold md:text-7xl">Demander un devis</h1><p class="mt-6 text-lg text-muted">{t.descriptions.quote}</p></div><QuoteForm /></Container></section>}

	{page === 'contact' && <section class="py-24 md:py-32"><Container class="grid gap-10 lg:grid-cols-[.8fr_1.2fr]"><div><h1 class="text-5xl font-extrabold md:text-7xl">Contact</h1><p class="mt-6 text-lg text-muted">{t.descriptions.contact}</p><p class="mt-6 font-mono text-orange-400">{site.email}</p><div class="surface mt-8 rounded-2xl p-6 text-muted">Calendly placeholder: ajoutez votre lien de prise de rendez-vous.</div></div><ContactForm /></Container></section>}

	{(page === 'legal' || page === 'privacy') && <section class="py-24 md:py-32"><Container class="max-w-3xl"><h1 class="text-5xl font-extrabold">{page === 'legal' ? 'Mentions legales' : 'Politique de confidentialite'}</h1><div class="prose-ag mt-8"><p>Editeur: Arsenal Guard, service freelance QA represente par Johny Fetramalala, Antananarivo, Madagascar.</p><p>Contact: {site.email}. Les donnees transmises via les formulaires sont utilisees uniquement pour repondre aux demandes commerciales. Vous pouvez demander leur suppression a tout moment.</p><p>Hebergement recommande: Vercel ou Cloudflare Pages. Analytics prevu: Cloudflare Web Analytics ou Plausible, sans cookies publicitaires.</p></div></Container></section>}

	{page === 'notFound' && <section class="grid min-h-[70vh] place-items-center py-24"><Container class="text-center"><h1 class="text-6xl font-extrabold">404</h1><p class="mt-4 text-muted">Cette page n existe pas encore.</p><Button class="mt-8" href="/" lang={lang}>Retour accueil</Button></Container></section>}
</Layout>
