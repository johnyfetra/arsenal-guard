---
import type { CollectionEntry } from 'astro:content';
import Layout from '../layout/Layout.astro';
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import Hero from './Hero.astro';
import CommandPageHero from './CommandPageHero.astro';
import ReleaseProblems from './ReleaseProblems.astro';
import HowItWorks from './HowItWorks.astro';
import Stack from './Stack.astro';
import FAQ from './FAQ.astro';
import CTASection from './CTASection.astro';
import LogoCloud from './LogoCloud.astro';
import TierPricingTable from './TierPricingTable.astro';
import SnapshotTeaser from './SnapshotTeaser.astro';
import Check from 'lucide-astro/Check';
import Users from 'lucide-astro/Users';
import QuoteForm from '../forms/QuoteForm.astro';
import ContactForm from '../forms/ContactForm.astro';
import johnyPortrait from '../../assets/images/johny-fetramalala.jpg';
import { copy, getPageTitle, routeMap, type Lang } from '../../lib/i18n';
import { dedicated, localizedServiceIntro, plans, punctualOffers, services, site } from '../../lib/site';
import type { PunctualRow } from '../../lib/site';

interface Props {
	lang: Lang;
	path: string;
	page: 'home' | 'services' | 'service' | 'about' | 'cases' | 'blog' | 'quote' | 'contact' | 'legal' | 'privacy' | 'notFound';
	serviceId?: string;
	posts?: CollectionEntry<'blog'>[];
}

const { lang, path, page, serviceId, posts = [] } = Astro.props;
const t = copy[lang];
const service = services.find((item) => item.id === serviceId);
const schemaBase = { '@context': 'https://schema.org' };
const baseDescription = t.descriptions[page === 'notFound' ? 'home' : page === 'service' ? 'services' : page];
const title = page === 'service' && service ? service.title : page === 'notFound' ? (lang === 'fr' ? 'Page introuvable' : 'Page not found') : getPageTitle(lang, page === 'cases' ? 'cases' : page);
const ui = lang === 'fr'
	? {
		serviceButton: 'Voir le service',
		punctual: 'Ponctuel',
		monthly: 'Mensuel',
		dedicated: 'Dédié',
		deliverables: 'Ce que vous obtenez',
		process: 'Comment ça marche',
		forWhom: 'Pour qui',
		aboutKicker: 'Service QA premium',
		aboutTitle: "À propos d'Arsenal Guard",
		aboutLead: 'Service QA premium pour produits SaaS, e-commerce et plateformes web européens.',
		missionTitle: 'Notre mission',
		missionTexts: [
			"Arsenal Guard est né d'une conviction : la qualité logicielle ne doit pas être un frein à la livraison. Elle doit devenir un filet clair, maintenable et utile aux équipes produit.",
			"Nous accompagnons des startups et scale-ups européennes sur l'automatisation des tests E2E, la stabilisation des suites existantes, l'intégration CI/CD et la priorisation des risques qualité, depuis nos bureaux à Antananarivo, Madagascar.",
		],
		whyTitle: 'Pourquoi Arsenal Guard ?',
		whyCards: [
			['Spécialisation QA pure', 'Nous ne sommes pas un cabinet généraliste. La QA est notre seul métier : Cypress, Playwright, CI/CD, stratégie de test. Une expertise pointue, pas de dilution.'],
			['Expertise francophone', 'Nos équipes parlent français nativement, comprennent vos enjeux métier et communiquent comme une extension de votre équipe interne.'],
			['Coût offshore optimisé', "Bénéficiez d'une qualité d'expertise équivalente au marché européen, avec un avantage tarifaire significatif grâce à notre implantation à Madagascar."],
			['Évolution sur le long terme', 'Nos tests sont conçus pour grandir avec votre produit. Votre équipe peut reprendre la main à tout moment, sans dépendance.'],
		],
		valuesTitle: 'Nos valeurs',
		values: [
			['Qualité', 'La qualité est notre obsession. Chaque test que nous écrivons doit apporter une vraie valeur business, jamais cocher une case sans impact.'],
			['Transparence', 'Nous facturons à la valeur, nous communiquons sans détour. Vous savez ce que vous payez, vous savez ce qui est livré.'],
			['Évolution', "Vos tests d'aujourd'hui doivent rester utiles demain. Nous construisons des suites qui grandissent avec votre produit, pas qui finissent à la corbeille."],
			['Fiabilité', "Aucune régression critique ne doit atteindre votre production. C'est notre engagement et notre raison d'être."],
		],
		madagascarTitle: 'Pourquoi Madagascar ?',
		madagascar: [
			['Équipe francophone native', 'Communication claire avec vos équipes produit, tech et management.'],
			['Recouvrement Europe', "Le fuseau UTC+3 offre un overlap confortable avec la France, la Belgique, la Suisse et l'Europe."],
			['Coût optimisé', "Une expertise QA premium avec 40 à 50% d'économie par rapport à un staffing local équivalent."],
			['Talents techniques formés', "Un vivier d'ingénieurs issus notamment de formations informatiques reconnues comme l'ENI."],
		],
		founderKicker: 'Le fondateur',
		aboutNextLabel: 'Découvrir les services Arsenal Guard.',
		founderRole: 'Fondateur & Lead QA Engineer',
		founderTexts: [
			"Senior QA Engineer avec 5+ ans d'expérience sur des produits à fort enjeu. Diplômé en informatique, Master ENI Fianarantsoa.",
			'Johny a accompagné des plateformes utilisées par Chanel, Sodexo et plusieurs scale-ups SaaS européennes avant de fonder Arsenal Guard avec la mission de démocratiser la QA premium pour les équipes produit.',
		],
		aboutCtaTitle: 'Faisons connaissance autour de votre projet.',
		aboutCtaLead: 'Nous identifions vos risques release, vos parcours critiques et les premiers tests qui apporteront un vrai impact.',
		casesComing: 'Publication après validation client.',
		read: 'Lire',
		contactSlot: 'Lien de prise de rendez-vous à ajouter prochainement.',
		legalEditor: 'Éditeur : Arsenal Guard, service QA premium basé à Antananarivo, Madagascar.',
		legalData: 'Contact : {email}. Les données transmises via les formulaires sont utilisées uniquement pour répondre aux demandes commerciales. Vous pouvez demander leur suppression à tout moment.',
		legalHosting: 'Hébergement recommandé : Vercel ou Cloudflare Pages. Analytics prévu : Cloudflare Web Analytics ou Plausible, sans cookies publicitaires.',
		notFound: "Cette page n'existe pas encore.",
		backHome: 'Retour accueil',
		qaNote: 'Automation · CI/CD · Risque',
		servicesEyebrow: 'Board des missions QA',
		servicesTitle: 'Choisissez la bonne ligne de défense pour votre release.',
		servicesLead: 'Des missions ponctuelles aux forfaits mensuels, chaque service Arsenal Guard transforme le risque produit en signal clair, actionnable et maintenable.',
		servicesPrimary: 'Voir les modes',
		servicesSecondary: 'Demander un devis',
		oneOffTitle: 'Interventions ponctuelles',
		automationTitle: 'Automatisation & garde continue',
		ledgerTitle: 'Ledger opérationnel',
		serviceDuration: 'Durée',
		serviceBudget: 'Budget',
		serviceSignal: 'Signal',
		serviceSignalValue: 'Release guarded',
		nextStep: 'Étape suivante',
		aboutHeroEyebrow: 'Poste de commandement',
		casesEyebrow: 'Dossiers terrain',
		casesTitle: 'Les missions publiques arrivent après validation client.',
		casesLead: 'En attendant les études détaillées, voici les familles de dossiers qui structurent nos interventions QA.',
		blogEyebrow: 'Briefing QA',
		blogTitle: 'Guides de terrain pour mieux piloter vos releases.',
		blogLead: 'Des articles courts, concrets, orientés décision : flakies, automation, IA et qualité produit.',
		quoteEyebrow: 'Ouverture de mission',
		quoteTitle: 'Décrivez le terrain, on prépare le plan QA.',
		quoteLead: "Le formulaire collecte juste ce qu'il faut pour cadrer le risque, proposer une mission utile et répondre sous 24h ouvrées.",
		contactEyebrow: 'Canal direct',
		contactTitle: 'Ouvrons un canal clair avant votre prochaine release.',
		contactLead: 'Une question, un audit, un besoin récurrent ou une urgence release : envoyez le signal, on répond vite.',
		legalEyebrow: 'Cadre opérationnel',
		privacyEyebrow: 'Confidentialité',
		legalLead: 'Informations éditeur, hébergement, données de contact et cadre de confidentialité.',
		notFoundEyebrow: 'Signal perdu',
		notFoundTitle: "Cette route n'est pas surveillée.",
		notFoundLead: "La page demandée n'existe pas encore ou a changé de position dans la carte.",
	}
	: {
		serviceButton: 'View service',
		punctual: 'One-off',
		monthly: 'Monthly',
		dedicated: 'Dedicated',
		deliverables: 'What you get',
		process: 'How it works',
		forWhom: 'Best for',
		aboutKicker: 'Premium QA service',
		aboutTitle: 'About Arsenal Guard',
		aboutLead: 'Premium QA service for European SaaS, e-commerce and web platforms.',
		missionTitle: 'Our mission',
		missionTexts: [
			'Arsenal Guard was built on a simple belief: software quality should not slow delivery down. It should become a clear, maintainable safety net for product teams.',
			'From Antananarivo, Madagascar, we support European startups and scale-ups with E2E automation, flaky suite stabilization, CI/CD integration and risk-based QA prioritization.',
		],
		whyTitle: 'Why Arsenal Guard?',
		whyCards: [
			['Pure QA specialization', 'We are not a generalist consultancy. QA is our core craft: Cypress, Playwright, CI/CD and test strategy with deep focus.'],
			['Clear communication', 'Our teams communicate clearly with product, engineering and leadership so collaboration feels like an extension of your own team.'],
			['Optimized offshore cost', 'You get senior-level QA expertise with a significant pricing advantage thanks to our Madagascar-based model.'],
			['Built for the long run', 'Our tests are designed to evolve with your product, and your team can take over at any time without dependency.'],
		],
		valuesTitle: 'Our values',
		values: [
			['Quality', 'Every test we write must create real business value, not just tick a coverage box.'],
			['Transparency', 'We communicate directly and keep scope, priorities and deliverables visible.'],
			['Evolution', "Today's tests must remain useful tomorrow. We build suites that grow with your product."],
			['Reliability', 'Critical regressions should not reach production. That is our commitment.'],
		],
		madagascarTitle: 'Why Madagascar?',
		madagascar: [
			['Strong communication', 'Clear collaboration with product, tech and management teams.'],
			['European overlap', 'UTC+3 provides comfortable overlap with France, Belgium, Switzerland and wider Europe.'],
			['Optimized cost', 'Premium QA expertise with 40 to 50% savings compared with equivalent local staffing.'],
			['Technical talent', 'A strong engineering talent pool from recognized computer science schools such as ENI.'],
		],
		founderKicker: 'The founder',
		aboutNextLabel: 'Explore Arsenal Guard services.',
		founderRole: 'Founder & Lead QA Engineer',
		founderTexts: [
			'Senior QA Engineer with 5+ years of experience on high-stakes products. Computer science graduate, Master ENI Fianarantsoa.',
			'Johny supported platforms used by Chanel, Sodexo and several European SaaS scale-ups before founding Arsenal Guard to make premium QA more accessible to product teams.',
		],
		aboutCtaTitle: "Let's map your project together.",
		aboutCtaLead: 'We identify release risks, critical journeys and the first tests that will create real impact.',
		casesComing: 'Publication after client approval.',
		read: 'Read',
		contactSlot: 'Booking link coming soon.',
		legalEditor: 'Publisher: Arsenal Guard, premium QA service based in Antananarivo, Madagascar.',
		legalData: 'Contact: {email}. Data submitted through forms is used only to answer business requests. You can request deletion at any time.',
		legalHosting: 'Recommended hosting: Vercel or Cloudflare Pages. Planned analytics: Cloudflare Web Analytics or Plausible, without advertising cookies.',
		notFound: 'This page does not exist yet.',
		backHome: 'Back home',
		qaNote: 'Automation · CI/CD · Risk',
		servicesEyebrow: 'QA mission board',
		servicesTitle: 'Choose the right defense line for your release.',
		servicesLead: 'From one-off missions to monthly retainers, every Arsenal Guard service turns product risk into a clear, actionable and maintainable signal.',
		servicesPrimary: 'View modes',
		servicesSecondary: 'Request a quote',
		oneOffTitle: 'One-off interventions',
		automationTitle: 'Automation & continuous guard',
		ledgerTitle: 'Operations ledger',
		serviceDuration: 'Duration',
		serviceBudget: 'Budget',
		serviceSignal: 'Signal',
		serviceSignalValue: 'Release guarded',
		nextStep: 'Next step',
		aboutHeroEyebrow: 'Command post',
		casesEyebrow: 'Field dossiers',
		casesTitle: 'Public missions arrive after client approval.',
		casesLead: 'Until detailed studies are approved, these dossier families show how our QA interventions are structured.',
		blogEyebrow: 'QA briefing',
		blogTitle: 'Field guides for steering better releases.',
		blogLead: 'Short, concrete, decision-oriented articles on flakies, automation, AI and product quality.',
		quoteEyebrow: 'Open a mission',
		quoteTitle: 'Describe the terrain, we prepare the QA plan.',
		quoteLead: 'The form collects just enough context to frame the risk, propose a useful mission and reply within one business day.',
		contactEyebrow: 'Direct channel',
		contactTitle: 'Open a clear channel before your next release.',
		contactLead: 'A question, an audit, a recurring need or a release emergency: send the signal and we reply fast.',
		legalEyebrow: 'Operational frame',
		privacyEyebrow: 'Confidentiality',
		legalLead: 'Publisher details, hosting, contact data and confidentiality frame.',
		notFoundEyebrow: 'Signal lost',
		notFoundTitle: 'This route is not under watch.',
		notFoundLead: 'The requested page does not exist yet or moved on the map.',
	};
---

<Layout
	lang={lang}
	path={path}
	title={title}
	description={baseDescription}
	schema={[
		{ ...schemaBase, '@type': 'Organization', name: site.name, url: site.url, founder: site.founder },
		page === 'home' ? { ...schemaBase, '@type': 'ProfessionalService', name: site.name, areaServed: 'Europe', serviceType: 'QA automation and software testing' } : {},
		page === 'service' && service ? { ...schemaBase, '@type': 'Service', name: service.title, provider: { '@type': 'Organization', name: site.name }, offers: { '@type': 'Offer', price: service.price } } : {},
	]}
>
	{page === 'home' && (
		<>
			<Hero lang={lang} />
			<LogoCloud lang={lang} />
			<ReleaseProblems lang={lang} />
			<HowItWorks lang={lang} />
			<SnapshotTeaser lang={lang} />
			<Stack lang={lang} />
			<FAQ lang={lang} />
			<CTASection lang={lang} />
		</>
	)}

	{page === 'services' && (
		<>
			<CommandPageHero
				lang={lang}
				variant="services"
				eyebrow={ui.servicesEyebrow}
				title={ui.servicesTitle}
				lead={ui.servicesLead}
				ctaLabel={ui.servicesPrimary}
				ctaHref="#service-modes"
				secondaryLabel={ui.servicesSecondary}
				secondaryHref={routeMap.quote}
				stats={[
					{ value: '72h', label: lang === 'fr' ? 'Snapshot possible' : 'Snapshot possible' },
					{ value: '5+', label: lang === 'fr' ? 'ans QA senior' : 'senior QA years' },
					{ value: 'UTC+3', label: lang === 'fr' ? 'overlap Europe' : 'Europe overlap' },
				]}
			/>
			<section id="service-modes" class="operation-roster py-20 md:py-28">
				<Container>
					<div class="mb-10 grid gap-5 md:grid-cols-[.8fr_1.2fr] md:items-end">
						<div>
							<p class="section-eyebrow">{ui.oneOffTitle}</p>
							<h2 class="mt-4 text-3xl font-extrabold md:text-5xl">
								{lang === 'fr' ? "Reconnaître le terrain avant d'engager la suite." : 'Read the terrain before engaging the suite.'}
							</h2>
						</div>
						<p class="text-muted leading-relaxed" data-reveal>{localizedServiceIntro[lang]}</p>
					</div>
					<div class="grid gap-5 md:grid-cols-2">
						{services.filter((s) => s.id === 'test-manuel-ponctuel' || s.id === 'audit-qa').map((item) => (
							<article class="operation-card" data-reveal>
								<p class="operation-card-kicker">{item.kicker}</p>
								<h3>{item.title}</h3>
								<p>{item.description}</p>
								<div class="operation-card-meta">
									<span>{item.duration}</span>
									<strong>{item.price}</strong>
								</div>
								<Button class="mt-6" href={`services/${item.id}`} lang={lang} variant="secondary">{ui.serviceButton}</Button>
							</article>
						))}
					</div>

					<div class="mb-10 mt-16 grid gap-5 md:grid-cols-[.8fr_1.2fr] md:items-end">
						<div>
							<p class="section-eyebrow">{ui.automationTitle}</p>
							<h2 class="mt-4 text-3xl font-extrabold md:text-5xl">
								{lang === 'fr' ? 'Transformer le risque confirmé en garde-fou durable.' : 'Turn confirmed risk into durable guardrails.'}
							</h2>
						</div>
					</div>
					<div class="grid gap-5 md:grid-cols-3">
						{services.filter((s) => s.id !== 'test-manuel-ponctuel' && s.id !== 'audit-qa').map((item) => (
							<article class="operation-card operation-card--compact" data-reveal>
								<p class="operation-card-kicker">{item.kicker}</p>
								<h3>{item.title}</h3>
								<p>{item.description}</p>
								<div class="operation-card-meta">
									<span>{item.duration}</span>
									<strong>{item.price}</strong>
								</div>
								<Button class="mt-6" href={`services/${item.id}`} lang={lang} variant="secondary">{ui.serviceButton}</Button>
							</article>
						))}
					</div>
				</Container>
			</section>
			<section class="ops-ledger section-band border-y py-20 md:py-28">
				<Container>
					<div class="mb-10">
						<p class="section-eyebrow">{ui.ledgerTitle}</p>
						<h2 class="mt-4 text-3xl font-extrabold md:text-5xl">
							{lang === 'fr' ? 'Vue rapide des volumes et engagements.' : 'A quick view of volume and engagement.'}
						</h2>
					</div>
					<div class="grid gap-5 lg:grid-cols-3">
						<div class="mission-ledger-card" data-reveal>
							<h3>{ui.punctual}</h3>
						{punctualOffers.map((row: PunctualRow) =>
							'tiers' in row
								? (
									<div class="ledger-row">
										<p>{row.name} · {row.duration}</p>
										{row.tiers.map(([label, price]) => (
											<span>{label} · <strong>{price}</strong></span>
										))}
									</div>
								)
								: <div class="ledger-row"><p>{row[0]}</p><span>{row[1]} · <strong>{row[2]}</strong></span></div>
						)}
						</div>
						<div class="mission-ledger-card" data-reveal>
							<h3>{ui.monthly}</h3>
							{plans.map((plan) => <div class="ledger-row"><p>{plan.name}</p><span>{plan.volume} · <strong>{plan.price}</strong></span></div>)}
						</div>
						<div class="mission-ledger-card" data-reveal>
							<h3>{ui.dedicated}</h3>
							{dedicated.map(([name, volume, price]) => <div class="ledger-row"><p>{name}</p><span>{volume} · <strong>{price}</strong></span></div>)}
						</div>
					</div>
				</Container>
			</section>
			<CTASection lang={lang} />
		</>
	)}

	{page === 'service' && service && (
		<>
			<CommandPageHero
				lang={lang}
				variant="service"
				eyebrow={service.kicker}
				title={service.title}
				lead={service.description}
				ctaLabel={t.nav.quote}
				ctaHref={routeMap.quote}
				secondaryLabel={lang === 'fr' ? 'Voir les livrables' : 'See deliverables'}
				secondaryHref="#service-dossier"
				stats={[
					{ value: service.duration, label: ui.serviceDuration },
					{ value: service.price, label: ui.serviceBudget },
					{ value: ui.serviceSignalValue, label: ui.serviceSignal },
				]}
			/>

			{service.tiers && service.tiers.length > 0 && (
				<TierPricingTable tiers={service.tiers} lang={lang} />
			)}

			<section id="service-dossier" class="svc-detail-section py-16 md:py-24">
				<Container>
					<div class="grid gap-4 lg:grid-cols-[1.65fr_1fr]">
						<div class="svc-card svc-card--deliverables reveal">
							<p class="svc-eyebrow">
								<Check class="size-3.5 flex-shrink-0" aria-hidden="true" />
								{ui.deliverables}
							</p>
							<ul class="svc-rows mt-5">
								{service.deliverables.map((item, i) => (
									<li class={`svc-row ${i > 0 ? 'svc-row--divide' : ''}`}>
										<span class="svc-row-icon">
											<Check class="size-3.5 text-orange-400" aria-hidden="true" />
										</span>
										<span class="text-sm leading-relaxed text-muted">{item}</span>
									</li>
								))}
							</ul>
						</div>

						<div class="svc-card svc-card--process reveal" style="--reveal-delay:80ms">
							<p class="svc-eyebrow">{ui.process}</p>
							<ol class="svc-rows mt-5">
								{service.process.map((item, i) => (
									<li class={`svc-row ${i > 0 ? 'svc-row--divide' : ''}`}>
										<span class="svc-step-num font-mono">0{i + 1}</span>
										<span class="text-sm leading-relaxed text-muted">{item}</span>
									</li>
								))}
							</ol>
						</div>
					</div>

					<!-- Bento row 2: For whom — full-width feature banner -->
					<div class="svc-for-whom mt-4 reveal" style="--reveal-delay:160ms">
						<div class="svc-for-whom-body">
							<p class="svc-eyebrow mb-4">
								<Users class="size-3.5 flex-shrink-0" aria-hidden="true" />
								{ui.forWhom}
							</p>
							<p class="text-base leading-relaxed md:text-lg">{service.for}</p>
						</div>
						<div class="svc-for-whom-cta">
							<Button href={routeMap.quote} lang={lang}>{t.nav.quote}</Button>
							<p class="mt-2.5 text-xs opacity-50">
								{lang === 'fr' ? 'Réponse sous 24h · Sans engagement' : 'Response within 24h · No commitment'}
							</p>
						</div>
					</div>
				</Container>
			</section>

			<FAQ lang={lang} items={service.faq} />

			{service.nextStep && (() => {
				const nextStep = service.nextStep;
				const nextService = services.find((s) => s.id === nextStep.serviceId);
				return nextService ? (
					<section class="next-mission-section section-band border-y py-16">
						<Container class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
							<div>
								<p class="text-sm font-bold uppercase tracking-[0.14em] text-orange-400">
									{ui.nextStep}
								</p>
								<p class="mt-2 text-lg font-semibold">{nextStep.label[lang]}</p>
							</div>
							<Button href={`services/${nextService.id}`} lang={lang} variant="secondary" class="shrink-0">
								{nextService.title}
							</Button>
						</Container>
					</section>
				) : null
			})()}

			<CTASection lang={lang} />
		</>
	)}

	{page === 'about' && (
		<>
			<CommandPageHero
				lang={lang}
				variant="about"
				eyebrow={ui.aboutHeroEyebrow}
				title={ui.aboutTitle}
				lead={ui.aboutLead}
				ctaLabel={t.nav.quote}
				ctaHref={routeMap.quote}
				secondaryLabel={lang === 'fr' ? 'Voir la mission' : 'See the mission'}
				secondaryHref="#about-mission"
				stats={[
					{ value: 'QA', label: ui.qaNote },
					{ value: '5+', label: lang === 'fr' ? 'ans terrain' : 'field years' },
					{ value: 'Europe', label: lang === 'fr' ? 'remote maîtrisé' : 'remote ready' },
				]}
			/>
			<section id="about-mission" class="about-mission-section py-24">
				<Container class="grid gap-8 lg:grid-cols-[.8fr_1.2fr]">
					<h2 class="text-3xl font-extrabold md:text-5xl">{ui.missionTitle}</h2>
					<div class="about-mission-copy space-y-5 text-lg text-muted" data-reveal>
