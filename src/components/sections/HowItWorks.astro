---
import FileSearch from 'lucide-astro/FileSearch';
import Flag from 'lucide-astro/Flag';
import ShieldCheck from 'lucide-astro/ShieldCheck';
import Waypoints from 'lucide-astro/Waypoints';
import Container from '../ui/Container.astro';
import type { Lang } from '../../lib/i18n';
interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const labels =
	lang === 'fr'
		? {
				eyebrow: 'Comment ça fonctionne',
				title: 'Une intervention courte et bien cadrée peut déjà apporter une vraie valeur.',
				lead: "Le QA n'a pas toujours besoin d'arriver pour 6 mois. Parfois, quelques jours suffisent pour éviter plusieurs semaines de corrections après la release.",
				steps: [
					{
						icon: Waypoints,
						phase: 'Je teste vos parcours',
						text: "Je parcours vos pages comme un utilisateur réel : tunnel de commande, formulaire critique, espace client, parcours d'inscription. Les zones à risque en priorité absolue.",
					},
					{
						icon: Flag,
						phase: 'Je livre un rapport',
						text: 'Rapport structuré sous 72h : bugs Critique / Majeur / Mineur, captures annotées, recommandations claires. Pas un dump de tickets — un signal exploitable par votre équipe.',
					},
					{
						icon: ShieldCheck,
						phase: "Je vous remets un plan d'action",
						text: "Chaque bug est accompagné d'une estimation et d'une priorité. Votre équipe sait exactement quoi corriger en premier et pourquoi.",
					},
					{
						icon: FileSearch,
						phase: 'Vous pouvez aller plus loin',
						text: 'Si vous souhaitez verrouiller les parcours critiques durablement, je mets en place des tests automatisés (Playwright / Cypress) ou une mission QA récurrente selon votre cadence.',
					},
				],
			}
		: {
				eyebrow: 'How it works',
				title: 'A short, well-scoped intervention can already make a real difference.',
				lead: "QA doesn't always need to come in for 6 months. Sometimes a few days are enough to prevent several weeks of post-release fixes.",
				steps: [
					{
						icon: Waypoints,
						phase: 'I test your journeys',
						text: 'I walk through your pages as a real user: checkout flow, critical forms, account area, sign-up journey. High-risk zones are the absolute priority.',
					},
					{
						icon: Flag,
						phase: 'I deliver a report',
						text: 'Structured report in 72h: Critical / Major / Minor bugs, annotated screenshots, clear recommendations. Not a ticket dump — an actionable signal for your team.',
					},
					{
						icon: ShieldCheck,
						phase: 'I give you an action plan',
						text: 'Each bug comes with an estimate and a priority. Your team knows exactly what to fix first and why.',
					},
					{
						icon: FileSearch,
						phase: 'You can go further',
						text: 'If you want to lock down critical journeys durably, I set up automated tests (Playwright / Cypress) or a recurring QA mission matched to your release cadence.',
					},
				],
			};
---

<section class="how-section relative overflow-hidden py-16 md:py-32">
	<div class="how-section-track" aria-hidden="true"></div>
	<Container>
		<div class="mb-10 md:mb-14">
			<p class="section-eyebrow">{labels.eyebrow}</p>
			<h2 class="mt-4 max-w-4xl text-3xl font-extrabold md:text-5xl">{labels.title}</h2>
			<p class="mt-5 max-w-3xl text-lg leading-relaxed text-muted" data-reveal>{labels.lead}</p>
		</div>
		<div class="grid gap-0 md:grid-cols-4 md:gap-0">
			{
				labels.steps.map((step, index) => {
					const Icon = step.icon;
					return (
						<div class="timeline-step reveal" style={`--reveal-delay:${index * 90}ms`}>
							<div class="timeline-step-inner">
								<div class="timeline-num">
									<Icon class="size-5" aria-hidden="true" />
									<span>0{index + 1}</span>
								</div>
								<div>
									<p class="timeline-phase">{step.phase}</p>
									<h3>{step.text}</h3>
								</div>
							</div>
						</div>
					);
				})
			}
		</div>
	</Container>
</section>
