---
import Container from '../ui/Container.astro';
import { copy, type Lang } from '../../lib/i18n';
import { steps } from '../../lib/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const localizedSteps = lang === 'fr'
	? steps
	: [
		'Fast audit and risk mapping',
		'Framework setup and CI/CD integration',
		'E2E tests on critical user journeys',
		'Monthly run: new scenarios and maintenance',
	];
---
<section class="relative py-24 md:py-32 overflow-hidden">
	<!-- subtle diagonal background stripe -->
	<div class="absolute inset-0 -z-10 opacity-40" aria-hidden="true">
		<div
			class="absolute inset-0"
			style="background: linear-gradient(112deg, transparent 0%, transparent 38%, rgba(10,21,48,0.55) 38%, rgba(10,21,48,0.55) 62%, transparent 62%);"
		></div>
	</div>
	<Container>
		<div class="mb-14 reveal">
			<p class="section-eyebrow">{lang === 'fr' ? 'Méthodologie' : 'Method'}</p>
			<h2 class="mt-4 text-3xl font-extrabold md:text-5xl">{copy[lang].sections.how}</h2>
		</div>
		<div class="grid gap-0 md:grid-cols-4 md:gap-0">
			{localizedSteps.map((step, index) => (
				<div class="timeline-step reveal" style={`--reveal-delay:${index * 90}ms`}>
					<div class="flex items-start gap-4 md:flex-col md:items-start md:gap-0">
						<!-- number badge -->
						<div class="timeline-num md:mb-5">0{index + 1}</div>
						<!-- connector line visible on mobile (vertical) handled by ::before -->
						<div class="pb-8 md:pb-0 md:pr-8">
							<h3 class="font-bold text-base leading-snug">{step}</h3>
						</div>
					</div>
				</div>
			))}
		</div>
	</Container>
</section>
