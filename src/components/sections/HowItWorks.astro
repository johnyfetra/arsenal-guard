---
import FileSearch from 'lucide-astro/FileSearch';
import Flag from 'lucide-astro/Flag';
import ShieldCheck from 'lucide-astro/ShieldCheck';
import Waypoints from 'lucide-astro/Waypoints';
import SectionIllustration from '../illustrations/SectionIllustration.astro';
import Container from '../ui/Container.astro';
import type { Lang } from '../../lib/i18n';
interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const labels =
	lang === 'fr'
		? {
				eyebrow: 'Comment ça fonctionne',
				title: 'Une intervention courte et bien cadrée peut déjà apporter une vraie valeur.',
				lead: "Le QA n'a pas toujours besoin d'arriver pour 6 mois. Parfois, quelques jours suffisent pour éviter plusieurs semaines de corrections après la release.",
				steps: [
					{
						icon: Waypoints,
						phase: 'Je teste vos parcours',
						items: [
							'Tunnel de commande & formulaires critiques',
							"Espace client, parcours d'inscription",
							'Zones à risque en priorité absolue',
						],
					},
					{
						icon: Flag,
						phase: 'Je livre un rapport',
						items: [
							'Sous 72h : Critique / Majeur / Mineur',
							'Captures annotées & recommandations claires',
							'Signal exploitable — pas un dump de tickets',
						],
					},
					{
						icon: ShieldCheck,
						phase: "Je vous remets un plan d'action",
						items: [
							'Chaque bug : estimation + priorité',
							'Ordre de correction clair et justifié',
							'Votre équipe sait exactement quoi faire',
						],
					},
					{
						icon: FileSearch,
						phase: 'Vous pouvez aller plus loin',
						items: [
							'Tests automatisés (Playwright / Cypress)',
							'Mission QA récurrente selon votre cadence',
							'Verrouillage durable des parcours critiques',
						],
					},
				],
			}
		: {
				eyebrow: 'How it works',
				title: 'A short, well-scoped intervention can already make a real difference.',
				lead: "QA doesn't always need to come in for 6 months. Sometimes a few days are enough to prevent several weeks of post-release fixes.",
				steps: [
					{
						icon: Waypoints,
						phase: 'I test your journeys',
						items: [
							'Checkout flow & critical forms',
							'Account area, sign-up journey',
							'High-risk zones as absolute priority',
						],
					},
					{
						icon: Flag,
						phase: 'I deliver a report',
						items: [
							'Within 72h: Critical / Major / Minor',
							'Annotated screenshots & clear recommendations',
							'Actionable signal — not a ticket dump',
						],
					},
					{
						icon: ShieldCheck,
						phase: 'I give you an action plan',
						items: [
							'Each bug: estimate + priority',
							'Clear, justified fix order',
							'Your team knows exactly what to do',
						],
					},
					{
						icon: FileSearch,
						phase: 'You can go further',
						items: [
							'Automated tests (Playwright / Cypress)',
							'Recurring QA mission at your cadence',
							'Long-term coverage of critical journeys',
						],
					},
				],
			};
---

<section id="qa-method" class="how-section relative overflow-hidden py-16 md:py-32">
	<div class="how-section-track" aria-hidden="true"></div>
	<Container>
		<div class="mb-10 grid gap-8 md:mb-14 lg:grid-cols-[1fr_.78fr] lg:items-end">
			<div>
				<p class="section-eyebrow">{labels.eyebrow}</p>
				<h2 class="mt-4 max-w-4xl text-3xl font-extrabold md:text-5xl">{labels.title}</h2>
				<p class="mt-5 max-w-3xl text-lg leading-relaxed text-muted" data-reveal>{labels.lead}</p>
			</div>
			<div class="section-visual-card justify-self-start lg:justify-self-end" data-reveal>
				<SectionIllustration variant="method-flow" lang={lang} />
			</div>
		</div>
		<div class="grid gap-0 md:grid-cols-4 md:gap-0">
			{
				labels.steps.map((step, index) => {
					const Icon = step.icon;
					return (
						<div class="timeline-step reveal" style={`--reveal-delay:${index * 90}ms`}>
							<div class="timeline-step-inner">
								<div class="timeline-num">
									<Icon class="size-5" aria-hidden="true" />
									<span>0{index + 1}</span>
								</div>
								<div>
									<p class="timeline-phase">{step.phase}</p>
									<ul class="timeline-items">
										{step.items.map((item) => (
											<li>{item}</li>
										))}
									</ul>
								</div>
							</div>
						</div>
					);
				})
			}
		</div>
	</Container>
</section>
