---
import Moon from 'lucide-astro/Moon';
import Sun from 'lucide-astro/Sun';
import type { Lang } from '../../lib/i18n';

interface Props {
	lang?: Lang;
}

const { lang = 'fr' } = Astro.props;
const labels = lang === 'fr'
	? {
		toLight: 'Passer au thème clair',
		toDark: 'Passer au thème sombre',
	}
	: {
		toLight: 'Switch to light theme',
		toDark: 'Switch to dark theme',
	};
---

<button
	type="button"
	class="theme-switch"
	role="switch"
	aria-checked="true"
	aria-label={labels.toLight}
	data-theme-label-light={labels.toLight}
	data-theme-label-dark={labels.toDark}
	data-theme-toggle
>
	<span class="theme-switch-thumb" aria-hidden="true"></span>
	<span class="theme-switch-slot">
		<Sun class="size-[0.8rem]" aria-hidden="true" />
	</span>
	<span class="theme-switch-slot">
		<Moon class="size-[0.8rem]" aria-hidden="true" />
	</span>
</button>

<script is:inline>
	const applyTheme = (theme) => {
		document.documentElement.dataset.theme = theme;
		document.documentElement.classList.toggle('dark', theme === 'dark');
		localStorage.setItem('theme', theme);
		document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
			const isDark = theme === 'dark';
			button.setAttribute('aria-checked', String(isDark));
			button.setAttribute(
				'aria-label',
				isDark
					? button.dataset.themeLabelLight || 'Switch to light theme'
					: button.dataset.themeLabelDark || 'Switch to dark theme',
			);
		});
	};
	const animateThemeWave = (nextTheme) => {
		document.documentElement.classList.add('theme-switching');
		applyTheme(nextTheme);
		window.setTimeout(() => {
			document.documentElement.classList.remove('theme-switching');
		}, 120);
	};
	const saved = localStorage.getItem('theme');
	applyTheme(saved || 'dark');
	document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
			animateThemeWave(next);
		});
	});
</script>
