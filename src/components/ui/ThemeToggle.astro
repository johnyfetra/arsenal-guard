---
import Moon from 'lucide-astro/Moon';
import Sun from 'lucide-astro/Sun';
---

<button
	type="button"
	class="theme-toggle-icon inline-flex size-10 items-center justify-center rounded-xl text-current"
	aria-label="Toggle dark and light theme"
	data-theme-toggle
>
	<Sun class="hidden size-4 dark:inline" aria-hidden="true" />
	<Moon class="size-4 dark:hidden" aria-hidden="true" />
</button>

<script is:inline>
	const applyTheme = (theme) => {
		document.documentElement.dataset.theme = theme;
		document.documentElement.classList.toggle('dark', theme === 'dark');
		localStorage.setItem('theme', theme);
	};
	const animateThemeWave = (nextTheme) => {
		document.documentElement.classList.add('theme-switching');
		applyTheme(nextTheme);
		window.setTimeout(() => {
			document.documentElement.classList.remove('theme-switching');
		}, 120);
	};
	const saved = localStorage.getItem('theme');
	const initial = saved || 'dark';
	applyTheme(initial);
	document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
		button.addEventListener('click', () => {
			const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
			animateThemeWave(next);
		});
	});
</script>
