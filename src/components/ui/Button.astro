---
import { localizedPath, type Lang } from '../../lib/i18n';

interface Props {
	href?: string;
	lang?: Lang;
	variant?: 'primary' | 'secondary' | 'ghost';
	type?: 'button' | 'submit';
	class?: string;
}

const { href, lang = 'fr', variant = 'primary', type = 'button', class: className = '' } = Astro.props;
const base =
	'inline-flex min-h-11 items-center justify-center gap-2 rounded-lg px-5 py-3 text-sm font-bold transition hover:-translate-y-0.5';
const variants = {
	primary: 'bg-gradient-to-r from-orange-500 to-orange-400 text-white shadow-glow hover:from-orange-600 hover:to-orange-500',
	secondary: 'border border-orange-400/50 text-orange-300 hover:border-orange-400 hover:bg-orange-400/10',
	ghost: 'text-current underline decoration-orange-400/50 underline-offset-8 hover:text-orange-300',
};
const classes = `${base} ${variants[variant]} ${className}`;
---

{
	href ? (
		<a class={classes} href={href.startsWith('/') ? localizedPath(lang, href) : href}>
			<slot />
		</a>
	) : (
		<button class={classes} type={type}>
			<slot />
		</button>
	)
}
