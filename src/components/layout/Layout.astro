---
import '../../styles/globals.css';
import BaseHead from '../seo/BaseHead.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import type { Lang } from '../../lib/i18n';

interface Props {
	title: string;
	description: string;
	lang: Lang;
	path: string;
	type?: 'website' | 'article';
	schema?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, lang, path, type, schema } = Astro.props;
---

<!doctype html>
<html lang={lang} data-theme="dark" class="dark">
	<head>
		<script is:inline>
			const savedTheme = localStorage.getItem('theme');
			const preferredTheme = savedTheme || 'dark';
			document.documentElement.dataset.theme = preferredTheme;
			document.documentElement.classList.toggle('dark', preferredTheme === 'dark');
			const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
			let preloaderSeen = false;
			try {
				preloaderSeen = sessionStorage.getItem('ag-preloader-seen') === '1';
			} catch {}
			if (!reduceMotion) {
				document.documentElement.classList.add('reveal-ready');
			}
			if (!reduceMotion && !preloaderSeen) {
				document.documentElement.classList.add('ag-preloader-active');
			}
			// Auto-detect browser language on first visit (no explicit choice saved)
			try {
				const savedLang = localStorage.getItem('arsenal-lang');
				if (!savedLang) {
					const browserLang = (navigator.language || navigator.userLanguage || '').toLowerCase();
					const preferEn = browserLang.startsWith('en');
					const onEnPath = location.pathname.startsWith('/en');
					if (preferEn && !onEnPath) {
						location.replace('/en' + (location.pathname === '/' ? '/' : location.pathname));
					} else {
						localStorage.setItem('arsenal-lang', preferEn ? 'en' : 'fr');
					}
				}
			} catch {}
		</script>
		<BaseHead title={title} description={description} lang={lang} path={path} type={type} schema={schema} />
	</head>
	<body>
		<div class="ag-preloader" data-ag-preloader aria-hidden="true">
			<div class="ag-preloader-field" aria-hidden="true">
				<span class="ag-loader-dot ag-loader-dot--one"></span>
				<span class="ag-loader-dot ag-loader-dot--two"></span>
				<span class="ag-loader-dot ag-loader-dot--three"></span>
				<span class="ag-loader-dot ag-loader-dot--four"></span>
			</div>
			<div class="ag-loader-core" data-ag-loader-core>
				<svg class="ag-loader-svg" viewBox="0 0 160 160" role="img" aria-label="Arsenal Guard">
					<defs>
						<linearGradient id="ag-loader-stroke" x1="18" y1="16" x2="142" y2="144" gradientUnits="userSpaceOnUse">
							<stop stop-color="#F6C057" />
							<stop offset="0.52" stop-color="#E67E22" />
							<stop offset="1" stop-color="#F39C12" />
						</linearGradient>
					</defs>
					<path class="ag-loader-shield" d="M80 15 126 32v39c0 33-18.6 57.8-46 73-27.4-15.2-46-40-46-73V32l46-17Z" />
					<path class="ag-loader-scan" d="M48 82h22l9-18 14 38 9-20h10" />
					<path class="ag-loader-check" d="M54 106 71 122l36-48" />
				</svg>
				<p class="ag-loader-brand">Arsenal Guard</p>
				<p class="ag-loader-status" aria-live="polite">Loading quality signal</p>
				<p class="ag-loader-count" data-ag-loader-count>0%</p>
			</div>
		</div>
		<Header lang={lang} path={path} />
		<main id="main" data-app-shell>
			<slot />
		</main>
		<Footer lang={lang} />
		<script is:inline>
			const preloader = document.querySelector('[data-ag-preloader]');
			const appShell = document.querySelector('[data-app-shell]');
			const loaderCore = document.querySelector('[data-ag-loader-core]');
			const loaderCount = document.querySelector('[data-ag-loader-count]');
			const reduceLoaderMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

			if (preloader && appShell && loaderCount && !reduceLoaderMotion) {
				appShell.setAttribute('aria-busy', 'true');

				let progress = 0;
				let lastTime = performance.now();
				const startTime = lastTime;
				const minDuration = 4000;
				const maxDuration = 4300;

				const finishLoader = () => {
					loaderCount.textContent = '100%';
					preloader.classList.add('is-complete');
					document.documentElement.classList.add('ag-preloader-zooming');
					window.setTimeout(() => {
						preloader.setAttribute('hidden', '');
						document.documentElement.classList.remove('ag-preloader-active', 'ag-preloader-zooming');
						document.documentElement.classList.add('ag-preloader-done');
						appShell.removeAttribute('aria-busy');
						try {
							sessionStorage.setItem('ag-preloader-seen', '1');
						} catch {}
						window.dispatchEvent(new CustomEvent('ag:preloader-done'));
					}, 420);
				};

				const tickLoader = (now) => {
					const delta = now - lastTime;
					lastTime = now;
					const elapsed = now - startTime;
					const target = document.readyState === 'complete' ? 100 : Math.min(96, elapsed / maxDuration * 100);
					const speed = target > 96 ? 0.22 : 0.075;
					progress += (target - progress) * speed + delta * 0.022;
					progress = Math.min(progress, target);

					if (elapsed > 740 && progress > 92 && progress < 98) {
						progress = Math.min(progress, 96);
					}

					loaderCount.textContent = `${Math.floor(progress)}%`;

					if ((document.readyState === 'complete' && elapsed >= minDuration) || elapsed >= maxDuration) {
						finishLoader();
						return;
					}

					requestAnimationFrame(tickLoader);
				};

				requestAnimationFrame(tickLoader);
				window.addEventListener('load', () => {
					if (loaderCore) loaderCore.classList.add('is-ready');
				}, { once: true });
			} else {
				preloader?.setAttribute('hidden', '');
				document.documentElement.classList.remove('ag-preloader-active', 'ag-preloader-zooming');
				appShell?.removeAttribute('aria-busy');
			}
		</script>
		<script is:inline>
			// Mark elements for GSAP reveal (adds .reveal class used as selector)
			const revealSelectors = [
				'main section:not(.hero-shell) h1',
				'main section:not(.hero-shell) h2',
				'main section:not(.hero-shell) .surface',
				'main section:not(.hero-shell) .step-card',
				'main section:not(.hero-shell) form',
				'main section:not(.hero-shell) .operation-card',
				'main section:not(.hero-shell) .mission-ledger-card',
				'main section:not(.hero-shell) .identity-card',
				'main section:not(.hero-shell) .value-tile',
				'main section:not(.hero-shell) .route-card',
				'main section:not(.hero-shell) .case-card',
				'main section:not(.hero-shell) .article-card',
				'main section:not(.hero-shell) .contact-signal',
				'main section:not(.hero-shell) .legal-panel',
				'main section:not(.hero-shell) .logo-marquee',
				'main section:not(.hero-shell) .about-portrait-group',
				'main section:not(.hero-shell) .prose-ag',
				'main [data-reveal]',
			].join(',');
			const revealNodes = [...document.querySelectorAll(revealSelectors)].filter((node) => {
				if (node.closest('[data-no-reveal]')) return false;
				if (
					node.matches('h1, h2') &&
					node.closest(
						'.surface, .step-card, form, .operation-card, .mission-ledger-card, .identity-card, .value-tile, .route-card, .case-card, .article-card, .contact-signal, .legal-panel, .logo-marquee, .prose-ag',
					)
				) return false;
				return true;
			});
			revealNodes.forEach((node) => {
				if (!node.classList.contains('reveal')) node.classList.add('reveal');
			});

			// Scroll-float parallax (lightweight, no GSAP needed)
			const reduceScrollMotion = matchMedia('(prefers-reduced-motion: reduce)');
			const scrollFloatNodes = [...document.querySelectorAll('.scroll-float[data-scroll-depth]')];
			let scrollFloatFrame = 0;
			const updateScrollFloat = () => {
				scrollFloatFrame = 0;
				const viewport = window.innerHeight || 1;
				for (const node of scrollFloatNodes) {
					const depth = Number(node.dataset.scrollDepth || 0);
					const rect = node.getBoundingClientRect();
					const progress = (rect.top + rect.height / 2 - viewport / 2) / viewport;
					const clamped = Math.max(-1, Math.min(1, progress));
					node.style.setProperty('--scroll-shift', `${clamped * depth}px`);
				}
			};
			const requestScrollFloat = () => {
				if (!scrollFloatFrame) scrollFloatFrame = requestAnimationFrame(updateScrollFloat);
			};
			if (!reduceScrollMotion.matches && scrollFloatNodes.length) {
				updateScrollFloat();
				addEventListener('scroll', requestScrollFloat, { passive: true });
				addEventListener('resize', requestScrollFloat);
			}
		</script>
		<script>
			import '../../scripts/animations';
		</script>
	</body>
</html>
