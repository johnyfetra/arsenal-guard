---
import '../../styles/globals.css';
import BaseHead from '../seo/BaseHead.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import type { Lang } from '../../lib/i18n';

interface Props {
	title: string;
	description: string;
	lang: Lang;
	path: string;
	type?: 'website' | 'article';
	schema?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, lang, path, type, schema } = Astro.props;
---

<!doctype html>
<html lang={lang} data-theme="dark" class="dark">
	<head>
		<script is:inline>
			const savedTheme = localStorage.getItem('theme');
			const preferredTheme = savedTheme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
			document.documentElement.dataset.theme = preferredTheme;
			document.documentElement.classList.toggle('dark', preferredTheme === 'dark');
			if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
				document.documentElement.classList.add('reveal-ready');
			}
		</script>
		<BaseHead title={title} description={description} lang={lang} path={path} type={type} schema={schema} />
	</head>
	<body>
		<Header lang={lang} path={path} />
		<main id="main">
			<slot />
		</main>
		<Footer lang={lang} />
		<script is:inline>
			const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
			const revealSelectors = [
				'main section:not(.hero-shell) h1',
				'main section:not(.hero-shell) h2',
				'main section:not(.hero-shell) .surface',
				'main section:not(.hero-shell) .step-card',
				'main section:not(.hero-shell) form',
				'main section:not(.hero-shell) .logo-marquee',
				'main section:not(.hero-shell) .about-portrait-group',
				'main section:not(.hero-shell) .prose-ag',
				'main [data-reveal]',
			].join(',');
			const revealNodes = [...document.querySelectorAll(revealSelectors)].filter((node) => {
				if (node.closest('[data-no-reveal]')) return false;
				if (node.matches('h1, h2') && node.closest('.surface, .step-card, form, .logo-marquee, .prose-ag')) return false;
				return true;
			});
			const viewportHeight = window.innerHeight || document.documentElement.clientHeight || 1;
			const showAllReveals = () => {
				for (const node of revealNodes) node.classList.add('is-visible');
			};

			revealNodes.forEach((node) => {
				if (!node.classList.contains('reveal')) node.classList.add('reveal');
				const siblings = revealNodes.filter((item) => item.closest('section') === node.closest('section'));
				const index = siblings.indexOf(node);
				node.style.setProperty('--reveal-delay', `${Math.min(index, 5) * 45}ms`);
			});

			if (reduceMotion.matches || !('IntersectionObserver' in window)) {
				document.documentElement.classList.remove('reveal-ready');
				showAllReveals();
			} else {
				const observer = new IntersectionObserver((entries, currentObserver) => {
					for (const entry of entries) {
						if (!entry.isIntersecting) continue;
						entry.target.classList.add('is-visible');
						currentObserver.unobserve(entry.target);
					}
				}, { rootMargin: '0px 0px -8% 0px', threshold: 0.14 });

				revealNodes.forEach((node) => {
					const rect = node.getBoundingClientRect();
					if (rect.top < viewportHeight * 0.9) {
						node.classList.add('is-visible');
					} else {
						observer.observe(node);
					}
				});
				setTimeout(showAllReveals, 1400);
			}

			const scrollFloatNodes = [...document.querySelectorAll('.scroll-float[data-scroll-depth]')];
			let scrollFloatFrame = 0;
			const updateScrollFloat = () => {
				scrollFloatFrame = 0;
				const viewport = window.innerHeight || 1;
				for (const node of scrollFloatNodes) {
					const depth = Number(node.dataset.scrollDepth || 0);
					const rect = node.getBoundingClientRect();
					const progress = (rect.top + rect.height / 2 - viewport / 2) / viewport;
					const clamped = Math.max(-1, Math.min(1, progress));
					node.style.setProperty('--scroll-shift', `${clamped * depth}px`);
				}
			};
			const requestScrollFloat = () => {
				if (!scrollFloatFrame) scrollFloatFrame = requestAnimationFrame(updateScrollFloat);
			};
			if (!reduceMotion.matches && scrollFloatNodes.length) {
				updateScrollFloat();
				addEventListener('scroll', requestScrollFloat, { passive: true });
				addEventListener('resize', requestScrollFloat);
			}
		</script>
	</body>
</html>
