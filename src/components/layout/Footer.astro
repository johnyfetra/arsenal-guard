---
import { copy, localizedPath, routeMap, type Lang } from '../../lib/i18n';
import { site } from '../../lib/site';
import Container from '../ui/Container.astro';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
const links = [
	[t.nav.services, routeMap.services],
	[t.nav.about, routeMap.about],
	[t.nav.blog, routeMap.blog],
	[t.nav.contact, routeMap.contact],
	['Mentions legales', routeMap.legal],
	['Politique de confidentialite', routeMap.privacy],
];
---

<footer class="site-footer border-t py-12">
	<Container class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
		<div>
			<p class="text-lg font-extrabold text-white">{site.name}</p>
			<p class="footer-muted mt-3 max-w-md text-sm">{site.tagline}. Antananarivo, Madagascar — clients dans toute l Europe.</p>
		</div>
		<div>
			<p class="font-bold text-white">Navigation</p>
			<ul class="footer-muted mt-4 space-y-2 text-sm">
				{links.map(([label, href]) => <li><a class="footer-link" href={localizedPath(lang, href)}>{label}</a></li>)}
			</ul>
		</div>
		<div>
			<p class="font-bold text-white">Contact</p>
			<a class="footer-link footer-accent mt-4 block text-sm" href={`mailto:${site.email}`}>{site.email}</a>
			<p class="footer-muted mt-2 text-sm">linkedin.com/company/arsenal-guard</p>
			<p class="footer-muted mt-2 text-sm">© 2026 Arsenal Guard. Tous droits reserves.</p>
		</div>
	</Container>
</footer>
