---
import { copy, localizedPath, routeMap, type Lang } from '../../lib/i18n';
import { site } from '../../lib/site';
import Container from '../ui/Container.astro';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
const links = [
	[t.nav.services, routeMap.services],
	[t.nav.about, routeMap.about],
	[t.nav.blog, routeMap.blog],
	[t.nav.contact, routeMap.contact],
	['Legal', routeMap.legal],
	['Privacy', routeMap.privacy],
];
---

<footer class="border-t border-white/10 bg-navy-950 py-12">
	<Container class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
		<div>
			<p class="text-lg font-extrabold">{site.name}</p>
			<p class="mt-3 max-w-md text-sm text-muted">{site.tagline} QA freelance senior depuis Madagascar, pour equipes europeennes ambitieuses.</p>
		</div>
		<div>
			<p class="font-bold">Navigation</p>
			<ul class="mt-4 space-y-2 text-sm text-muted">
				{links.map(([label, href]) => <li><a class="hover:text-orange-300" href={localizedPath(lang, href)}>{label}</a></li>)}
			</ul>
		</div>
		<div>
			<p class="font-bold">Contact</p>
			<a class="mt-4 block text-sm text-orange-300" href={`mailto:${site.email}`}>{site.email}</a>
			<p class="mt-2 text-sm text-muted">{site.location} · Remote Europe</p>
		</div>
	</Container>
</footer>
