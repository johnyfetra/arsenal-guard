---
import LanguageSwitcher from '../i18n/LanguageSwitcher.astro';
import ThemeToggle from '../ui/ThemeToggle.astro';
import Button from '../ui/Button.astro';
import { copy, localizedPath, routeMap, type Lang } from '../../lib/i18n';

interface Props {
	lang: Lang;
	path: string;
}

const { lang, path } = Astro.props;
const t = copy[lang];
const nav = [
	[t.nav.services, routeMap.services],
	[t.nav.about, routeMap.about],
	[t.nav.cases, routeMap.cases],
	[t.nav.blog, routeMap.blog],
	[t.nav.contact, routeMap.contact],
];
---

<a class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-orange-500 focus:px-4 focus:py-2 focus:text-white" href="#main">Skip to content</a>
<header class="sticky top-0 z-40 border-b border-white/10 bg-navy-950/82 backdrop-blur-xl">
	<nav class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8" aria-label="Main navigation">
		<a href={localizedPath(lang, '/')} class="flex items-center gap-3 font-extrabold">
			<span class="grid size-9 place-items-center rounded-lg bg-orange-500 text-white">AG</span>
			<span>Arsenal Guard</span>
		</a>
		<div class="hidden items-center gap-6 lg:flex">
			{nav.map(([label, href]) => <a class="text-sm font-semibold text-white/78 transition hover:text-orange-300" href={localizedPath(lang, href)}>{label}</a>)}
		</div>
		<div class="flex items-center gap-2">
			<div class="hidden sm:block"><LanguageSwitcher lang={lang} path={path} /></div>
			<ThemeToggle />
			<div class="hidden md:block"><Button href={routeMap.quote} lang={lang}>{t.nav.quote}</Button></div>
		</div>
	</nav>
</header>
