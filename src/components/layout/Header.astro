---
import Menu from 'lucide-astro/Menu';
import X from 'lucide-astro/X';
import LanguageSwitcher from '../i18n/LanguageSwitcher.astro';
import ThemeToggle from '../ui/ThemeToggle.astro';
import Button from '../ui/Button.astro';
import { copy, localizedPath, routeMap, type Lang } from '../../lib/i18n';

interface Props {
	lang: Lang;
	path: string;
}

const { lang, path } = Astro.props;
const t = copy[lang];
const nav = [
	[t.nav.services, routeMap.services],
	[t.nav.about, routeMap.about],
	[t.nav.cases, routeMap.cases],
	[t.nav.blog, routeMap.blog],
	[t.nav.contact, routeMap.contact],
];
---

<a class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-orange-500 focus:px-4 focus:py-2 focus:text-white" href="#main">Skip to content</a>
<header class="site-header sticky top-0 z-40 border-b" data-site-header>
	<nav class="mx-auto flex h-[4.5rem] max-w-7xl items-center justify-between gap-4 px-4 py-2 sm:px-6 lg:px-8" aria-label="Main navigation">
		<a href={localizedPath(lang, '/')} class="brand-link flex items-center gap-3 font-extrabold">
			<span class="logo-mark grid size-12 place-items-center bg-transparent">
				<img
					src="/logo.png"
					width="48"
					height="48"
					alt=""
					class="size-12 object-contain"
					loading="eager"
					decoding="async"
				/>
			</span>
			<span class="bg-transparent">Arsenal Guard</span>
		</a>
		<div class="hidden items-center gap-6 lg:flex">
			{nav.map(([label, href]) => <a class="nav-link text-sm font-semibold text-current opacity-80 transition hover:text-orange-400 hover:opacity-100" href={localizedPath(lang, href)}>{label}</a>)}
		</div>
		<div class="flex items-center gap-2">
			<div class="hidden sm:block"><LanguageSwitcher lang={lang} path={path} /></div>
			<ThemeToggle />
			<div class="hidden md:block"><Button href={routeMap.quote} lang={lang}>{t.nav.quote}</Button></div>
			<button class="mobile-menu-toggle lg:hidden" type="button" aria-label="Open menu" aria-expanded="false" data-mobile-menu-toggle>
				<Menu class="mobile-menu-icon-open size-5" aria-hidden="true" />
				<X class="mobile-menu-icon-close hidden size-5" aria-hidden="true" />
			</button>
		</div>
	</nav>
	<div class="mobile-menu lg:hidden" data-mobile-menu hidden>
		<div class="mx-auto grid max-w-7xl gap-3 px-4 pb-5 sm:px-6">
			<div class="grid gap-1">
				{nav.map(([label, href]) => <a class="mobile-nav-link" href={localizedPath(lang, href)}>{label}</a>)}
			</div>
			<div class="flex items-center justify-between gap-3 border-t border-current/10 pt-3">
				<LanguageSwitcher lang={lang} path={path} />
				<Button href={routeMap.quote} lang={lang}>{t.nav.quote}</Button>
			</div>
		</div>
	</div>
</header>

<script is:inline>
	const header = document.querySelector('[data-site-header]');
	const menuToggle = document.querySelector('[data-mobile-menu-toggle]');
	const mobileMenu = document.querySelector('[data-mobile-menu]');
	const openIcon = menuToggle?.querySelector('.mobile-menu-icon-open');
	const closeIcon = menuToggle?.querySelector('.mobile-menu-icon-close');

	const updateHeader = () => {
		header?.classList.toggle('is-scrolled', window.scrollY > 8);
	};

	const setMenuOpen = (open) => {
		if (!mobileMenu || !menuToggle) return;
		mobileMenu.hidden = !open;
		header?.classList.toggle('is-menu-open', open);
		menuToggle.setAttribute('aria-expanded', String(open));
		openIcon?.classList.toggle('hidden', open);
		closeIcon?.classList.toggle('hidden', !open);
	};

	updateHeader();
	addEventListener('scroll', updateHeader, { passive: true });
	menuToggle?.addEventListener('click', () => setMenuOpen(menuToggle.getAttribute('aria-expanded') !== 'true'));
	mobileMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));
	addEventListener('keydown', (event) => {
		if (event.key === 'Escape') setMenuOpen(false);
	});
</script>
