---
import ThemeToggle from '../ui/ThemeToggle.astro';
import LanguageSwitcher from '../i18n/LanguageSwitcher.astro';
import Button from '../ui/Button.astro';
import { copy, localizedPath, routeMap, type Lang } from '../../lib/i18n';

interface Props {
	lang: Lang;
	path: string;
}

const { lang, path } = Astro.props;
const t = copy[lang];

const nav = [
	[t.nav.services, routeMap.services],
	[t.nav.about, routeMap.about],
	[t.nav.cases, routeMap.cases],
	[t.nav.blog, routeMap.blog],
	[t.nav.contact, routeMap.contact],
];

// Strip locale prefix to get canonical route for active-state detection.
const routePath = path.replace(/^\/en\b/, '').replace(/^\/|\/$/g, '');
const normalizeHref = (href: string) => href.replace(/^\/|\/$/g, '');
const isCurrent = (href: string) => normalizeHref(href) === routePath;
const isActive = (href: string) => {
	const normalizedHref = normalizeHref(href);
	return normalizedHref === '' ? routePath === '' : routePath === normalizedHref || routePath.startsWith(`${normalizedHref}/`);
};

const a11y =
	lang === 'fr'
		? { skip: 'Aller au contenu', nav: 'Navigation principale', menuOpen: 'Ouvrir le menu' }
		: { skip: 'Skip to content', nav: 'Main navigation', menuOpen: 'Open menu' };
---

<a
	class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-orange-500 focus:px-4 focus:py-2 focus:text-white"
	href="#main"
>{a11y.skip}</a>

<header class="site-header" data-site-header>
	<div class="nav-inner">

		<!-- Brand -->
		<a href={localizedPath(lang, '/')} class="nav-brand" aria-label="Arsenal Guard">
			<img
				src="/logo.png"
				width="36"
				height="36"
				alt=""
				class="nav-logo"
				loading="eager"
				decoding="async"
			/>
			<span class="nav-wordmark">Arsenal<span class="nav-wordmark-accent">Guard</span></span>
		</a>

		<!-- Desktop links -->
		<nav class="nav-links-desktop" aria-label={a11y.nav}>
			{nav.map(([label, href]) => (
				<a
					class:list={['nav-link', { 'nav-link--active': isActive(href) }]}
					href={localizedPath(lang, href)}
					aria-current={isCurrent(href) ? 'page' : isActive(href) ? 'location' : undefined}
				>
					{label}
				</a>
			))}
		</nav>

		<!-- Right controls -->
		<div class="nav-controls">

			<div class="hidden sm:block"><LanguageSwitcher lang={lang} path={path} /></div>
			<ThemeToggle lang={lang} />

			<Button href={routeMap.quote} lang={lang} class="nav-cta hidden sm:inline-flex !px-4 !text-xs">
				{t.nav.quote}
			</Button>

			<!-- Burger (mobile) -->
			<button
				class="nav-burger"
				type="button"
				aria-label={a11y.menuOpen}
				aria-expanded="false"
				data-mobile-menu-toggle
			>
				<span class="nav-burger-bar"></span>
				<span class="nav-burger-bar"></span>
				<span class="nav-burger-bar"></span>
			</button>
		</div>
	</div>

	<!-- Mobile menu -->
	<div class="nav-mobile" data-mobile-menu hidden>
		<nav class="nav-mobile-links" aria-label={a11y.nav}>
			{nav.map(([label, href]) => (
				<a
					class:list={['nav-mobile-link', { 'nav-mobile-link--active': isActive(href) }]}
					href={localizedPath(lang, href)}
					aria-current={isCurrent(href) ? 'page' : isActive(href) ? 'location' : undefined}
				>
					{label}
					<span class="nav-mobile-arrow" aria-hidden="true">→</span>
				</a>
			))}
		</nav>
		<div class="nav-mobile-footer">
			<div class="nav-mobile-lang">
				<a
					href={localizedPath('fr', path)}
					class:list={['nav-lang-btn', { 'nav-lang-btn--active': lang === 'fr' }]}
					lang="fr"
					hreflang="fr"
				>FR</a>
				<span class="nav-lang-sep" aria-hidden="true">·</span>
				<a
					href={localizedPath('en', path)}
					class:list={['nav-lang-btn', { 'nav-lang-btn--active': lang === 'en' }]}
					lang="en"
					hreflang="en"
				>EN</a>
			</div>
			<Button href={routeMap.quote} lang={lang}>{t.nav.quote}</Button>
		</div>
	</div>
</header>
<div class="nav-backdrop" aria-hidden="true" data-mobile-backdrop></div>

<script is:inline>
	const header = document.querySelector('[data-site-header]');
	const menuToggle = document.querySelector('[data-mobile-menu-toggle]');
	const mobileMenu = document.querySelector('[data-mobile-menu]');
	const backdrop = document.querySelector('[data-mobile-backdrop]');

	const updateHeader = () => {
		header?.classList.toggle('is-scrolled', window.scrollY > 8);
	};

	const setMenuOpen = (open) => {
		if (!mobileMenu || !menuToggle) return;
		mobileMenu.hidden = !open;
		header?.classList.toggle('is-menu-open', open);
		menuToggle.setAttribute('aria-expanded', String(open));
		document.body.style.overflow = open ? 'hidden' : '';
	};

	updateHeader();
	addEventListener('scroll', updateHeader, { passive: true });
	menuToggle?.addEventListener('click', () =>
		setMenuOpen(menuToggle.getAttribute('aria-expanded') !== 'true')
	);
	backdrop?.addEventListener('click', () => setMenuOpen(false));
	mobileMenu?.querySelectorAll('a').forEach((link) =>
		link.addEventListener('click', () => setMenuOpen(false))
	);
	addEventListener('keydown', (e) => {
		if (e.key === 'Escape') setMenuOpen(false);
	});
</script>
