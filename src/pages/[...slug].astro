---
import { getCollection } from 'astro:content';
import PageRenderer from '../components/sections/PageRenderer.astro';
import Layout from '../components/layout/Layout.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
import { languages, localizedPath, routeMap, type Lang } from '../lib/i18n';
import { services, site } from '../lib/site';

type PageKind = 'home' | 'services' | 'service' | 'about' | 'cases' | 'blog' | 'quote' | 'contact' | 'legal' | 'privacy' | 'article';

export async function getStaticPaths() {
	const allPosts = await getCollection('blog');
	const staticRoutes: [string, PageKind][] = [
		[routeMap.services, 'services'],
		[routeMap.about, 'about'],
		[routeMap.cases, 'cases'],
		[routeMap.blog, 'blog'],
		[routeMap.quote, 'quote'],
		[routeMap.contact, 'contact'],
		[routeMap.legal, 'legal'],
		[routeMap.privacy, 'privacy'],
	];
	const paths: { params: { slug: string }; props: { lang: Lang; path: string; page: PageKind; serviceId?: string; blogSlug?: string } }[] = [];
	for (const lang of languages) {
		if (lang !== 'fr') paths.push({ params: { slug: lang }, props: { lang, path: '/', page: 'home' } });
		for (const [path, page] of staticRoutes) {
			const slug = localizedPath(lang, path).replace(/^\//, '');
			paths.push({ params: { slug }, props: { lang, path, page } });
		}
		for (const service of services) {
			const path = `services/${service.id}`;
			const slug = localizedPath(lang, path).replace(/^\//, '');
			paths.push({ params: { slug }, props: { lang, path, page: 'service', serviceId: service.id } });
		}
		for (const post of allPosts.filter((item) => item.data.lang === lang)) {
			const cleanSlug = post.slug.replace(/^\d+-/, '');
			const path = `blog/${cleanSlug}`;
			const slug = localizedPath(lang, path).replace(/^\//, '');
			paths.push({ params: { slug }, props: { lang, path, page: 'article', blogSlug: post.slug } });
		}
	}
	return paths;
}

const allPosts = await getCollection('blog');
const { lang, path, page, serviceId, blogSlug } = Astro.props;
const posts = allPosts.filter((item) => item.data.lang === lang);
const post = blogSlug ? allPosts.find((item) => item.slug === blogSlug) : undefined;
const renderedPost = post ? await post.render() : undefined;
const Content = renderedPost?.Content;
const renderPage = page === 'article' ? 'notFound' : page;
const articleCopy = lang === 'fr'
	? {
		visual: 'Insight QA · risques, stabilité, CI/CD',
		ctaTitle: 'Besoin de fiabiliser vos tests ?',
		ctaLead: 'Demandez un audit court et repartez avec une priorisation claire.',
		cta: 'Demander un devis',
	}
	: {
		visual: 'QA insight · risk, stability, CI/CD',
		ctaTitle: 'Need to make your tests reliable?',
		ctaLead: 'Request a short audit and leave with clear priorities.',
		cta: 'Request a quote',
	};
---

{
	page === 'article' && post ? (
		<Layout
			lang={lang}
			path={path}
			type="article"
			title={post.data.title}
			description={post.data.description}
			schema={{
				'@context': 'https://schema.org',
				'@type': 'Article',
				headline: post.data.title,
				description: post.data.description,
				author: { '@type': 'Organization', name: site.name },
				datePublished: post.data.date.toISOString(),
			}}
		>
			<section class="article-hero py-20 md:py-28">
				<Container class="max-w-4xl">
					<p class="article-hero-meta font-mono text-sm">{post.data.author} · {post.data.readTime}</p>
					<h1 class="article-hero-title mt-5 text-4xl font-extrabold md:text-6xl">{post.data.title}</h1>
					<p class="article-hero-copy mt-6 text-lg">{post.data.description}</p>
				</Container>
			</section>
			<section class="py-16">
				<Container class="max-w-4xl">
					<div class="mb-10 rounded-2xl border border-white/10 bg-gradient-to-br from-navy-800 to-orange-500/60 p-12 text-white">
						<p class="font-bold">{articleCopy.visual}</p>
					</div>
					<article class="prose-ag">
						{Content && <Content />}
					</article>
					<div class="mt-14 rounded-2xl border border-orange-400/30 bg-orange-400/10 p-8">
						<h2 class="text-2xl font-extrabold">{articleCopy.ctaTitle}</h2>
						<p class="mt-3 text-muted">{articleCopy.ctaLead}</p>
						<Button class="mt-6" href={routeMap.quote} lang={lang}>{articleCopy.cta}</Button>
					</div>
				</Container>
			</section>
		</Layout>
	) : (
  <PageRenderer lang={lang} path={path} page={renderPage} serviceId={serviceId} posts={posts} />
	)
}
